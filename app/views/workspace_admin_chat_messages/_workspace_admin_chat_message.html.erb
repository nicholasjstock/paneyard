<article class="chat-message <%= workspace_admin_chat_message.role %> <%= workspace_admin_chat_message.status %>" id="<%= dom_id(workspace_admin_chat_message) %>">
  <div class="chat-message-meta">
    <strong><%= workspace_admin_chat_message.role == "user" ? "You" : workspace_admin_chat_message.provider&.capitalize %></strong>
    <span><%= workspace_admin_chat_message.created_at.to_fs(:short) %></span>
    <% unless workspace_admin_chat_message.status == "completed" %><span>&middot; <%= workspace_admin_chat_message.status %></span><% end %>
  </div>

  <% admin_chat_visible_events(workspace_admin_chat_message.events).each do |event| %>
    <p class="mono chat-message-event"><%= admin_chat_event_summary(event) %></p>
  <% end %>

  <% if workspace_admin_chat_message.content.present? %>
    <div class="chat-message-content"><%= simple_format(workspace_admin_chat_message.content) %></div>
  <% end %>
</article>
