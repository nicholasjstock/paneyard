<div class="admin-chat-launcher-root" data-controller="admin-chat-drawer"
     data-action="keydown.esc@window->admin-chat-drawer#close turbo:before-morph-element@document->admin-chat-drawer#beforeMorph input->admin-chat-drawer#saveDraft turbo:submit-start->admin-chat-drawer#clearDraft turbo:render@document->admin-chat-drawer#scrollToBottomIfOpen">
  <button type="button" class="chat-launcher" aria-label="Open admin chat" title="Open admin chat" data-action="admin-chat-drawer#open">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 11.5a7.5 7.5 0 0 1-8 7.48 8.7 8.7 0 0 1-3.34-.9L4 20l1.4-4.18A7.5 7.5 0 1 1 20 11.5Z" />
      <path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" />
    </svg>
  </button>
  <%= render "workspace_admin_chats/drawer", chat: current_workspace_admin_chat %>
</div>
