<div class="terminal-launcher-root" data-controller="drawer"
     data-action="turbo:before-morph-element@document->drawer#beforeMorph">
  <button type="button" class="chat-launcher" aria-label="Open workspace terminal" title="Open workspace terminal" data-action="drawer#open">
    <span class="terminal-launcher-icon" aria-hidden="true">&gt;_</span>
  </button>
  <%= render "terminal_sessions/drawer", session: current_terminal_session %>
</div>
