<% content_for :title, "#{current_workspace.name} Questions" %>

<%= turbo_stream_from "workspace_#{current_workspace.id}_questions" %>

<h1><%= current_workspace.name %> Questions</h1>

<%= render "shared/orchestrator_error", orchestrator_error: @orchestrator_error %>

<div id="questions">
  <% if @questions.empty? %>
    <p class="empty">No questions recorded.</p>
  <% else %>
    <% @questions.each do |question| %>
      <div class="card">
        <div class="card-title">
          <span class="mono"><%= question["runId"] %></span>
          <span>
            <span class="badge <%= question["priority"] %>"><%= question["priority"] %></span>
            <span class="badge <%= question["status"] %>"><%= question["status"] %></span>
          </span>
        </div>
        <p><%= question["text"] %></p>
        <% if question["context"].present? %><p class="muted"><%= question["context"] %></p><% end %>
        <p class="muted">asked by <%= question["askedBy"] %> &middot; <span class="mono"><%= question["scope"] %></span></p>

        <% if question["githubCommentUrl"].present? %>
          <p><%= link_to "Open GitHub question", question["githubCommentUrl"], target: "_blank", rel: "noopener" %></p>
        <% elsif question["runId"].present? %>
          <% run = current_workspace.runs.find_by(run_id: question["runId"]) %>
          <% if run&.pull_request_url.present? %><p><%= link_to "Open pull request", run.pull_request_url, target: "_blank", rel: "noopener" %></p><% end %>
        <% end %>
        <% if question["status"] == "open" %>
          <p class="muted">Answer in the pull request with <span class="mono">Question <%= question["questionId"] %>: &lt;your answer&gt;</span>.</p>
          <% if question["githubPublicationError"].present? %><p class="error-banner">GitHub publication: <%= question["githubPublicationError"] %></p><% end %>
        <% else %>
          <p class="muted">answered by <%= question["answeredBy"] %>: <%= question["answerText"] %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
