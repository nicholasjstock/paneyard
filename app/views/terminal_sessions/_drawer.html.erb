<div class="chat-backdrop" data-action="click->drawer#close"></div>
<aside class="chat-drawer terminal-drawer" role="dialog" aria-modal="true" aria-label="Workspace terminal" data-drawer-target="panel">
  <div class="chat-drawer-shell terminal-drawer-shell">
    <header class="chat-drawer-header">
      <div>
        <span class="eyebrow">Workspace terminal</span>
        <strong><%= session.workspace.name %></strong>
        <span class="status-badge <%= session.status %>"><%= session.status %></span>
      </div>
      <button type="button" class="chat-close" aria-label="Close terminal" data-action="drawer#close">×</button>
    </header>

    <div class="terminal-shell" id="terminal-session-<%= session.id %>" data-turbo-permanent
         data-controller="terminal-session" data-terminal-session-id-value="<%= session.id %>"></div>

    <div class="terminal-drawer-footer">
      <span class="muted"><%= session.launcher_variant.capitalize %> &middot; scoped read-only to <%= session.workspace.root_path %></span>
      <%= button_to "Restart", workspace_terminal_session_path(session.workspace), method: :post,
            class: "btn", data: { turbo_confirm: "Restart the terminal session? Scrollback is kept, but the current process ends." } %>
    </div>
  </div>
</aside>
