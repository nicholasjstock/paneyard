<% content_for :title, @worker_id %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<%= turbo_stream_from "worker_#{@worker_id}" %>

<h1 class="mono"><%= @worker_id %></h1>

<%= render "shared/orchestrator_error", orchestrator_error: @orchestrator_error %>

<% if @log %>
  <p>
    <%= link_to "Back to run", workspace_run_path(current_workspace, @log["runId"]), class: "btn" %>
  </p>

  <div class="card">
    <div class="card-title">
      <span><%= @log["nickname"] %></span>
      <span class="badge <%= @log["status"] %>"><%= @log["status"] %></span>
    </div>
    <p class="muted">
      <%= @log["role"] %> &middot; run <span class="mono"><%= @log["runId"] %></span>
      <% if @log["model"].present? %> &middot; model <%= @log["model"] %><% end %>
      <% if @log["stopReason"].present? %> &middot; <%= @log["stopReason"] %><% end %>
    </p>
    <% if @log["status"] == "running" %>
      <%= button_to "Stop worker", stop_workspace_worker_path(current_workspace, @worker_id), method: :post,
            class: "btn danger",
            data: { turbo_confirm: "Stop worker #{@log['nickname']}?" } %>
    <% end %>
  </div>

  <% if @log["agentTurnCount"].present? %>
    <div class="card">
      <h2>Usage</h2>
      <p class="muted">
        <%= @log["model"] || "unknown model" %> &middot;
        <%= pluralize(@log["agentTurnCount"], "turn") %> &middot;
        <%= number_to_currency(@log["totalCostUsd"] || 0) %>
      </p>
      <div class="stat-strip">
        <div class="stat-card">
          <span class="stat-label">Input Tokens</span>
          <strong><%= number_with_delimiter(@log["inputTokens"] || 0) %></strong>
          <span class="muted"><%= number_with_delimiter(@log["cacheReadInputTokens"] || 0) %> cache reads</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Output Tokens</span>
          <strong><%= number_with_delimiter(@log["outputTokens"] || 0) %></strong>
          <span class="muted"><%= number_with_delimiter(@log["cacheCreationInputTokens"] || 0) %> cache creation</span>
        </div>
      </div>
    </div>
  <% end %>

  <% if @log["lastMessage"].present? %>
    <h2>Latest message</h2>
    <pre class="log"><%= @log["lastMessage"] %></pre>
  <% end %>

  <section data-controller="live-log">
    <h2>Live Log</h2>
    <p class="muted">Following newest output. Scroll up to pause tail-follow.</p>
    <pre class="log live-log" data-live-log-target="output"><%= @log["logContent"] || (@log["tail"] || []).join("\n") %></pre>
  </section>
<% end %>
