<% content_for :title, "#{current_workspace.name} Workers" %>

<%= turbo_stream_from "workspace_#{current_workspace.id}_workers" %>

<h1><%= current_workspace.name %> Workers</h1>

<%= render "shared/orchestrator_error", orchestrator_error: @orchestrator_error %>

<div id="workers">
  <% if @workers.empty? %>
    <p class="empty">No workers recorded.</p>
  <% else %>
    <% @workers.each do |worker| %>
      <div class="card">
        <div class="card-title">
          <%= link_to worker["nickname"], workspace_worker_path(current_workspace, worker["workerId"]) %>
          <span class="badge <%= worker["status"] %>"><%= worker["status"] %></span>
        </div>
        <p class="muted">
          <%= worker["role"] %> &middot; run <span class="mono"><%= worker["runId"] %></span>
          &middot; <span class="mono"><%= worker["scope"] %></span>
        </p>
        <p><%= worker["reason"] %></p>
        <% if worker["status"] == "running" %>
          <%= button_to "Stop worker", stop_workspace_worker_path(current_workspace, worker["workerId"]), method: :post,
                class: "btn danger",
                data: { turbo_confirm: "Stop worker #{worker['nickname']}?" } %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
