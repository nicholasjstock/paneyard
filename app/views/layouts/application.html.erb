<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Workflow Orchestrator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Workflow Orchestrator">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "xterm", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="<%= root_path %>">Workflow Orchestrator</a>
      <nav>
        <%= link_to "Workspaces", workspaces_path, class: current_page?(workspaces_path) ? "active" : nil %>
        <% if current_workspace %>
          <%= link_to "Runs", workspace_runs_path(current_workspace), class: current_page?(workspace_runs_path(current_workspace)) ? "active" : nil %>
          <%= link_to "Workers", workspace_workers_path(current_workspace), class: current_page?(workspace_workers_path(current_workspace)) ? "active" : nil %>
          <%= link_to "Questions", workspace_questions_path(current_workspace), class: current_page?(workspace_questions_path(current_workspace)) ? "active" : nil %>
          <%= link_to "Events", workspace_events_path(current_workspace), class: current_page?(workspace_events_path(current_workspace)) ? "active" : nil %>
          <details class="notification-dropdown" <%= "open" if current_page?(workspace_notifications_path(current_workspace)) %>>
            <summary aria-label="Notifications">
              Notifications
              <% if unread_notification_count.positive? %>
                <span class="notification-badge" aria-label="<%= unread_notification_count %> unread notifications"><%= unread_notification_count %></span>
              <% end %>
            </summary>
            <div class="notification-menu">
              <% if current_notifications.any? %>
                <% current_notifications.each do |notification| %>
                  <div class="notification-item <%= "unread" if notification.unread? %>">
                    <%= link_to notification.title, notification.target_url || workspace_notifications_path(current_workspace) %>
                    <p><%= notification.body %></p>
                    <% if notification.unread? %>
                      <%= button_to "Mark read", mark_read_workspace_notification_path(current_workspace, notification), method: :patch, class: "btn btn-small" %>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <p class="muted">No notifications.</p>
              <% end %>
              <%= link_to "View all notifications", workspace_notifications_path(current_workspace), class: "notification-all" %>
            </div>
          </details>
        <% end %>
        <% if current_runs.any? %>
          <label class="current-runs-picker">
            <span class="sr-only">Current runs</span>
            <select id="current-runs-dropdown" aria-label="Current runs"
                    onchange="if (this.value) window.location.href = this.value">
              <option value="" <%= "selected" unless current_runs.any? { |run| current_page?(workspace_run_path(run.workspace, run)) } %>>Current runs</option>
              <% current_runs.each do |run| %>
                <option value="<%= workspace_run_path(run.workspace, run) %>"
                        <%= "selected" if current_page?(workspace_run_path(run.workspace, run)) %>>
                  <%= "#{run.workspace.name} · #{run.worktree_name.presence || run.run_id}" %>
                </option>
              <% end %>
            </select>
          </label>
        <% end %>
      </nav>
    </header>

    <% if current_workspace %>
      <%= render "shared/admin_chat_launcher" %>
    <% end %>

    <main class="page">
      <% if notice %>
        <p class="flash notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="flash alert"><%= alert %></p>
      <% end %>
      <% if background_job_warning.present? %>
        <p class="flash warning"><%= background_job_warning %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
