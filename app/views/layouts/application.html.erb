<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Workflow Orchestrator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Workflow Orchestrator">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "xterm", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="notification-drawer"
        data-action="keydown.esc@window->notification-drawer#close turbo:before-morph-element@document->notification-drawer#beforeMorph">
    <header class="topbar">
      <a class="brand" href="<%= root_path %>">Workflow Orchestrator</a>
      <nav>
        <%= link_to "Workspaces", workspaces_path, class: current_page?(workspaces_path) ? "active" : nil %>
        <% if current_workspace %>
          <%= link_to "Runs", workspace_runs_path(current_workspace), class: current_page?(workspace_runs_path(current_workspace)) ? "active" : nil %>
          <%= link_to "Workers", workspace_workers_path(current_workspace), class: current_page?(workspace_workers_path(current_workspace)) ? "active" : nil %>
          <%= link_to "Questions", workspace_questions_path(current_workspace), class: current_page?(workspace_questions_path(current_workspace)) ? "active" : nil %>
          <%= link_to "Events", workspace_events_path(current_workspace), class: current_page?(workspace_events_path(current_workspace)) ? "active" : nil %>
        <% end %>
        <button type="button" class="notification-launcher" aria-label="Open notifications" aria-expanded="false" title="Open notifications" data-action="notification-drawer#open" data-notification-drawer-target="launcher">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" />
            </svg>
            <span class="sr-only">Notifications</span>
              <% if unread_notification_count.positive? %>
                <span class="notification-badge" aria-label="<%= unread_notification_count %> unread notifications"><%= unread_notification_count %></span>
              <% end %>
        </button>
        <% if current_runs.any? %>
          <label class="current-runs-picker">
            <span class="sr-only">Current runs</span>
            <select id="current-runs-dropdown" aria-label="Current runs"
                    onchange="if (this.value) window.location.href = this.value">
              <option value="" <%= "selected" unless current_runs.any? { |run| current_page?(workspace_run_path(run.workspace, run)) } %>>Current runs</option>
              <% current_runs.each do |run| %>
                <option value="<%= workspace_run_path(run.workspace, run) %>"
                        <%= "selected" if current_page?(workspace_run_path(run.workspace, run)) %>>
                  <%= "#{run.workspace.name} · #{run.worktree_name.presence || run.run_id}" %>
                </option>
              <% end %>
            </select>
          </label>
        <% end %>
      </nav>
    </header>

    <div class="notification-launcher-root">
        <div class="notification-backdrop" data-action="click->notification-drawer#close"></div>
          <aside class="notification-drawer" role="dialog" aria-modal="true" aria-label="Global notifications"
               aria-hidden="true" tabindex="-1" data-notification-drawer-target="panel">
          <div class="notification-drawer-shell">
            <header class="notification-drawer-header">
              <div>
                <span class="eyebrow">Operator inbox</span>
                <h2>Notifications</h2>
                <p class="muted">Across every workspace</p>
              </div>
              <button type="button" class="chat-close" aria-label="Close notifications" data-action="notification-drawer#close">
                <span class="sr-only">Close notifications</span>
                <span aria-hidden="true">×</span>
              </button>
            </header>
            <section class="notification-drawer-list" aria-live="polite">
              <% if current_notifications.any? %>
                <% current_notifications.each do |notification| %>
                  <article class="notification-drawer-item <%= "unread" if notification.unread? %>">
                    <div class="notification-drawer-meta">
                      <span class="notification-drawer-workspace"><%= notification.workspace.name %></span>
                      <time datetime="<%= notification.created_at.iso8601 %>"><%= time_ago_in_words(notification.created_at) %> ago</time>
                    </div>
                    <%= link_to notification.title, notification.target_url || workspace_questions_path(notification.workspace), class: "notification-drawer-title" %>
                    <p><%= notification.body %></p>
                    <span class="muted notification-drawer-run"><%= notification.user_question.run&.worktree_name.presence || notification.user_question.run&.run_id || "Workspace activity" %></span>
                    <% if notification.unread? %>
                      <%= button_to "Mark read", current_workspace ? mark_read_workspace_notification_path(current_workspace, notification) : mark_read_notification_path(notification), method: :patch, class: "btn btn-small notification-mark-read" %>
                    <% end %>
                  </article>
                <% end %>
              <% else %>
                <p class="notification-empty">You’re all caught up.</p>
              <% end %>
            </section>
            <footer class="notification-drawer-footer">
              <%= link_to "View all notifications", current_workspace ? workspace_notifications_path(current_workspace) : notifications_path, class: "notification-all" %>
            </footer>
          </div>
        </aside>
    </div>

    <% if current_workspace %>
      <%= render "shared/admin_chat_launcher" %>
    <% end %>

    <main class="page">
      <% if notice %>
        <p class="flash notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="flash alert"><%= alert %></p>
      <% end %>
      <% if background_job_warning.present? %>
        <p class="flash warning"><%= background_job_warning %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
