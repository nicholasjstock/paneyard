<% content_for :title, "Queue a task in #{current_workspace.name}" %>

<h1>Queue a task in <%= current_workspace.name %></h1>

<p class="muted">
  The run starts when a slot frees up (<%= Orchestrator::RunConcurrency.limit %> at a time), in its own git
  worktree, as a live session you can watch and type into.
</p>

<%= form_with model: @run, url: workspace_runs_path(current_workspace), local: true,
      data: {
        controller: "run-model",
        run_model_catalog_value: model_catalog.to_json,
        run_model_defaults_value: Run::LAUNCHER_VARIANTS.index_with { |v| Orchestrator::DefaultModels.for(v) }.to_json
      } do |form| %>
  <% if @run.errors.any? %>
    <div class="flash alert">
      <% @run.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :task, "Task" %>
    <%= form.text_area :task, placeholder: "Fix the bug described in issue #42." %>
  </div>

  <div class="field">
    <%= form.label :base_branch, "Base branch" %>
    <p class="muted">The branch the run starts from and merges back into. Any local branch of <span class="mono"><%= current_workspace.repository_path %></span>, whether or not it is checked out.</p>
    <%= form.text_field :base_branch, placeholder: current_workspace.default_base_branch %>
  </div>

  <div class="field">
    <%= form.label :launcher_variant, "Agent" %>
    <%= form.select :launcher_variant, Run::LAUNCHER_VARIANTS.map { |v| [v, v] }, {},
          data: { run_model_target: "agent", action: "change->run-model#agentChanged" } %>
  </div>

  <div class="field">
    <%= form.label :model, "Model" %>
    <% default_model = Orchestrator::DefaultModels.for(@run.launcher_variant) %>
    <%= form.select :model,
          [ [ "Default (#{default_model || "CLI default"})", "" ] ] +
            model_catalog.fetch(@run.launcher_variant, []).map { |option| option.values_at("label", "id") },
          {}, data: { run_model_target: "model" } %>
  </div>

  <div class="field">
    <%= form.label :launch_files, "Attach files (optional)" %>
    <%= form.file_field :launch_files, multiple: true %>
  </div>

  <%= form.submit "Queue", class: "btn primary" %>
  <%= link_to "Cancel", workspace_runs_path(current_workspace), class: "btn" %>
<% end %>
