<% planners = planners.presence || [{ worker: nil, entry_type: :worker }] %>
<% planner_entries = planner_entries.presence || planners %>
<% questions = questions.presence || [] %>
<% run_level_questions = questions.select { |q| q.priority == "blocking" && q.scope.blank? } %>
<ul class="workflow-tree" data-testid="workflow-tree">
  <% if run_level_questions.any? %>
    <% run_level_questions.each do |question| %>
      <%= render "workflow_question_node", question: question, run: run %>
    <% end %>
  <% end %>
  <% planners.each_with_index do |planner, planner_index| %>
    <% planner_worker = planner[:worker] %>
    <li class="workflow-tree-node workflow-planner-node">
      <div class="workflow-tree-label">
        <span class="workflow-tree-kind">Planner</span>
        <strong><%= planner_worker&.nickname || "Workflow planner" %></strong>
        <% if planner_worker %><span class="badge <%= planner[:display_status] %>"><%= planner[:status_label] %></span><% end %>
      </div>
      <% if planner_index.zero? && planner_entries.any? %>
        <div class="workflow-planner-decisions">
          <% planner_entries.each_with_index do |entry, index| %>
            <% if entry[:entry_type].to_sym == :planner_decision %>
              <%= render "planner_decision", decision: entry[:decision], number: planner_decisions.length - planner_decisions.index(entry[:decision]) %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <% if criteria.any? %>
        <%= render "workflow_tree_criteria", criteria: criteria, worker_groups: worker_groups, run: run, current_workspace: current_workspace, questions: questions %>
      <% else %>
        <p class="empty">No acceptance criteria established yet.</p>
      <% end %>
    </li>
  <% end %>
  <% unassigned_workers = worker_groups[Orchestrator::AcceptanceCriteriaWorkers::UNASSIGNED] || [] %>
  <% if unassigned_workers.any? %>
    <li class="workflow-tree-node workflow-unassigned-node">
      <div class="workflow-tree-label"><span class="workflow-tree-kind">Other work</span></div>
      <div class="worker-list"><% unassigned_workers.each do |activity| %><%= render "worker_row", activity: activity, run: run, current_workspace: current_workspace, questions: questions %><% end %></div>
    </li>
  <% end %>
</ul>
