<% content_for :title, "#{current_workspace.name} Runs" %>

<%= turbo_stream_from "workspace_#{current_workspace.id}_runs" %>

<div class="toolbar">
  <h1><%= current_workspace.name %> Runs</h1>
  <%= link_to "Queue a task", new_workspace_run_path(current_workspace), class: "btn primary" %>
</div>

<p class="muted">
  <%= pluralize(@in_flight.size, "run") %> in flight of <%= @concurrency_limit %>
  &middot; <%= pluralize(@queued.size, "run") %> queued
</p>

<%= render "shared/orchestrator_error", orchestrator_error: @orchestrator_error %>

<div id="runs">
  <% if @runs.empty? %>
    <p class="empty">No runs yet.</p>
  <% else %>
    <% @runs.each do |run| %>
      <div class="card">
        <div class="card-title">
          <%= link_to run.worktree_name.presence || run.run_id, workspace_run_path(current_workspace, run), class: "mono" %>
          <span class="badge <%= run.status %>"><%= run.status.humanize %></span>
        </div>
        <p><%= truncate(run.task, length: 140) %></p>
        <% if run.branch_name.present? %>
          <p class="muted mono"><%= run.branch_name %></p>
        <% end %>
        <p class="muted">
          <%= run.launcher_variant %><% if run.model.present? %> (<%= run.model %>)<% end %>
          &middot;
          <% if run.started_at %>started <%= time_ago_in_words(run.started_at) %> ago<% else %>waiting for a slot<% end %>
          <% if run.stopped_at %> &middot; ended <%= time_ago_in_words(run.stopped_at) %> ago<% end %>
        </p>
      </div>
    <% end %>
  <% end %>
</div>
