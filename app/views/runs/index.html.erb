<% content_for :title, "#{current_workspace.name} Runs" %>

<%= turbo_stream_from "workspace_#{current_workspace.id}_runs" %>

<div class="toolbar">
  <h1><%= current_workspace.name %> Runs</h1>
  <%= button_to "Re-run project setup", workspace_project_setup_path(current_workspace), method: :post, class: "btn" %>
  <% if current_workspace.initialized? %>
    <%= link_to "Launch task", new_workspace_run_path(current_workspace), class: "btn primary" %>
  <% end %>
</div>

<% unless current_workspace.initialized? %>
  <p class="muted">
    This workspace is still initializing (discovering its dev environment and operational path metadata) before it can
    launch a task run.
  </p>
<% end %>

<%= render "shared/orchestrator_error", orchestrator_error: @orchestrator_error %>

<div id="runs">
  <% if @runs.empty? %>
    <p class="empty">No runs launched yet.</p>
  <% else %>
    <% @runs.each do |run| %>
        <div class="card">
          <div class="card-title">
            <%= link_to run.worktree_name.presence || run.run_id, workspace_run_path(current_workspace, run), class: "mono" %>
            <span class="badge <%= run.status_badge_class %>"><%= run.status_badge_label %></span>
          </div>
          <p><%= truncate(run.task, length: 140) %></p>
          <% if run.branch_name.present? %><p class="muted mono"><%= run.branch_name %></p><% end %>
          <% if run.pull_request_url.present? %><p><%= link_to "Pull request", run.pull_request_url, target: "_blank", rel: "noopener" %></p><% end %>
          <p class="muted">
            <%= run.launcher_variant %>
            &middot;
            <% if run.started_at %>started <%= time_ago_in_words(run.started_at) %> ago<% else %>not started<% end %>
            <% if run.stopped_at %> &middot; stopped <%= time_ago_in_words(run.stopped_at) %> ago<% end %>
          </p>
          <% if run.launch_queued? %>
            <p class="error-banner">Launch job has not started. This run is still queued; start `bin/jobs` or `bin/dev`.</p>
          <% end %>
        </div>
      <% end %>
  <% end %>
</div>
