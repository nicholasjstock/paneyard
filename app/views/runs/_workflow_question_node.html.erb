<li class="workflow-tree-node workflow-question-node <%= question.priority %>">
  <details 
    class="question-details" 
    data-controller="accordion-state" 
    data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph"
    data-accordion-state-key-value="run:<%= run.run_id %>:question:<%= question.question_id %>"
  >
    <summary class="workflow-tree-label">
      <span class="workflow-tree-kind">Question</span>
      <% if question.scope.present? %><span class="mono"><%= question.scope %></span><% end %>
      <span class="question-badges">
        <span class="badge <%= question.priority %>"><%= question.priority %></span>
        <span class="badge <%= question.status %>"><%= question.status %></span>
      </span>
      <span class="detail-affordance">View details</span>
    </summary>
    <article class="mini-card question-card">
      <p class="question-text"><%= question.text %></p>
      <% if question.context.present? %><p class="muted"><%= question.context %></p><% end %>
      <p class="muted">asked by <%= question.asked_by %> &middot; <%= time_ago_in_words(question.asked_at) %> ago</p>
      <% if question.github_comment_url.present? %>
        <p><%= link_to "Answer on GitHub", question.github_comment_url, target: "_blank", rel: "noopener", class: "btn primary" %></p>
      <% elsif run.pull_request_url.present? %>
        <p><%= link_to "Open pull request to answer", run.pull_request_url, target: "_blank", rel: "noopener", class: "btn primary" %></p>
      <% else %>
        <p class="muted">A draft pull request is being created for this question.</p>
      <% end %>
      <p class="muted">Use <span class="mono">Question <%= question.question_id %>: &lt;your answer&gt;</span> in a PR comment.</p>
    </article>
  </details>
</li>
