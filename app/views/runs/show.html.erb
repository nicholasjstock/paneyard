<% content_for :title, "#{@run.worktree_name.presence || @run.run_id}" %>

<%= turbo_stream_from "run_#{@run.run_id}" %>

<div class="toolbar">
  <div>
    <h1 class="mono"><%= @run.worktree_name.presence || @run.run_id %></h1>
    <span class="badge <%= @run.status %>"><%= @run.status.humanize %></span>
    <% if @session && @session.live? && @session.agent_status.present? %>
      <span class="badge <%= @session.agent_status %>">agent: <%= @session.agent_status %></span>
    <% end %>
  </div>

  <div class="toolbar-actions">
    <% if @session&.live? %>
      <%= button_to "Close session", close_session_workspace_run_path(current_workspace, @run),
            method: :post, class: "btn",
            data: { turbo_confirm: "Close the session? This quits the CLI and closes its herdr pane." } %>
      <%= button_to "Stop run", stop_workspace_run_path(current_workspace, @run), method: :post, class: "btn danger" %>
    <% end %>
  </div>
</div>

<p><%= @run.task %></p>

<% if @run.launch_error.present? %>
  <p class="error-banner">Launch failed: <%= @run.launch_error %></p>
<% end %>

<% if @checkpoints.present? %>
  <section class="panel">
    <h2>Checkpoints</h2>
    <p class="muted">Each report covers the work since the one before it.</p>
    <ol class="checkpoints">
      <% @checkpoints.each do |checkpoint| %>
        <li>
          <span class="badge <%= checkpoint.outcome %>"><%= checkpoint.outcome %></span>
          <span class="muted"><%= checkpoint.created_at.strftime("%b %-d %H:%M") %></span>
          <% if checkpoint.summary.present? %>
            <div class="markdown"><%= render_markdown checkpoint.summary %></div>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>

<section class="panel">
  <h2>Worktree</h2>
  <% if @run.managed_worktree? %>
    <p class="mono"><%= @run.target_root %></p>
    <p class="muted mono"><%= @run.branch_name || "branch not provisioned" %></p>
    <% if @run.terminal? %>
      <%= button_to "Remove worktree", remove_worktree_workspace_run_path(current_workspace, @run),
            method: :post, class: "btn",
            data: { turbo_confirm: "Remove #{@run.worktree_name}? This deletes the checkout." } %>
    <% end %>
  <% else %>
    <p class="muted">No managed worktree.</p>
  <% end %>
</section>

<section class="panel">
  <h2>Session</h2>
  <% if @session.nil? %>
    <p class="muted">
      <% if @run.status == "queued" %>
        Waiting for a free slot. <%= pluralize(Orchestrator::RunConcurrency.in_flight, "run") %> in flight of
        <%= Orchestrator::RunConcurrency.limit %>.
      <% else %>
        No session has been started for this run.
      <% end %>
    </p>
  <% else %>
    <p class="muted">
      <%= @session.driver %> &middot; <%= @session.status %>
      <% if @session.pid.present? %> &middot; pid <%= @session.pid %><% end %>
      <% if @session.started_at %> &middot; started <%= time_ago_in_words(@session.started_at) %> ago<% end %>
    </p>

    <% if @session.live? %>
      <%= form_with url: send_message_workspace_run_path(current_workspace, @run), method: :post, local: true do |form| %>
        <div class="field">
          <%= form.label :message, "Send a message to this session" %>
          <%= form.text_area :message, rows: 3, placeholder: "Use the other migration instead — see db/migrate/2026…" %>
        </div>
        <%= form.submit "Send", class: "btn primary" %>
      <% end %>
    <% end %>
  <% end %>
</section>

<% if @artifacts.any? %>
  <section class="panel">
    <h2>Artifacts</h2>
    <% @artifacts.each do |artifact| %>
      <details>
        <summary class="mono"><%= artifact[:name] %></summary>
        <pre class="log"><%= artifact[:content] %></pre>
      </details>
    <% end %>
  </section>
<% end %>

<% if @timeline.any? %>
  <section class="panel">
    <h2>Timeline</h2>
    <ul class="timeline">
      <% @timeline.each do |event| %>
        <li>
          <span class="muted"><%= event.created_at.strftime("%H:%M:%S") %></span>
          <span class="mono"><%= event.event_type %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
