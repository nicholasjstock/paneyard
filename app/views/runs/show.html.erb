<% content_for :title, @run.run_id %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<%= turbo_stream_from "run_#{@run.run_id}" %>

<div class="toolbar">
  <div class="run-title">
    <span class="eyebrow">Run <span class="mono"><%= @run.run_id %></span></span>
    <h1><%= @run.task %></h1>
    <span class="muted"><%= current_workspace.name %> &middot; <%= @run.launcher_variant %></span>
  </div>
  <div class="toolbar-actions" data-controller="chat-drawer"
       data-action="keydown.esc@window->chat-drawer#close turbo:before-morph-element@document->chat-drawer#beforeMorph input->chat-drawer#saveDraft turbo:submit-start->chat-drawer#clearDraft">
    <button type="button" class="chat-launcher" aria-label="Open project chat" title="Open project chat" data-action="chat-drawer#open">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 11.5a7.5 7.5 0 0 1-8 7.48 8.7 8.7 0 0 1-3.34-.9L4 20l1.4-4.18A7.5 7.5 0 1 1 20 11.5Z" />
        <path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" />
      </svg>
    </button>
    <% if @run.active? %>
      <%= button_to "Kill run", stop_workspace_run_path(current_workspace, @run), method: :post,
            class: "btn danger",
            data: { turbo_confirm: "Stop run #{@run.run_id}? This cascades to every active worker under it." } %>
    <% end %>
    <%= render "workspace_chats/drawer", chat: @workspace_chat, messages: @workspace_chat_messages, run: @run %>
  </div>
</div>

<section class="run-dashboard">
  <div class="run-overview-grid">
    <section class="panel run-now-panel <%= @run_now[:status_class] %>">
      <div class="run-now-heading">
        <span class="eyebrow">Now</span>
        <span class="badge <%= @run_now[:status_class] %>"><%= @run_now[:badge_label] %></span>
      </div>
      <h2><%= @run_now[:state] %></h2>
      <p class="run-headline"><%= @run_now[:detail] %></p>
      <p class="activity-age">Updated <%= time_ago_in_words(@run_now[:latest_activity_at]) %> ago &middot; live</p>

      <div class="run-narrative">
        <div class="narrative-row">
          <span class="narrative-label">Why</span>
          <p><%= @run_now[:why] %></p>
        </div>
        <div class="narrative-row">
          <span class="narrative-label">Next</span>
          <p><%= @run_now[:next] %></p>
        </div>
        <div class="narrative-row <%= "requires-action" if @run_now[:operator_action_required] %>">
          <span class="narrative-label">You</span>
          <p><%= @run_now[:operator_action] %></p>
        </div>
      </div>

      <% if @latest_tick&.dig("lastStallFinding").present? %><p class="error-banner"><%= @latest_tick["lastStallFinding"] %></p><% end %>
    </section>

    <section class="panel activity-panel">
      <div class="panel-header">
        <div>
          <span class="eyebrow">Recent activity</span>
          <h2>How it got here</h2>
        </div>
      </div>
      <% if @activity_feed.any? %>
        <ol class="activity-feed">
          <% @activity_feed.each_with_index do |item, index| %>
            <li class="<%= item[:kind] %> <%= "current" if index.zero? %>">
              <div class="activity-copy">
                <span class="activity-actor"><%= item[:actor] %></span>
                <span><%= item[:label] %></span>
              </div>
              <time class="muted"><%= time_ago_in_words(item[:at]) %> ago</time>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="empty">No activity has been recorded yet.</p>
      <% end %>
      <% if @run_now[:narrative_activity] %>
        <%= link_to "Inspect current worker", workspace_worker_path(current_workspace, @run_now[:narrative_activity][:worker].worker_id), class: "activity-link" %>
      <% end %>
    </section>
  </div>

  <% if @acceptance_criteria.any? %>
    <section class="panel span-2 acceptance-criteria-panel">
      <div class="panel-header">
        <div>
          <h2>Acceptance criteria</h2>
          <p class="muted">The run's outcome contract, established on the first planner decision.</p>
        </div>
      </div>
      <%= render "acceptance_criteria", criteria: @acceptance_criteria %>
    </section>
  <% end %>

  <details class="panel secondary-panel run-usage-panel" data-controller="accordion-state" data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph" data-accordion-state-key-value="run:<%= @run.run_id %>:usage">
    <summary>
      <span>
        <strong>Usage & planner</strong>
        <span class="muted">
          <%= pluralize(@planner_decisions.count, "planner decision") %> &middot;
          <%= number_with_delimiter(@usage_summary[:input_tokens] + @usage_summary[:output_tokens]) %> tokens &middot;
          <%= number_to_currency(@usage_summary[:total_cost_usd]) %>
        </span>
      </span>
      <span class="detail-affordance">View details</span>
    </summary>
    <div class="secondary-panel-body">
    <div class="stat-strip">
      <div class="stat-card">
        <span class="stat-label">Agent Turns</span>
        <strong><%= number_with_delimiter(@usage_summary[:agent_turn_count]) %></strong>
      </div>
      <div class="stat-card">
        <span class="stat-label">Input Tokens</span>
        <strong><%= number_with_delimiter(@usage_summary[:input_tokens]) %></strong>
        <span class="muted"><%= number_with_delimiter(@usage_summary[:cache_read_input_tokens]) %> cache reads</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Output Tokens</span>
        <strong><%= number_with_delimiter(@usage_summary[:output_tokens]) %></strong>
      </div>
      <div class="stat-card">
        <span class="stat-label">Cost</span>
        <strong><%= number_to_currency(@usage_summary[:total_cost_usd]) %></strong>
        <span class="muted"><%= @usage_summary[:models].map { |model, count| "#{model}: #{count}" }.join(", ").presence || "no completed telemetry" %></span>
      </div>
    </div>
    <section class="planner-history">
      <div class="planner-history-heading">
        <div>
          <span class="stat-label">Planner decision history</span>
          <p class="muted">One expandable item for every persisted planner decision, newest first.</p>
        </div>
        <span class="muted"><%= pluralize(@planner_decisions.count, "database row") %></span>
      </div>
      <% if @planner_decisions.any? %>
        <% total = @planner_decisions.count %>
        <% @planner_decisions.each_with_index do |decision, index| %>
          <%= render "planner_decision", decision: decision, number: total - index %>
        <% end %>
      <% else %>
        <p class="empty">No planner decision has been persisted yet.</p>
      <% end %>
    </section>
    </div>
  </details>

  <div class="dashboard-grid">
    <% if @blocking_questions.any? %>
      <section class="panel span-2 blocking-questions">
        <div class="panel-header">
          <div>
            <h2>Operator Input Required</h2>
            <p class="muted">The run will remain paused until these questions are answered.</p>
          </div>
          <span class="badge blocking"><%= pluralize(@blocking_questions.count, "blocking question") %></span>
        </div>
        <% @blocking_questions.each do |question| %>
          <article class="mini-card question-card">
            <div class="card-title">
              <span class="mono"><%= question.scope %></span>
              <span>
                <span class="badge <%= question.priority %>"><%= question.priority %></span>
                <span class="badge <%= question.status %>"><%= question.status %></span>
              </span>
            </div>
            <p class="question-text"><%= question.text %></p>
            <% if question.context.present? %><p class="muted"><%= question.context %></p><% end %>
            <p class="muted">asked by <%= question.asked_by %> &middot; <%= time_ago_in_words(question.asked_at) %> ago</p>
            <%= form_with url: answer_workspace_question_path(current_workspace, question.question_id), method: :post, local: true,
                  data: { controller: "question-form", action: "turbo:before-morph-element@document->question-form#beforeMorph" } do |form| %>
              <div class="field">
                <%= form.label :answer_text, "Your decision" %>
                <%= form.text_area :answer_text, placeholder: "Describe the diagnostic result or choose how this run should proceed...", required: true,
                      data: { question_form_target: "answer" } %>
              </div>
              <%= form.submit "Answer and Resume Monitoring", class: "btn primary" %>
            <% end %>
          </article>
        <% end %>
      </section>
    <% end %>

    <details class="panel secondary-panel span-2" data-controller="accordion-state" data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph" data-accordion-state-key-value="run:<%= @run.run_id %>:artifacts">
      <summary>
        <span><strong>Artifacts</strong> <span class="muted"><%= pluralize(@artifacts.count, "available artifact") %></span></span>
        <span class="detail-affordance">View details</span>
      </summary>
      <div class="secondary-panel-body">
      <% if @artifacts.any? %>
        <% @artifacts.each do |artifact| %>
          <div class="mini-card artifact-card">
            <div class="card-title">
              <span class="mono"><%= artifact[:name] %></span>
              <span class="muted"><%= artifact[:updated_at] %></span>
            </div>
            <p class="muted"><%= number_to_human_size(artifact[:size_bytes]) %></p>
            <% if artifact[:content].present? %>
              <pre class="log artifact-content"><%= artifact[:content] %></pre>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="empty">No run-scoped artifacts found yet.</p>
      <% end %>
      </div>
    </details>
  </div>

  <details class="panel secondary-panel worker-command-center" data-controller="accordion-state" data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph" data-accordion-state-key-value="run:<%= @run.run_id %>:workers">
    <summary>
      <span><strong>Worker history</strong> <span class="muted"><%= pluralize(@worker_activities.count, "worker") %></span></span>
      <span class="detail-affordance">View details</span>
    </summary>
    <div class="secondary-panel-body">

    <% if @worker_activities.any? %>
      <div class="worker-list">
        <% @worker_activities.each do |activity| %>
          <% worker = activity[:worker] %>
          <details id="worker-<%= worker.worker_id %>"
                   class="worker-row <%= activity[:display_status] %>"
                   data-controller="accordion-state"
                   data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph"
                   data-accordion-state-key-value="run:<%= @run.run_id %>:worker:<%= worker.worker_id %>">
            <summary>
              <span class="worker-name"><%= worker.nickname %></span>
              <span class="badge <%= activity[:display_status] %>"><%= activity[:status_label] %></span>
              <span class="worker-scope mono"><%= worker.scope %></span>
              <span class="worker-activity muted">
                <% if activity[:last_activity_at] %>active <%= time_ago_in_words(activity[:last_activity_at]) %> ago<% else %>no activity recorded<% end %>
              </span>
            </summary>
            <div class="worker-detail">
              <div class="worker-metadata muted">
                <span><%= worker.role %></span>
                <% if worker.model.present? %><span><%= worker.model %></span><% end %>
                <span>started <%= worker.started_at ? time_ago_in_words(worker.started_at) + " ago" : "unknown" %></span>
                <% if worker.stopped_at %><span>stopped <%= time_ago_in_words(worker.stopped_at) %> ago</span><% end %>
                <span class="mono">pid <%= worker.pid %></span>
              </div>
              <p><strong>Assigned:</strong> <%= worker.reason %></p>
              <% if activity[:assignment_text].present? %>
                <details class="worker-assignment"
                         data-controller="accordion-state"
                         data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph"
                         data-accordion-state-key-value="run:<%= @run.run_id %>:worker:<%= worker.worker_id %>:assignment">
                  <summary>Full instructions</summary>
                  <pre class="log compact"><%= activity[:assignment_text] %></pre>
                  <% if activity[:assignment_context].present? %>
                    <p class="muted">Context</p>
                    <pre class="log compact"><%= activity[:assignment_context] %></pre>
                  <% end %>
                </details>
              <% end %>
              <% if worker.stop_reason.present? %><p class="worker-stop-reason"><strong>Stop reason:</strong> <%= worker.stop_reason %></p><% end %>
              <% if worker.agent_turn_count.present? %>
                <p class="muted">
                  <strong>Usage:</strong> <%= pluralize(worker.agent_turn_count, "turn") %> &middot;
                  <%= number_with_delimiter(worker.input_tokens || 0) %> input / <%= number_with_delimiter(worker.output_tokens || 0) %> output tokens &middot;
                  <%= number_to_currency(worker.total_cost_usd || 0) %>
                </p>
              <% end %>
              <% if activity[:output_preview].present? %>
                <p class="muted"><%= activity[:output_source] %></p>
                <pre class="log compact"><%= activity[:output_preview] %></pre>
              <% else %>
                <p class="empty">No agent output captured yet.</p>
              <% end %>
              <%= link_to "Open full worker log", workspace_worker_path(current_workspace, worker.worker_id), class: "btn" %>
            </div>
          </details>
        <% end %>
      </div>
    <% else %>
      <p class="empty">No workers recorded for this run yet.</p>
    <% end %>
    </div>
  </details>

  <details class="panel secondary-panel run-command-center" data-controller="accordion-state" data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph" data-accordion-state-key-value="run:<%= @run.run_id %>:commands">
    <summary>
      <span><strong>Run commands</strong> <span class="muted"><%= pluralize(@run_commands.count, "background command") %></span></span>
      <span class="detail-affordance">View details</span>
    </summary>
    <div class="secondary-panel-body">

    <% if @run_commands.any? %>
      <div class="run-command-list">
        <% @run_commands.each do |command| %>
          <details id="run-command-<%= command.command_id %>" class="run-command-row <%= command.status %>">
            <summary>
              <span class="run-command-purpose"><%= command.purpose.presence || command.executable %></span>
              <span class="badge <%= command.status %>"><%= command.status %></span>
              <span class="run-command-executable mono"><%= command.executable %></span>
            </summary>
            <div class="run-command-detail">
              <div class="run-command-metadata muted">
                <span class="mono">pid <%= command.pid || "—" %></span>
                <span>started <%= command.started_at ? time_ago_in_words(command.started_at) + " ago" : "not started" %></span>
                <% if command.finished_at %><span>finished <%= time_ago_in_words(command.finished_at) %> ago</span><% end %>
                <% if command.exit_code %><span>exit code <%= command.exit_code %></span><% end %>
                <% if command.signal %><span>signal <%= command.signal %></span><% end %>
              </div>
              <% if command.failure_message.present? %><p class="run-command-failure"><strong>Note:</strong> <%= command.failure_message %></p><% end %>
              <% tail = command.log_path.present? ? Orchestrator::LogReader.read_tail_lines(command.log_path, 12) : nil %>
              <% if tail.present? %>
                <pre class="log compact"><%= tail %></pre>
              <% else %>
                <p class="empty">No output captured yet.</p>
              <% end %>
              <% if command.active? %>
                <%= button_to "Stop", stop_workspace_run_command_path(current_workspace, command.command_id), method: :post, class: "btn", data: { turbo_confirm: "Stop #{command.executable}?" } %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    <% else %>
      <p class="empty">No background commands started for this run yet.</p>
    <% end %>
    </div>
  </details>

</section>

<%= render "shared/orchestrator_error", orchestrator_error: @orchestrator_error %>
