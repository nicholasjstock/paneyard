<% content_for :title, @run.run_id %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<%= turbo_stream_from "run_#{@run.run_id}" %>

<div class="toolbar">
  <div>
    <h1 class="mono"><%= @run.run_id %></h1>
    <span class="badge <%= @run.status_badge_class %>"><%= @run.status_badge_label %></span>
  </div>
  <% if @run.active? %>
    <%= button_to "Kill run", stop_workspace_run_path(current_workspace, @run), method: :post,
          class: "btn danger",
          data: { turbo_confirm: "Stop run #{@run.run_id}? This cascades to every active worker under it." } %>
  <% end %>
</div>

<div class="card">
  <p><%= @run.task %></p>
  <p class="muted">
    <%= @run.launcher_variant %> &middot;
    workspace: <%= current_workspace.name %> &middot;
    target: <span class="mono"><%= @run.target_root %></span>
  </p>
  <% if @run.phase.present? %>
    <p class="muted">
      phase: <strong><%= @run.phase %></strong>
      <% if @run.phase_owner.present? %>&middot; owner: <%= @run.phase_owner %><% end %>
      <% if @run.phase_updated_at.present? %>&middot; updated <%= time_ago_in_words(@run.phase_updated_at) %> ago<% end %>
    </p>
  <% end %>
  <% if @run.phase_summary.present? %>
    <p><%= @run.phase_summary %></p>
  <% end %>
  <% if @run.launch_queued? %>
    <p class="error-banner">Launch job has not started. This run is still queued; start `bin/jobs` or `bin/dev`.</p>
  <% end %>
</div>

<section class="run-dashboard">
  <div class="stat-strip">
    <div class="stat-card">
      <span class="stat-label">Current Phase</span>
      <strong><%= @run.phase || "unknown" %></strong>
      <span class="muted"><%= @run.phase_owner || "unowned" %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Latest Tick</span>
      <strong><%= @latest_tick ? @latest_tick["tickCount"] : 0 %></strong>
      <span class="muted"><%= @latest_tick ? @latest_tick["phase"] : "starting" %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Active Workers</span>
      <strong><%= @active_workers.count %></strong>
      <span class="muted"><%= @active_workers.map { |activity| activity[:worker].nickname }.presence&.join(", ") || "none" %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Open Requests</span>
      <strong><%= @spawn_requests.count %></strong>
      <span class="muted"><%= @spawn_requests.first&.dig("requestedRole") || "idle" %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Agent Cost</span>
      <strong><%= number_to_currency(@usage_summary[:total_cost_usd]) %></strong>
      <span class="muted"><%= @usage_summary[:reported_worker_count] %>/<%= @usage_summary[:worker_count] %> workers reported</span>
    </div>
  </div>

  <div class="dashboard-grid">
    <% if @active_workers.any? %>
      <section class="panel span-2 live-worker-links">
        <div class="panel-header">
          <div>
            <h2>Live Worker Streams</h2>
            <p class="muted">Open a running worker to follow its output as it arrives.</p>
          </div>
        </div>
        <div class="stream-link-list">
          <% @active_workers.each do |activity| %>
            <% worker = activity[:worker] %>
            <%= link_to workspace_worker_path(current_workspace, worker.worker_id), class: "btn primary stream-link" do %>
              <span><%= worker.nickname %></span>
              <span class="mono"><%= worker.scope %></span>
              <span>Open live stream</span>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @blocking_questions.any? %>
      <section class="panel span-2 blocking-questions">
        <div class="panel-header">
          <div>
            <h2>Operator Input Required</h2>
            <p class="muted">The run will remain paused until these questions are answered.</p>
          </div>
          <span class="badge blocking"><%= pluralize(@blocking_questions.count, "blocking question") %></span>
        </div>
        <% @blocking_questions.each do |question| %>
          <article class="mini-card question-card">
            <div class="card-title">
              <span class="mono"><%= question.scope %></span>
              <span>
                <span class="badge <%= question.priority %>"><%= question.priority %></span>
                <span class="badge <%= question.status %>"><%= question.status %></span>
              </span>
            </div>
            <p class="question-text"><%= question.text %></p>
            <% if question.context.present? %><p class="muted"><%= question.context %></p><% end %>
            <p class="muted">asked by <%= question.asked_by %> &middot; <%= time_ago_in_words(question.asked_at) %> ago</p>
            <%= form_with url: answer_workspace_question_path(current_workspace, question.question_id), method: :post, local: true,
                  data: { controller: "question-form", action: "turbo:before-morph-element@document->question-form#beforeMorph" } do |form| %>
              <div class="field">
                <%= form.label :answer_text, "Your decision" %>
                <%= form.text_area :answer_text, placeholder: "Describe the diagnostic result or choose how this run should proceed...", required: true,
                      data: { question_form_target: "answer" } %>
              </div>
              <%= form.submit "Answer and Resume Monitoring", class: "btn primary" %>
            <% end %>
          </article>
        <% end %>
      </section>
    <% end %>

    <section class="panel span-2">
      <div class="panel-header">
        <h2>Now</h2>
        <% if @run.phase_updated_at.present? %><span class="muted">updated <%= time_ago_in_words(@run.phase_updated_at) %> ago</span><% end %>
      </div>
      <% if @run.phase_summary.present? %>
        <p class="lead"><%= @run.phase_summary %></p>
      <% else %>
        <p class="empty">No current phase summary yet.</p>
      <% end %>
      <% if @latest_tick&.dig("lastStallFinding").present? %>
        <p class="error-banner"><%= @latest_tick["lastStallFinding"] %></p>
      <% end %>
    </section>

    <section class="panel">
      <div class="panel-header">
        <h2>Next</h2>
      </div>
      <% if @spawn_requests.any? %>
        <% @spawn_requests.each do |request| %>
          <div class="mini-card">
            <div class="card-title">
              <span><%= request["requestedRole"] %></span>
              <span class="badge <%= request["priority"] %>"><%= request["priority"] %></span>
            </div>
            <p class="mono"><%= request["scope"] %></p>
            <p><%= request["text"] %></p>
          </div>
        <% end %>
      <% elsif @following_steps.any? %>
        <% @following_steps.each do |step| %>
          <div class="mini-card">
            <div class="card-title">
              <span><%= step["owner"] || step[:owner] %></span>
              <span class="mono"><%= step["artifact"] || step[:artifact] %></span>
            </div>
            <p><%= step["successCheck"] || step[:success_check] %></p>
          </div>
        <% end %>
      <% else %>
        <p class="empty">No queued handoff right now.</p>
      <% end %>
    </section>

    <section class="panel span-2">
      <div class="panel-header">
        <h2>Run Timeline</h2>
      </div>
      <% if @timeline_events.any? %>
        <% @timeline_events.each do |event| %>
          <div class="timeline-row">
            <span><%= event["label"] %></span>
            <span class="muted"><%= time_ago_in_words(Time.iso8601(event["at"])) %> ago</span>
          </div>
        <% end %>
      <% else %>
        <p class="empty">No worker lifecycle activity yet.</p>
      <% end %>
    </section>

    <section class="panel">
      <div class="panel-header">
        <h2>Artifacts</h2>
      </div>
      <% if @artifact_previews.any? %>
        <% @artifact_previews.each do |artifact| %>
          <div class="mini-card">
            <div class="card-title">
              <span class="mono"><%= artifact[:name] %></span>
              <span class="muted"><%= artifact[:updated_at] %></span>
            </div>
            <p class="muted"><%= number_to_human_size(artifact[:size_bytes]) %></p>
            <% if artifact[:preview].present? %>
              <pre class="log compact"><%= artifact[:preview] %></pre>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="empty">No run-scoped artifacts found yet.</p>
      <% end %>
    </section>
  </div>

  <section class="panel worker-command-center">
    <div class="panel-header">
      <div>
        <h2>Worker Command Center</h2>
        <p class="muted">Current workers first. Expand a worker for its latest output and lifecycle details.</p>
      </div>
      <span class="muted"><%= pluralize(@worker_activities.count, "worker") %></span>
    </div>

    <% if @worker_activities.any? %>
      <div class="worker-list">
        <% @worker_activities.each do |activity| %>
          <% worker = activity[:worker] %>
          <details id="worker-<%= worker.worker_id %>"
                   class="worker-row <%= activity[:display_status] %>"
                   data-controller="accordion-state"
                   data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph"
                   data-accordion-state-key-value="run:<%= @run.run_id %>:worker:<%= worker.worker_id %>">
            <summary>
              <span class="worker-name"><%= worker.nickname %></span>
              <span class="badge <%= activity[:display_status] %>"><%= activity[:status_label] %></span>
              <span class="worker-scope mono"><%= worker.scope %></span>
              <span class="worker-activity muted">
                <% if activity[:last_activity_at] %>active <%= time_ago_in_words(activity[:last_activity_at]) %> ago<% else %>no activity recorded<% end %>
              </span>
            </summary>
            <div class="worker-detail">
              <div class="worker-metadata muted">
                <span><%= worker.role %></span>
                <% if worker.model.present? %><span><%= worker.model %></span><% end %>
                <span>started <%= worker.started_at ? time_ago_in_words(worker.started_at) + " ago" : "unknown" %></span>
                <% if worker.stopped_at %><span>stopped <%= time_ago_in_words(worker.stopped_at) %> ago</span><% end %>
                <span class="mono">pid <%= worker.pid %></span>
              </div>
              <p><strong>Assigned:</strong> <%= worker.reason %></p>
              <% if worker.stop_reason.present? %><p class="worker-stop-reason"><strong>Stop reason:</strong> <%= worker.stop_reason %></p><% end %>
              <% if worker.agent_turn_count.present? %>
                <p class="muted">
                  <strong>Usage:</strong> <%= pluralize(worker.agent_turn_count, "turn") %> &middot;
                  <%= number_with_delimiter(worker.input_tokens || 0) %> input / <%= number_with_delimiter(worker.output_tokens || 0) %> output tokens &middot;
                  <%= number_to_currency(worker.total_cost_usd || 0) %>
                </p>
              <% end %>
              <% if activity[:output_preview].present? %>
                <p class="muted"><%= activity[:output_source] %></p>
                <pre class="log compact"><%= activity[:output_preview] %></pre>
              <% else %>
                <p class="empty">No agent output captured yet.</p>
              <% end %>
              <%= link_to "Open full worker log", workspace_worker_path(current_workspace, worker.worker_id), class: "btn" %>
            </div>
          </details>
        <% end %>
      </div>
    <% else %>
      <p class="empty">No workers recorded for this run yet.</p>
    <% end %>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2>Run Usage</h2>
        <p class="muted">Reported only after an agent finishes; cache reads are shown separately because they can dominate context usage.</p>
      </div>
    </div>
    <div class="stat-strip">
      <div class="stat-card">
        <span class="stat-label">Agent Turns</span>
        <strong><%= number_with_delimiter(@usage_summary[:agent_turn_count]) %></strong>
        <span class="muted"><%= @usage_summary[:models].map { |model, count| "#{model}: #{count}" }.join(", ").presence || "no completed telemetry" %></span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Input Tokens</span>
        <strong><%= number_with_delimiter(@usage_summary[:input_tokens]) %></strong>
        <span class="muted"><%= number_with_delimiter(@usage_summary[:cache_read_input_tokens]) %> cache reads</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Output Tokens</span>
        <strong><%= number_with_delimiter(@usage_summary[:output_tokens]) %></strong>
        <span class="muted"><%= @usage_summary[:reported_worker_count] %> workers reported usage</span>
      </div>
    </div>
  </section>
</section>

<%= render "shared/orchestrator_error", orchestrator_error: @orchestrator_error %>

<details class="card collapsible"
         data-controller="accordion-state"
         data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph"
         data-accordion-state-key-value="run:<%= @run.run_id %>:raw-activity-feed">
  <summary>Raw activity feed</summary>
  <% if @run_events.blank? %>
    <p class="empty">No bus events recorded for this run yet.</p>
  <% else %>
    <% @run_events.reverse_each do |event| %>
      <div class="mini-card">
        <div class="card-title">
          <span class="mono"><%= event["type"] %></span>
          <span class="muted">
            <%= event["at"] %>
            <% if event["repeatCount"].to_i > 1 %>&middot; repeated <%= event["repeatCount"] %>x<% end %>
          </span>
        </div>
        <pre class="log compact"><%= JSON.pretty_generate(event["payload"]) %></pre>
      </div>
    <% end %>
  <% end %>
</details>

<details class="card collapsible"
         data-controller="accordion-state"
         data-action="toggle->accordion-state#persist turbo:before-morph-element@document->accordion-state#beforeMorph"
         data-accordion-state-key-value="run:<%= @run.run_id %>:tick-history">
  <summary>Recent tick history (last 8)</summary>
  <% if @tick_history.blank? || @tick_history["entries"].blank? %>
    <p class="empty">No orchestrator ticks recorded yet.</p>
  <% else %>
    <% @tick_history["entries"].reverse_each do |entry| %>
      <div class="mini-card">
        <div class="card-title">
          <span>Tick <%= entry["tickCount"] %></span>
          <span class="badge <%= entry["phase"] %>"><%= entry["phase"] %></span>
        </div>
        <% if entry["lastPlanSummary"].present? %><p><%= entry["lastPlanSummary"] %></p><% end %>
        <% if entry["lastStallFinding"].present? %><p class="error-banner"><%= entry["lastStallFinding"] %></p><% end %>
      </div>
    <% end %>
  <% end %>
</details>
