<% content_for :title, "Chat · #{@chat.workspace.name}" %>
<%= turbo_stream_from "workspace_chat_#{@chat.id}" %>

<div class="chat-page">
  <header class="chat-header">
    <div>
      <p class="eyebrow">Workspace operator</p>
      <h1><%= @chat.workspace.name %></h1>
      <p class="muted mono"><%= @chat.workspace.root_path %></p>
    </div>
    <span class="status-badge <%= @chat.status %>"><%= @chat.status %></span>
  </header>

  <section class="chat-thread" aria-live="polite">
    <% if @messages.empty? %>
      <div class="chat-empty">
        <h2>Ask about this project</h2>
        <p>I can inspect and edit this worktree, explain active runs, answer blocking questions, and control workspace jobs.</p>
      </div>
    <% else %>
      <% @messages.each do |message| %>
        <article class="chat-message <%= message.role %> <%= message.status %>">
          <div class="chat-message-meta">
            <strong><%= message.role == "user" ? "You" : "Operator" %></strong>
            <span><%= message.created_at.to_fs(:short) %></span>
            <% unless message.status == "completed" %><span>· <%= message.status %></span><% end %>
          </div>
          <div class="chat-message-content"><%= simple_format(message.content) %></div>
        </article>
      <% end %>
    <% end %>

    <% if @chat.status == "processing" %>
      <div class="chat-thinking"><span></span><span></span><span></span> Working in <%= @chat.workspace.name %>…</div>
    <% end %>
  </section>

  <% if @chat.last_error.present? %>
    <div class="flash alert"><strong>Chat turn failed:</strong> <%= @chat.last_error %></div>
  <% end %>

  <%= form_with model: WorkspaceChatMessage.new,
        url: workspace_chat_messages_path(@chat.workspace, @chat),
        class: "chat-composer" do |form| %>
    <%= form.text_area :content,
          placeholder: "Ask what is happening, request a worktree change, or control a run…",
          rows: 3,
          required: true,
          disabled: @chat.status == "processing",
          autofocus: true %>
    <div class="chat-composer-footer">
      <select name="launcher_variant" class="chat-model-picker">
        <% WorkspaceChat::LAUNCHER_VARIANTS.each do |variant| %>
          <option value="<%= variant %>" <%= "selected" if @chat.launcher_variant == variant %>><%= variant.capitalize %></option>
        <% end %>
      </select>
      <span class="muted">Scoped to this worktree and workspace state.</span>
      <%= form.submit @chat.status == "processing" ? "Working…" : "Send",
            class: "btn primary", disabled: @chat.status == "processing" %>
    </div>
  <% end %>
</div>
