<% content_for :title, "Edit #{@workspace.name}" %>

<h1>Edit <%= @workspace.name %></h1>

<%= form_with model: @workspace, url: workspace_path(@workspace), method: :patch, local: true do |form| %>
  <%= render "errors", workspace: @workspace %>

  <div class="field">
    <%= form.label :repository_path, "Repository" %>
    <p class="muted">An existing Git checkout. Runs get their own worktrees of it and never change it.</p>
    <%= form.text_field :repository_path, disabled: @workspace.runs.active.exists? %>
  </div>

  <div class="field">
    <%= form.label :default_base_branch, "Default base branch" %>
    <p class="muted">The branch new runs start from and merge back into unless they name another. Runs already queued keep their own.</p>
    <%= form.text_field :default_base_branch %>
  </div>

  <%= render "layout_field", form: %>

  <%= form.submit "Save", class: "btn primary" %>
  <%= link_to "Cancel", workspaces_path, class: "btn" %>
<% end %>
