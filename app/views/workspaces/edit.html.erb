<% content_for :title, "Edit #{@workspace.name}" %>

<h1>Edit <%= @workspace.name %></h1>

<%= form_with model: @workspace, url: workspace_path(@workspace), method: :patch, local: true do |form| %>
  <div class="field">
    <%= form.label :root_path, "Workspace root" %>
    <p class="muted">The clean Git checkout is expected at <span class="mono">main</span> beneath this directory. Task runs receive sibling worktrees.</p>
    <%= form.text_field :root_path, disabled: @workspace.runs.active.exists? %>
  </div>

  <div class="field">
    <%= form.label :protected_path_patterns_text, "Protected path patterns" %>
    <p class="muted">
      One glob pattern per line. A planner step may only touch a matching path with an answered operator
      approval question. Proposed automatically by this workspace's project_init run; edit freely.
    </p>
    <%= form.text_area :protected_path_patterns_text, value: @workspace.protected_path_patterns.join("\n"), rows: 10 %>
  </div>

  <%= form.submit "Save", class: "btn primary" %>
  <%= link_to "Cancel", workspaces_path, class: "btn" %>
<% end %>
