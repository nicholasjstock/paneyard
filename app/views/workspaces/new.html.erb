<% content_for :title, "Add workspace" %>

<h1>Add workspace</h1>

<%= form_with model: @workspace, url: workspaces_path, local: true do |form| %>
  <%= render "errors", workspace: @workspace %>

  <div class="field">
    <%= form.label :repository_path, "Repository" %>
    <p class="muted">An existing Git checkout, with whatever branch it has checked out. Runs never work in it: each gets its own worktree, wherever your herdr config puts them.</p>
    <%= form.text_field :repository_path, placeholder: "~/code/my-project" %>
  </div>

  <div class="field">
    <%= form.label :name, "Name" %>
    <p class="muted">Leave blank to use the repository's directory name.</p>
    <%= form.text_field :name, placeholder: "my-project" %>
  </div>

  <div class="field">
    <%= form.label :default_base_branch, "Default base branch" %>
    <p class="muted">The branch runs start from and merge back into unless one names another. Leave blank to use the repository's own default branch.</p>
    <%= form.text_field :default_base_branch, value: "", placeholder: "main" %>
  </div>

  <%= render "layout_field", form: %>

  <%= form.submit "Add workspace", class: "btn primary" %>
  <%= link_to "Cancel", workspaces_path, class: "btn" %>
<% end %>
