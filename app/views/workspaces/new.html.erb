<% content_for :title, "Add workspace" %>

<h1>Add workspace</h1>

<%= form_with model: @workspace, url: workspaces_path, local: true do |form| %>
  <%= render "errors", workspace: @workspace %>

  <div class="field">
    <%= form.label :name, "Name" %>
    <%= form.text_field :name, placeholder: "my-project" %>
  </div>

  <div class="field">
    <%= form.label :root_path, "Workspace root" %>
    <%= form.text_field :root_path, placeholder: "~/src/my-project" %>
  </div>

  <%= render "layout_field", form: %>

  <%= form.submit "Add workspace", class: "btn primary" %>
  <%= link_to "Cancel", workspaces_path, class: "btn" %>
<% end %>
