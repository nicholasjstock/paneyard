<%= form_with url: workspace_workspace_admin_chat_messages_path(chat.workspace), local: true, class: "chat-composer" do %>
  <%= text_area_tag "workspace_admin_chat_message[content]", nil,
        placeholder: "Message #{chat.active_provider.capitalize}…", rows: 3, required: true,
        disabled: chat.active?,
        data: { admin_chat_drawer_target: "input", action: "keydown->admin-chat-drawer#submitOnEnter" } %>
  <div class="chat-composer-footer">
    <span class="muted mono">
      <%= chat.active_provider.capitalize %> &middot; <%= chat.model_for(chat.active_provider) %>
      <% if (session_id = chat.session_id_for(chat.active_provider)).present? %>
        &middot; <%= session_id %>
      <% end %>
    </span>
    <%= submit_tag chat.active? ? "Working…" : "Send", class: "btn primary", disabled: chat.active? %>
  </div>
<% end %>

<% if chat.active? %>
  <%= button_to "Cancel turn", cancel_workspace_workspace_admin_chat_path(chat.workspace), method: :post, class: "btn danger" %>
<% end %>
