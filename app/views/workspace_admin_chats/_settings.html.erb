<div class="chat-drawer-settings">
  <%= form_with url: workspace_workspace_admin_chat_path(chat.workspace), method: :patch, local: true, class: "chat-drawer-settings-form" do %>
    <select name="active_provider" data-admin-chat-drawer-target="providerSelect"
            data-action="change->admin-chat-drawer#syncModelPicker change->admin-chat-drawer#submitSettings">
      <% WorkspaceAdminChat::PROVIDERS.each do |provider| %>
        <option value="<%= provider %>" <%= "selected" if chat.active_provider == provider %>><%= provider.capitalize %></option>
      <% end %>
    </select>

    <select name="claude_model" data-admin-chat-drawer-target="claudeModelSelect" data-action="change->admin-chat-drawer#submitSettings"
            <%= "hidden" unless chat.active_provider == "claude" %>>
      <% WorkspaceAdminChat::CLAUDE_MODELS.each do |model| %>
        <option value="<%= model %>" <%= "selected" if chat.model_for("claude") == model %>><%= model %></option>
      <% end %>
    </select>

    <select name="codex_model" data-admin-chat-drawer-target="codexModelSelect" data-action="change->admin-chat-drawer#submitSettings"
            <%= "hidden" unless chat.active_provider == "codex" %>>
      <% WorkspaceAdminChat::CODEX_MODELS.each do |model| %>
        <option value="<%= model %>" <%= "selected" if chat.model_for("codex") == model %>><%= model %></option>
      <% end %>
    </select>
  <% end %>

  <%= button_to "Reset", reset_workspace_workspace_admin_chat_path(chat.workspace, provider: chat.active_provider), method: :post,
        class: "btn danger",
        data: { turbo_confirm: "Reset the #{chat.active_provider.capitalize} conversation? Its session id is forgotten; message history stays." } %>
</div>
