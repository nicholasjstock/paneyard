#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
PKG_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
DEFAULT_TARGET_ROOT="/Users/stockn/Source/simple-retail-planner/main"
TARGET_ROOT="${WORKFLOW_TARGET_ROOT:-$DEFAULT_TARGET_ROOT}"
TSX_BIN="${TSX_BIN:-$PKG_ROOT/node_modules/.bin/tsx}"
SUPERVISOR_SCRIPT="$PKG_ROOT/scripts/supervisor-loop.ts"
WORKFLOW_STATE_DIR="${WORKFLOW_STATE_DIR:-$TARGET_ROOT/front/demo-output/agents-sdk}"

usage() {
  cat <<'EOF'
Usage: bin/supervisor_launcher_claude [options]

Run the deterministic workflow supervisor loop with `WORKFLOW_WORKER_DRIVER=claude`
so spawned workers use the Claude driver. Loops continuously on --interval-ms
like bin/supervisor_launcher; pass --once for a single tick.

Examples:
  bin/supervisor_launcher_claude
  bin/supervisor_launcher_claude --once --run-id=demo-2026-07-03
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ ! -x "$TSX_BIN" ]]; then
  echo "Missing tsx binary at $TSX_BIN" >&2
  exit 1
fi

if [[ ! -f "$SUPERVISOR_SCRIPT" ]]; then
  echo "Missing supervisor loop script at $SUPERVISOR_SCRIPT" >&2
  exit 1
fi

printf 'Launching deterministic supervisor loop (claude worker driver).\n'
printf 'Supervisor script: %s\n' "$SUPERVISOR_SCRIPT"
printf 'Workflow state dir: %s\n' "$WORKFLOW_STATE_DIR"
printf 'Use Ctrl-C to stop the loop.\n'

cd "$TARGET_ROOT"
exec env \
  WORKFLOW_TARGET_ROOT="$TARGET_ROOT" \
  WORKFLOW_STATE_DIR="$WORKFLOW_STATE_DIR" \
  WORKFLOW_WORKER_DRIVER="claude" \
  "$TSX_BIN" "$SUPERVISOR_SCRIPT" "$@"
