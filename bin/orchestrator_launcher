#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
PKG_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
DEFAULT_TARGET_ROOT="/Users/stockn/Source/simple-retail-planner/main"
TARGET_ROOT="${WORKFLOW_TARGET_ROOT:-$DEFAULT_TARGET_ROOT}"
CODEX_BIN="${CODEX_BIN:-$(command -v codex)}"

usage() {
  cat <<'EOF'
Usage: bin/orchestrator_launcher [options]

Launch one orchestrator decision tick from an empty workspace.

Options:
  --run-id=<id>
  --task=<text>
  --scenario=<admin|phone|both>
  --frontend-url=<url>
  --stale-after-ms=<n>
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ ! -x "$CODEX_BIN" ]]; then
  echo "Missing codex binary at $CODEX_BIN" >&2
  exit 1
fi

if [[ ! -f "$PKG_ROOT/.codex/agents/orchestrator.toml" ]]; then
  echo "Missing orchestrator prompt at $PKG_ROOT/.codex/agents/orchestrator.toml" >&2
  exit 1
fi

SOURCE_CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

WORKSPACE_DIR="$TMP_DIR/workspace"
mkdir -p "$WORKSPACE_DIR"

CODEX_HOME_DIR="$TMP_DIR/codex-home"
mkdir -p "$CODEX_HOME_DIR"

if [[ -d "$SOURCE_CODEX_HOME" ]]; then
  cp -R "$SOURCE_CODEX_HOME"/. "$CODEX_HOME_DIR"/
fi

PROFILE_FILE="$CODEX_HOME_DIR/orchestrator.config.toml"

cat > "$PROFILE_FILE" <<EOF
approval_policy = "never"
sandbox_mode = "read-only"
allow_login_shell = false

[features]
multi_agent = true

[agents]
max_threads = 6
max_depth = 1

[mcp_servers.workflow]
command = "npx"
args = ["wf-mcp-server"]
cwd = "$TARGET_ROOT/front"
env = { WORKFLOW_TARGET_ROOT = "$TARGET_ROOT", WORKFLOW_STATE_DIR = "${WORKFLOW_STATE_DIR:-}" }
default_tools_approval_mode = "approve"
required = true

[[hooks.PreToolUse]]
matcher = "^(Bash|apply_patch|Edit|Write)$"

[[hooks.PreToolUse.hooks]]
type = "command"
command = "/bin/false"
statusMessage = "Blocking non-MCP tool use"
EOF

PROMPT_FILE="$TMP_DIR/orchestrator-prompt.txt"
LAST_MESSAGE_FILE="$TMP_DIR/orchestrator.last-message.txt"

RUN_ID=""
TASK=""
SCENARIO=""
FRONTEND_URL=""
STALE_AFTER_MS=""

for arg in "$@"; do
  case "$arg" in
    --run-id=*)
      RUN_ID="${arg#*=}"
      ;;
    --task=*)
      TASK="${arg#*=}"
      ;;
    --scenario=*)
      SCENARIO="${arg#*=}"
      ;;
    --frontend-url=*)
      FRONTEND_URL="${arg#*=}"
      ;;
    --stale-after-ms=*)
      STALE_AFTER_MS="${arg#*=}"
      ;;
  esac
done

cat "$PKG_ROOT/.codex/agents/orchestrator.toml" > "$PROMPT_FILE"
cat >> "$PROMPT_FILE" <<'EOF'

Current task:
Launch the orchestrator for the current run. Inspect the shared bus, determine the active run context, and run exactly one orchestration tick that updates the bus with the next bounded handoff shape.

Permissions:
Use only MCP tools for orchestration and state inspection. Do not use shell commands, ad hoc file reads, or repo CLI wrappers to do the orchestrator's work.
EOF

if [[ -n "$RUN_ID" || -n "$TASK" || -n "$SCENARIO" || -n "$FRONTEND_URL" || -n "$STALE_AFTER_MS" ]]; then
  {
    printf '\nRequired turn parameters:\n'
    [[ -n "$RUN_ID" ]] && printf 'runId: %s\n' "$RUN_ID"
    [[ -n "$TASK" ]] && printf 'task: %s\n' "$TASK"
    [[ -n "$SCENARIO" ]] && printf 'scenario: %s\n' "$SCENARIO"
    [[ -n "$FRONTEND_URL" ]] && printf 'frontendUrl: %s\n' "$FRONTEND_URL"
    [[ -n "$STALE_AFTER_MS" ]] && printf 'staleAfterMs: %s\n' "$STALE_AFTER_MS"
    printf 'Call `run_orchestrator_turn` with these exact parameters if they are provided.\n'
  } >> "$PROMPT_FILE"
fi

exec env CODEX_HOME="$CODEX_HOME_DIR" WORKFLOW_TARGET_ROOT="$TARGET_ROOT" "$CODEX_BIN" exec \
  --profile orchestrator \
  --sandbox read-only \
  --dangerously-bypass-hook-trust \
  -C "$WORKSPACE_DIR" \
  --skip-git-repo-check \
  --output-last-message "$LAST_MESSAGE_FILE" \
  - < "$PROMPT_FILE"
