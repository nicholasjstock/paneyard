#!/usr/bin/env bash
# bin/workflow_mcp_state [OPTIONS]
#
# Launch the workflow MCP HTTP server and the standalone workflow state UI.
#
# Options:
#   --host HOST        Bind host for both processes
#   --http-port PORT   Bind port for the MCP HTTP server
#   --ui-port PORT     Bind port for the web UI
#   --help             Show this message

set -euo pipefail

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
PKG_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
TARGET_ROOT="${WORKFLOW_TARGET_ROOT:-$PKG_ROOT}"
HTTP_BIN="${HTTP_BIN:-$PKG_ROOT/bin/workflow_mcp_http}"
UI_BIN="${UI_BIN:-$PKG_ROOT/bin/workflow_mcp_state_ui}"
HOST="${HOST:-127.0.0.1}"
HTTP_PORT="${HTTP_PORT:-8788}"
UI_PORT="${UI_PORT:-8789}"
READY_TIMEOUT_SECONDS="${READY_TIMEOUT_SECONDS:-20}"

usage() {
  grep '^#' "$0" | grep -v '^#!/' | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      shift
      HOST="${1:-}"
      ;;
    --http-port)
      shift
      HTTP_PORT="${1:-}"
      ;;
    --ui-port)
      shift
      UI_PORT="${1:-}"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

WORKFLOW_HTTP_URL="${WORKFLOW_HTTP_URL:-http://${HOST}:${HTTP_PORT}}"
STATE_URL="${STATE_URL:-${WORKFLOW_HTTP_URL}/state}"

if [[ ! -x "$HTTP_BIN" ]]; then
  echo "Missing HTTP launcher at $HTTP_BIN" >&2
  exit 1
fi

if [[ ! -x "$UI_BIN" ]]; then
  echo "Missing UI launcher at $UI_BIN" >&2
  exit 1
fi

http_log="$(mktemp)"
cleanup() {
  if [[ -n "${HTTP_PID:-}" ]] && kill -0 "$HTTP_PID" 2>/dev/null; then
    kill "$HTTP_PID" 2>/dev/null || true
    wait "$HTTP_PID" 2>/dev/null || true
  fi
  rm -f "$http_log"
}
trap cleanup EXIT INT TERM

if command -v lsof >/dev/null 2>&1; then
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    kill "$pid" 2>/dev/null || true
  done < <(lsof -nP -iTCP:"$HTTP_PORT" -sTCP:LISTEN -t 2>/dev/null || true)

  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    kill "$pid" 2>/dev/null || true
  done < <(lsof -nP -iTCP:"$UI_PORT" -sTCP:LISTEN -t 2>/dev/null || true)

  sleep 0.2
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    kill -9 "$pid" 2>/dev/null || true
  done < <(lsof -nP -iTCP:"$HTTP_PORT" -sTCP:LISTEN -t 2>/dev/null || true)

  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    kill -9 "$pid" 2>/dev/null || true
  done < <(lsof -nP -iTCP:"$UI_PORT" -sTCP:LISTEN -t 2>/dev/null || true)
fi

env WORKFLOW_TARGET_ROOT="$TARGET_ROOT" MCP_HOST="$HOST" MCP_PORT="$HTTP_PORT" "$HTTP_BIN" >"$http_log" 2>&1 &
HTTP_PID=$!

sleep 0.1

if [[ -z "${SKIP_MCP_STATE_WAIT:-}" ]]; then
  timeout_at=$((SECONDS + READY_TIMEOUT_SECONDS))
  while [[ "$SECONDS" -lt "$timeout_at" ]]; do
    if curl -fsS "$STATE_URL" >/dev/null 2>&1; then
      break
    fi
    sleep 0.2
  done
fi

exec env \
  WORKFLOW_TARGET_ROOT="$TARGET_ROOT" \
  WORKFLOW_HTTP_URL="$WORKFLOW_HTTP_URL" \
  "$UI_BIN" --host "$HOST" --port "$UI_PORT"
