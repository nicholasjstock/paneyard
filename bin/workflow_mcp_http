#!/usr/bin/env bash
# bin/workflow_mcp_http [OPTIONS]
#
# Launch the workflow MCP HTTP server on its own fixed port.
#
# Options:
#   --host HOST    Bind host
#   --port PORT    Bind port
#   --help         Show this message

set -euo pipefail

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
PKG_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
DEFAULT_TARGET_ROOT="/Users/stockn/Source/simple-retail-planner/main"
TARGET_ROOT="${WORKFLOW_TARGET_ROOT:-$DEFAULT_TARGET_ROOT}"
TSX_BIN="${TSX_BIN:-$PKG_ROOT/node_modules/.bin/tsx}"
HOST="${MCP_HOST:-127.0.0.1}"
PORT="${MCP_PORT:-8788}"

kill_port_listeners() {
  local port="$1"
  local pids pid

  if ! command -v lsof >/dev/null 2>&1; then
    return 0
  fi

  pids="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null || true)"

  for pid in $pids; do
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
  done

  if [[ -n "$pids" ]]; then
    sleep 0.2
    for pid in $pids; do
      if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    done
  fi
}

usage() {
  grep '^#' "$0" | grep -v '^#!/' | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      shift
      HOST="${1:-}"
      ;;
    --port)
      shift
      PORT="${1:-}"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [[ ! -x "$TSX_BIN" ]]; then
  echo "Missing tsx binary at $TSX_BIN" >&2
  exit 1
fi

kill_port_listeners "$PORT"

exec env WORKFLOW_TARGET_ROOT="$TARGET_ROOT" MCP_HOST="$HOST" MCP_PORT="$PORT" "$TSX_BIN" "$PKG_ROOT/scripts/workflow-mcp-http.ts"
