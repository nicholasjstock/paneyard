#!/usr/bin/env ruby
# Runs the Rails server and the Solid Queue jobs process together against
# the production database, the same way bin/dev does for development. This
# is the one long-running instance that holds this machine's real state --
# see bin/dev for the disposable counterpart.

ENV["RAILS_ENV"] = "production"

require "socket"

unless system("bundle", "check", out: File::NULL)
  warn "bin/production: Ruby dependencies are incomplete. Run bin/setup, then retry bin/production."
  exit 1
end

unless system("./bin/rails", "db:prepare", out: File::NULL)
  warn "bin/production: database preparation failed. Run RAILS_ENV=production bin/rails db:prepare, then retry bin/production."
  exit 1
end

port = Integer(ENV.fetch("PORT", "3000"), 10)
begin
  probe = TCPServer.new("127.0.0.1", port)
  probe.close
rescue Errno::EADDRINUSE
  warn "bin/production: port #{port} is already in use. Stop its owning service or choose another PORT before retrying."
  exit 1
end

pids = [
  # This command is the local long-running production-data environment, not
  # a deployed web process. Keep its process model production-like while
  # allowing Rails to reload application code between requests/jobs so a
  # source fix does not require remembering to restart this pane.
  Process.spawn({ "RAILS_ENV" => "production", "WORKFLOW_HOT_RELOAD" => "1" }, "./bin/rails", "server", *ARGV),
  Process.spawn({ "RAILS_ENV" => "production", "WORKFLOW_HOT_RELOAD" => "1" }, "./bin/jobs")
]

stopping = false
stop_children = proc do
  next if stopping

  stopping = true
  pids.each { |pid| Process.kill("TERM", pid) rescue nil }
end

%w[INT TERM].each do |signal|
  trap(signal) { stop_children.call }
end

begin
  exited_pid = Process.wait
  warn "bin/production: child #{exited_pid} exited; stopping the remaining production services" unless stopping
ensure
  stop_children.call
  pids.each { |pid| Process.wait(pid) rescue nil }
end
