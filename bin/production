#!/usr/bin/env ruby
# Runs the Rails server and the Solid Queue jobs process together against
# the production database, the same way bin/dev does for development. This
# is the one long-running instance that holds this machine's real state --
# see bin/dev for the disposable counterpart.

require_relative "../lib/paneyard_plugin"

ENV["RAILS_ENV"] = "production"
# Loopback only: there is no auth (see SECURITY.md). Outside development
# `rails server` otherwise listens on 0.0.0.0 whenever PORT is set, whatever
# config/puma.rb says. `-b` or BINDING widens it deliberately.
ENV["BINDING"] ||= "127.0.0.1"

# Rails requires a secret_key_base in production even though Paneyard has no
# accounts or browser sessions. Keep a private, durable one beside this
# instance's databases. The plugin supplies its own value in the same way;
# an explicit environment setting still wins.
storage_dir = ENV.fetch("PANEYARD_STORAGE_DIR", File.expand_path("../storage", __dir__))
ENV["SECRET_KEY_BASE"] ||= PaneyardPlugin::Secrets.secret_key_base(File.join(storage_dir, "secret_key_base"))

require "socket"

unless system("bundle", "check", out: File::NULL)
  warn "bin/production: Ruby dependencies are incomplete. Run bin/setup, then retry bin/production."
  exit 1
end

unless system("./bin/rails", "db:prepare", out: File::NULL)
  warn "bin/production: database preparation failed. Run RAILS_ENV=production bin/rails db:prepare, then retry bin/production."
  exit 1
end

port = Integer(ENV.fetch("PORT", "3000"), 10)
begin
  probe = TCPServer.new("127.0.0.1", port)
  probe.close
rescue Errno::EADDRINUSE
  warn "bin/production: port #{port} is already in use. Stop its owning service or choose another PORT before retrying."
  exit 1
end

pids = [
  # No code reloading: a change takes effect on a restart (bin/service
  # restart, or the plugin's restart action), which migrates the database
  # first and, under bin/service, runs bin/preflight before touching this.
  Process.spawn({ "RAILS_ENV" => "production" }, "./bin/rails", "server", *ARGV),
  Process.spawn({ "RAILS_ENV" => "production" }, "./bin/jobs")
]

stopping = false
stop_children = proc do
  next if stopping

  stopping = true
  pids.each { |pid| Process.kill("TERM", pid) rescue nil }
end

%w[INT TERM].each do |signal|
  trap(signal) { stop_children.call }
end

begin
  exited_pid = Process.wait
  warn "bin/production: child #{exited_pid} exited; stopping the remaining production services" unless stopping
ensure
  stop_children.call
  pids.each { |pid| Process.wait(pid) rescue nil }
end
