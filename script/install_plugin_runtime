#!/bin/sh
# Herdr's [[build]] entrypoint. It intentionally needs only a POSIX shell,
# curl, tar and a SHA-256 utility: the machine does not need Ruby or a compiler.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
release_repo=${PANEYARD_RUNTIME_REPOSITORY:-nicholasjstock/paneyard}
release_base=${PANEYARD_RUNTIME_BASE_URL:-https://github.com/$release_repo/releases/download}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    echo "paneyard: installation needs sha256sum or shasum." >&2
    exit 1
  fi
}

runtime_key() {
  { cat "$root/.ruby-version"; cat "$root/Gemfile"; cat "$root/Gemfile.lock"; cat "$root/script/build_plugin_runtime"; } | sha256
}

platform=${PANEYARD_RUNTIME_PLATFORM:-}
if [ -z "$platform" ]; then
  case "$(uname -s):$(uname -m)" in
    Darwin:x86_64) platform=x86_64-darwin ;;
    Darwin:arm64) platform=arm64-darwin ;;
    Linux:x86_64) platform=x86_64-linux ;;
    Linux:aarch64|Linux:arm64) platform=aarch64-linux ;;
    *)
      echo "paneyard: no bundled runtime for $(uname -s) $(uname -m)." >&2
      exit 1
      ;;
  esac
fi

key=$(runtime_key)
tag="runtime-$key"
asset="paneyard-runtime-$platform.tar.gz"
url="$release_base/$tag"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/paneyard-runtime.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

echo "paneyard build: downloading Ruby and production gems for $platform"
curl -fsSL --retry 3 --connect-timeout 15 "$url/$asset" -o "$scratch/$asset"
curl -fsSL --retry 3 --connect-timeout 15 "$url/$asset.sha256" -o "$scratch/$asset.sha256"

expected=$(awk 'NR == 1 { print $1 }' "$scratch/$asset.sha256")
actual=$(sha256 < "$scratch/$asset")
if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
  echo "paneyard: runtime checksum mismatch for $asset." >&2
  exit 1
fi

tar -xzf "$scratch/$asset" -C "$root"
ruby="$root/.paneyard/runtime/bin/ruby"
if [ ! -x "$ruby" ]; then
  echo "paneyard: runtime archive did not contain .paneyard/runtime/bin/ruby." >&2
  exit 1
fi
if ! "$ruby" -e 'abort "wrong Ruby" unless RUBY_VERSION == File.read(".ruby-version").sub(/^ruby-/, "").strip' 2>/dev/null; then
  echo "paneyard: downloaded runtime does not match .ruby-version." >&2
  exit 1
fi
if ! PATH="$(dirname "$ruby"):$PATH" BUNDLE_GEMFILE="$root/Gemfile" BUNDLE_PATH="$root/vendor/bundle" \
    "$ruby" -S bundle check >/dev/null; then
  echo "paneyard: downloaded runtime does not satisfy Gemfile.lock." >&2
  exit 1
fi

printf '%s\n' "$key" > "$root/.paneyard/runtime-key"
echo "paneyard build: ready ($("$ruby" -v))"
echo ""
echo "Next: configure Paneyard in your coding agents:"
echo "  herdr plugin action invoke setup --plugin paneyard"
