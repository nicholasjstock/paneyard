{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012p6ombFfKRAukByBTU8HTY","type":"tool_result","content":"1\tmodule Orchestrator\n2\t  # Ports scripts/worker-turn.ts and scripts/planner-turn.ts. Snake_case throughout -- camelizing for the\n3\t  # wire only happens at each MCP tool's McpTools::ToolResponse.structured\n4\t  # call (see Orchestrator::TickState for the DB read/write boundary).\n5\t  module Turn\n6\t    module_function\n7\t\n8\t    PLANNER_FOLLOWUP_SCOPE = \"workflow-plan.md\"\n9\t\n10\t    # task is part of the MCP tool's input schema for API-surface\n11\t    # consistency with the other turn tools, but -- matching\n12\t    # scripts/worker-turn.ts exactly -- is never actually read here.\n13\t    def run_worker_turn(run_id:, role:, nickname:, scope:, result:, evidence_outcome: nil, evidence_citations: [], diagnosis_findings: nil, produced_artifacts: nil, now: Time.current, previous_state: nil)\n14\t      DiagnosisEvidenceGate.validate!(run_id:, nickname:, scope:, evidence_outcome:, evidence_citations:)\n15\t      StructuredDiagnosisFindings.persist!(run_id:, nickname:, scope:, findings: diagnosis_findings) if diagnosis_findings.present?\n16\t      \n17\t      # Validate and record produced artifacts\n18\t      artifact_names = validate_and_record_artifacts!(run_id:, nickname:, produced_artifacts:)\n19\t      \n20\t      following_steps = previous_state&.dig(:following_steps) || []\n21\t      active_worker_ids = Worker.where(run_id: run_id, status: \"running\").pluck(:worker_id).to_set\n22\t\n23\t      if (review = record_step_attempt(run_id:, nickname:, result:, evidence_outcome:, evidence_citations:))\n24\t        next_state = (previous_state || TickState.default_state(run_id)).merge(\n25\t          phase: \"planning\", last_plan_summary: \"Strong chaperone is reviewing repeated worker failures.\",\n26\t          last_updated_at: now.utc.iso8601(3)\n27\t        )\n28\t        return { planner_request: nil, chaperone_review: { review_id: review.review_id }, next_state: next_state }\n29\t      end\n30\t\n31\t      run = Run.find_by!(run_id: run_id)\n32\t      active_branch_open = run.active_branch_key.present? && !AcceptanceCriteria.branch_resolved?(run:, branch_key: run.active_branch_key)\n33\t\n34\t      # A completed node may only promote its next sibling after the current\n35\t      # acceptance branch is resolved. Otherwise the planner must insert the\n36\t      # next child of this branch (for example, measure -> repair -> verify)\n37\t      # ahead of later verifier siblings.\n38\t      if completed_result?(result) && following_steps.any? && !active_branch_open\n39\t        next_step, *remaining_steps = following_steps\n40\t        summary = \"#{nickname} completed #{scope}. Rails promoted the next previously planned step without another planner call.\"\n41\t        promoted = run_planner_turn(\n42\t          run_id:, summary:, next_step:, following_steps: remaining_steps, now:, previous_state:\n43\t        )\n44\t        return promoted.merge(planner_request: nil, promoted_preplanned_step: true)\n45\t      end\n46\t\n47\t      # A follow-up planner request is a repeatable recovery ask, not a\n48\t      # one-time artifact -- an 'open' request is safe to reuse\n49\t      # unconditionally, but a 'fulfilled' one only still represents\n50\t      # \"already being handled\" while the planner it spawned is still\n51\t      # active.\n52\t      existing_request = SpawnRequest\n53\t        .where(run_id: run_id, requested_role: \"planner\", scope: PLANNER_FOLLOWUP_SCOPE)\n54\t        .where.not(status: \"dismissed\")\n55\t        .detect do |request|\n56\t          request.status == \"open\" ||\n57\t            (request.fulfilled_worker_id.present? && active_worker_ids.include?(request.fulfilled_worker_id)) ||\n58\t            PlannerDecision.active.exists?(spawn_request_id: request.request_id)\n59\t        end\n60\t\n61\t      planner_request = existing_request || SpawnRequest.create!(\n62\t        run_id: run_id,\n63\t        asked_by: \"worker\",\n64\t        scope: PLANNER_FOLLOWUP_SCOPE,\n65\t        text: \"Decide the next nextStep (usually the head of followingSteps, but reconsider it against the reported \" \\\n66\t          \"result) and the new followingSteps, then publish them with planner_turn. If blocked on a user decision, \" \\\n67\t          \"call append_user_question.\",\n68\t        context: [\n69\t          \"Worker #{nickname} (role #{role}) reported this result for run #{run_id}, scope #{scope}: #{result}\",\n70\t          (evidence_outcome.present? ? \"Evidence outcome: #{evidence_outcome}; citations: #{Array(evidence_citations).join(', ')}.\" : nil),\n71\t          (artifact_names.any? ? \"Produced artifacts: #{artifact_names.join(', ')}.\" : nil),\n72\t          \"Current followingSteps queue (JSON, decided by the previous planner_turn call): #{following_steps.to_json}\"\n73\t        ].compact.join(\" \"),\n74\t        requested_role: \"planner\",\n75\t        priority: \"blocking\",\n76\t        tags: [ \"planner\", PLANNER_FOLLOWUP_SCOPE, \"worker-turn-followup\", (\"evidence-#{evidence_outcome}\" if evidence_outcome.present?) ].compact\n77\t      )\n78\t\n79\t      # phase/tick_count/last_plan_summary/last_stall_finding/following_steps\n80\t      # are all owned by planner_turn and orchestrator-turn's stall\n81\t      # detection -- worker_turn only requests the follow-up planner and\n82\t      # reports what it saw, so it carries all of this forward untouched.\n83\t      next_state = {\n84\t        run_id: run_id,\n85\t        phase: previous_state&.dig(:phase) || \"starting\",\n86\t        tick_count: previous_state&.dig(:tick_count) || 0,\n87\t        last_stall_finding: previous_state&.dig(:last_stall_finding),\n88\t        last_plan_summary: previous_state&.dig(:last_plan_summary),\n89\t        pending_spawn_keys: previous_state&.dig(:pending_spawn_keys) || [],\n90\t        following_steps: following_steps,\n91\t        last_updated_at: now.utc.iso8601(3)\n92\t      }\n93\t\n94\t      { planner_request: { request_id: planner_request.request_id }, next_state: next_state }\n95\t    end\n96\t\n97\t    def validate_and_record_artifacts!(run_id:, nickname:, produced_artifacts:)\n98\t      return [] unless produced_artifacts.present?\n99\t\n100\t      run = Run.find_by!(run_id: run_id)\n101\t      worker = Worker.where(run_id:, nickname:).order(created_at: :desc).first\n102\t      raise ArgumentError, \"Worker not found for artifact recording: #{nickname}\" unless worker\n103\t\n104\t      artifact_names = produced_artifacts.map { |a| a[:name] || a[\"name\"] }\n105\t      \n106\t      # Validate all declared artifacts exist in the artifact store\n107\t      missing = artifact_names.reject do |name|\n108\t        begin\n109\t          path = ArtifactStore.resolve_path(run.target_root, run_id, name)\n110\t          File.file?(path)\n111\t        rescue ArgumentError\n112\t          false\n113\t        end\n114\t      end\n115\t      \n116\t      raise ArgumentError, \"Declared artifacts do not exist: #{missing.join(', ')}\" if missing.any?\n117\t\n118\t      # Update worker.produced_artifacts\n119\t      worker.update_column(:produced_artifacts, artifact_names)\n120\t      \n121\t      # Record artifact inheritance in RunContext\n122\t      artifact_names.each do |artifact_name|\n123\t        Orchestrator::RunContext.upsert!(\n124\t          run_id: run_id,\n125\t          entry_key: \"artifact_produced_#{artifact_name}_by_#{worker.worker_id}\",\n126\t          kind: \"fact\",\n127\t          status: \"confirmed\",\n128\t          content: \"Worker #{nickname} (#{worker.worker_id}) produced artifact: #{artifact_name}\",\n129\t          evidence_ref: artifact_name,\n130\t          created_by: \"orchestrator\"\n131\t        )\n132\t      end\n133\t\n134\t      artifact_names\n135\t    end\n136\t    private_class_method :validate_and_record_artifacts!\n137\t\n138\t    def completed_result?(result)\n139\t      result.to_s.match?(/\\A\\s*\\[DONE\\]/i)\n140\t    end\n141\t    private_class_method :completed_result?\n142\t\n143\t    # Covers every execution mode, not only diagnosis -- a worker that\n144\t    # correctly reports [BLOCKED]/[FAILED] via worker_turn must be exactly\n145\t    # as visible to ChaperoneTrigger as one whose process dies outright\n146\t    # (see WorkerReconcileJob#record_failed_attempt, which was already\n147\t    # mode-agnostic). Diagnosis alone keeps its stricter done/evidence\n148\t    # coupling -- see step_attempt_outcome.\n149\t    def record_step_attempt(run_id:, nickname:, result:, evidence_outcome:, evidence_citations:)\n150\t      worker = Worker.where(run_id:, nickname:).order(created_at: :desc).first\n151\t      request = worker && SpawnRequest.find_by(fulfilled_worker_id: worker.worker_id)\n152\t      return unless request\n153\t\n154\t      mode = SpawnRequestedWorkers.execution_mode(request).presence || \"unknown\"\n155\t      outcome = step_attempt_outcome(result:, evidence_outcome:, mode:)\n156\t      lineage_key = request.lineage_key.presence || request.scope\n157\t      attempt = StepAttempt.create!(\n158\t        run_id:, spawn_request: request, worker_id: worker.worker_id, lineage_key:, mode:,\n159\t        outcome:, result:, evidence_outcome:, evidence_citations:\n160\t      )\n161\t      return unless outcome.in?(%w[blocked failed])\n162\t\n163\t      ChaperoneTrigger.call(attempt)\n164\t    end\n165\t    private_class_method :record_step_attempt\n166\t\n167\t    # Diagnosis requires evidenceOutcome=confirmed before a [DONE] report\n168\t    # counts as actually done -- DiagnosisEvidenceGate already enforces the\n169\t    # citation discipline behind that claim. Other modes have no such\n170\t    # evidence contract, so a bare [DONE] is trusted at face value there.\n171\t    def step_attempt_outcome(result:, evidence_outcome:, mode:)\n172\t      done = result.to_s.match?(/\\A\\s*\\[DONE\\]/i)\n173\t      return \"done\" if done && (mode != \"diagnosis\" || evidence_outcome == \"confirmed\")\n174\t      return \"failed\" if result.to_s.match?(/\\A\\s*\\[FAILED\\]/i)\n175\t\n176\t      \"blocked\"\n177\t    end\n178\t    private_class_method :step_attempt_outcome\n179\t\n180\t    def run_planner_turn(run_id:, summary:, next_step:, following_steps:, now: Time.current, previous_state: nil)\n181\t      StepPolicy.validate_plan!(run_id:, next_step:, following_steps:)\n182\t      # Single source of truth for \"next_step became the active step, so\n183\t      # record which criteria it addresses\" -- covers both a live planner\n184\t      # decision and Rails auto-promoting a previously queued followingSteps\n185\t      # item after a [DONE] result (see run_worker_turn) without a second\n186\t      # planner call. Only the former used to call this, which silently\n187\t      # dropped the addressesCriteria the planner already attached to every\n188\t      # followingSteps item, leaving auto-promoted steps invisible to\n189\t      # AcceptanceCriteriaWorkers and to ChaperoneTrigger's criterion join.\n190\t      run = Run.find_by!(run_id: run_id)\n191\t      enforce_branch_progression!(run:, next_step:)\n192\t      Orchestrator::AcceptanceCriteria.record_step!(run:, next_step: next_step)\n193\t      planner_blockers = Orchestrator::AcceptanceCriteria.planner_blockers(run_id: run_id)\n194\t      if next_step.nil? && planner_blockers.any?\n195\t        raise ArgumentError, \"Cannot complete run while acceptance criteria remain pending: #{planner_blockers.join(', ')}\"\n196\t      end\n197\t\n198\t      # An open blocking question means the run is waiting on the user, not\n199\t      # the planner -- publishing new jobs here would dispatch workers behind\n200\t      # a UI that still reads \"awaiting_user_feedback\", so no new work may be queued\n201\t      # until the question is answered.\n202\t      has_open_blocking_question = UserQuestion.exists?(run_id: run_id, status: \"open\", priority: \"blocking\")\n203\t      jobs =\n204\t        if has_open_blocking_question\n205\t          []\n206\t        else\n207\t          Planner.publish_planner_jobs(\n208\t            run_id: run_id,\n209\t            summary: summary,\n210\t            plan: { summary: summary, next_step: next_step, following_steps: following_steps }\n211\t          )\n212\t        end\n213\t      # The planner that is submitting this decision remains registered as\n214\t      # running until its CLI process exits. It is not work that should keep\n215\t      # the run alive after a nil next_step, otherwise every completed planner\n216\t      # turn becomes waiting_on_workers and the stall recovery loop restarts.\n217\t      active_executor_exists = Worker.where(run_id: run_id, status: \"running\").where.not(role: \"planner\").exists?\n218\t      # A criterion can be unresolved (ready_for_verification) with no\n219\t      # active_executor yet -- the verifier SpawnRequest this same update\n220\t      # just created hasn't been dispatched by SpawnRequestedWorkers yet.\n221\t      # The run must not read \"completed\" in that gap.\n222\t      unresolved_criteria_exist = Orchestrator::AcceptanceCriteria.completion_blockers(run_id: run_id).any?\n223\t      completion_phase =\n224\t        if has_open_blocking_question\n225\t          \"awaiting_user_feedback\"\n226\t        elsif next_step\n227\t          \"planning\"\n228\t        elsif active_executor_exists || unresolved_criteria_exist\n229\t          \"waiting_on_workers\"\n230\t        else\n231\t          \"completed\"\n232\t        end\n233\t\n234\t      next_state = {\n235\t        run_id: run_id,\n236\t        # next_step: nil only means \"completed\" when nothing is still in\n237\t        # flight. A recovery planner can legitimately publish no new\n238\t        # immediate handoff because an existing worker should continue\n239\t        # uninterrupted; in that case the run must stay\n240\t        # waiting_on_workers rather than flipping completed.\n241\t        phase: completion_phase,\n242\t        tick_count: (previous_state&.dig(:tick_count) || 0) + 1,\n243\t        last_plan_summary: summary,\n244\t        pending_spawn_keys: ((previous_state&.dig(:pending_spawn_keys) || []) + Planner.build_pending_spawn_keys(run_id: run_id, jobs: jobs)).uniq,\n245\t        following_steps: following_steps,\n246\t        last_stall_finding: previous_state&.dig(:last_stall_finding),\n247\t        last_updated_at: now.utc.iso8601(3)\n248\t      }\n249\t\n250\t      { jobs: jobs, next_state: next_state }\n251\t    end\n252\t\n253\t    def enforce_branch_progression!(run:, next_step:)\n254\t      return unless next_step\n255\t\n256\t      branch_key = AcceptanceCriteria.branch_key_for_step(run:, step: next_step)\n257\t      return unless branch_key\n258\t\n259\t      active_key = run.active_branch_key\n260\t      if active_key.present? && !AcceptanceCriteria.branch_resolved?(run:, branch_key: active_key) && branch_key != active_key\n261\t        raise ArgumentError, \"Cannot leave active acceptance branch #{active_key} before it resolves\"\n262\t      end\n263\t\n264\t      run.update!(active_branch_key: branch_key) if active_key != branch_key\n265\t    end\n266\t    private_class_method :enforce_branch_progression!\n267\t\n268\t    # A run can go dead without ever looking \"stalled\": a worker stops\n269\t    # (crash, or a clean exit whose worker_turn call never landed) without\n270\t    # producing a follow-up spawn request.\n271\t    def build_dead_end_finding(run_id:, following_steps:)\n272\t      [\n273\t        \"Run #{run_id} has no active workers and no open spawn requests, but was not marked completed.\",\n274\t        \"following_steps queue at last check: #{following_steps.to_json}\",\n275\t        \"The most recent worker likely stopped without completing its worker_turn handoff (crashed, or the call \" \\\n276\t          \"failed) -- inspect its last known report/artifact and decide whether to retry, fix, or escalate to the user.\"\n277\t      ].join(\" \")\n278\t    end\n279\t    public :build_dead_end_finding\n280\t  end\n281\tend\n282\t"}]},"parent_tool_use_id":null,"session_id":"8b4af749-2a39-4012-a7f2-ddf24e6c5426","uuid":"f92149a2-e637-45c0-bca4-16ecd6907b71","timestamp":"2026-07-24T16:10:10.531Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/services/orchestrator/turn.rb","content":"module Orchestrator\n  # Ports scripts/worker-turn.ts and scripts/planner-turn.ts. Snake_case throughout -- camelizing for the\n  # wire only happens at each MCP tool's McpTools::ToolResponse.structured\n  # call (see Orchestrator::TickState for the DB read/write boundary).\n  module Turn\n    module_function\n\n    PLANNER_FOLLOWUP_SCOPE = \"workflow-plan.md\"\n\n    # task is part of the MCP tool's input schema for API-surface\n    # consistency with the other turn tools, but -- matching\n    # scripts/worker-turn.ts exactly -- is never actually read here.\n    def run_worker_turn(run_id:, role:, nickname:, scope:, result:, evidence_outcome: nil, evidence_citations: [], diagnosis_findings: nil, produced_artifacts: nil, now: Time.current, previous_state: nil)\n      DiagnosisEvidenceGate.validate!(run_id:, nickname:, scope:, evidence_outcome:, evidence_citations:)\n      StructuredDiagnosisFindings.persist!(run_id:, nickname:, scope:, findings: diagnosis_findings) if diagnosis_findings.present?\n      \n      # Validate and record produced artifacts\n      artifact_names = validate_and_record_artifacts!(run_id:, nickname:, produced_artifacts:)\n      \n      following_steps = previous_state&.dig(:following_steps) || []\n      active_worker_ids = Worker.where(run_id: run_id, status: \"running\").pluck(:worker_id).to_set\n\n      if (review = record_step_attempt(run_id:, nickname:, result:, evidence_outcome:, evidence_citations:))\n        next_state = (previous_state || TickState.default_state(run_id)).merge(\n          phase: \"planning\", last_plan_summary: \"Strong chaperone is reviewing repeated worker failures.\",\n          last_updated_at: now.utc.iso8601(3)\n        )\n        return { planner_request: nil, chaperone_review: { review_id: review.review_id }, next_state: next_state }\n      end\n\n      run = Run.find_by!(run_id: run_id)\n      active_branch_open = run.active_branch_key.present? && !AcceptanceCriteria.branch_resolved?(run:, branch_key: run.active_branch_key)\n\n      # A completed node may only promote its next sibling after the current\n      # acceptance branch is resolved. Otherwise the planner must insert the\n      # next child of this branch (for example, measure -> repair -> verify)\n      # ahead of later verifier siblings.\n      if completed_result?(result) && following_steps.any? && !active_branch_open\n        next_step, *remaining_steps = following_steps\n        summary = \"#{nickname} completed #{scope}. Rails promoted the next previously planned step without another planner call.\"\n        promoted = run_planner_turn(\n          run_id:, summary:, next_step:, following_steps: remaining_steps, now:, previous_state:\n        )\n        return promoted.merge(planner_request: nil, promoted_preplanned_step: true)\n      end\n\n      # A follow-up planner request is a repeatable recovery ask, not a\n      # one-time artifact -- an 'open' request is safe to reuse\n      # unconditionally, but a 'fulfilled' one only still represents\n      # \"already being handled\" while the planner it spawned is still\n      # active.\n      existing_request = SpawnRequest\n        .where(run_id: run_id, requested_role: \"planner\", scope: PLANNER_FOLLOWUP_SCOPE)\n        .where.not(status: \"dismissed\")\n        .detect do |request|\n          request.status == \"open\" ||\n            (request.fulfilled_worker_id.present? && active_worker_ids.include?(request.fulfilled_worker_id)) ||\n            PlannerDecision.active.exists?(spawn_request_id: request.request_id)\n        end\n\n      planner_request = existing_request || SpawnRequest.create!(\n        run_id: run_id,\n        asked_by: \"worker\",\n        scope: PLANNER_FOLLOWUP_SCOPE,\n        text: \"Decide the next nextStep (usually the head of followingSteps, but reconsider it against the reported \" \\\n          \"result) and the new followingSteps, then publish them with planner_turn. If blocked on a user decision, \" \\\n          \"call append_user_question.\",\n        context: [\n          \"Worker #{nickname} (role #{role}) reported this result for run #{run_id}, scope #{scope}: #{result}\",\n          (evidence_outcome.present? ? \"Evidence outcome: #{evidence_outcome}; citations: #{Array(evidence_citations).join(', ')}.\" : nil),\n          (artifact_names.any? ? \"Produced artifacts: #{artifact_names.join(', ')}.\" : nil),\n          \"Current followingSteps queue (JSON, decided by the previous planner_turn call): #{following_steps.to_json}\"\n        ].compact.join(\" \"),\n        requested_role: \"planner\",\n        priority: \"blocking\",\n        tags: [ \"planner\", PLANNER_FOLLOWUP_SCOPE, \"worker-turn-followup\", (\"evidence-#{evidence_outcome}\" if evidence_outcome.present?) ].compact\n      )\n\n      # phase/tick_count/last_plan_summary/last_stall_finding/following_steps\n      # are all owned by planner_turn and orchestrator-turn's stall\n      # detection -- worker_turn only requests the follow-up planner and\n      # reports what it saw, so it carries all of this forward untouched.\n      next_state = {\n        run_id: run_id,\n        phase: previous_state&.dig(:phase) || \"starting\",\n        tick_count: previous_state&.dig(:tick_count) || 0,\n        last_stall_finding: previous_state&.dig(:last_stall_finding),\n        last_plan_summary: previous_state&.dig(:last_plan_summary),\n        pending_spawn_keys: previous_state&.dig(:pending_spawn_keys) || [],\n        following_steps: following_steps,\n        last_updated_at: now.utc.iso8601(3)\n      }\n\n      { planner_request: { request_id: planner_request.request_id }, next_state: next_state }\n    end\n\n    def validate_and_record_artifacts!(run_id:, nickname:, produced_artifacts:)\n      return [] unless produced_artifacts.present?\n\n      run = Run.find_by!(run_id: run_id)\n      worker = Worker.where(run_id:, nickname:).order(created_at: :desc).first\n      raise ArgumentError, \"Worker not found for artifact recording: #{nickname}\" unless worker\n\n      artifact_names = produced_artifacts.map { |a| a[:name] || a[\"name\"] }\n      \n      # Validate all declared artifacts exist in the artifact store\n      missing = artifact_names.reject do |name|\n        begin\n          path = ArtifactStore.resolve_path(run.target_root, run_id, name)\n          File.file?(path)\n        rescue ArgumentError\n          false\n        end\n      end\n      \n      raise ArgumentError, \"Declared artifacts do not exist: #{missing.join(', ')}\" if missing.any?\n\n      # Update worker.produced_artifacts\n      worker.update_column(:produced_artifacts, artifact_names)\n      \n      # Record artifact inheritance in RunContext\n      artifact_names.each do |artifact_name|\n        Orchestrator::RunContext.upsert!(\n          run_id: run_id,\n          entry_key: \"artifact_produced_#{artifact_name}_by_#{worker.worker_id}\",\n          kind: \"fact\",\n          status: \"confirmed\",\n          content: \"Worker #{nickname} (#{worker.worker_id}) produced artifact: #{artifact_name}\",\n          evidence_ref: artifact_name,\n          created_by: \"orchestrator\"\n        )\n      end\n\n      artifact_names\n    end\n    private_class_method :validate_and_record_artifacts!\n\n    def completed_result?(result)\n      result.to_s.match?(/\\A\\s*\\[DONE\\]/i)\n    end\n    private_class_method :completed_result?\n\n    # Covers every execution mode, not only diagnosis -- a worker that\n    # correctly reports [BLOCKED]/[FAILED] via worker_turn must be exactly\n    # as visible to ChaperoneTrigger as one whose process dies outright\n    # (see WorkerReconcileJob#record_failed_attempt, which was already\n    # mode-agnostic). Diagnosis alone keeps its stricter done/evidence\n    # coupling -- see step_attempt_outcome.\n    def record_step_attempt(run_id:, nickname:, result:, evidence_outcome:, evidence_citations:)\n      worker = Worker.where(run_id:, nickname:).order(created_at: :desc).first\n      request = worker && SpawnRequest.find_by(fulfilled_worker_id: worker.worker_id)\n      return unless request\n\n      mode = SpawnRequestedWorkers.execution_mode(request).presence || \"unknown\"\n      outcome = step_attempt_outcome(result:, evidence_outcome:, mode:)\n      lineage_key = request.lineage_key.presence || request.scope\n      attempt = StepAttempt.create!(\n        run_id:, spawn_request: request, worker_id: worker.worker_id, lineage_key:, mode:,\n        outcome:, result:, evidence_outcome:, evidence_citations:\n      )\n      return unless outcome.in?(%w[blocked failed])\n\n      ChaperoneTrigger.call(attempt)\n    end\n    private_class_method :record_step_attempt\n\n    # Diagnosis requires evidenceOutcome=confirmed before a [DONE] report\n    # counts as actually done -- DiagnosisEvidenceGate already enforces the\n    # citation discipline behind that claim. Other modes have no such\n    # evidence contract, so a bare [DONE] is trusted at face value there.\n    def step_attempt_outcome(result:, evidence_outcome:, mode:)\n      done = result.to_s.match?(/\\A\\s*\\[DONE\\]/i)\n      return \"done\" if done && (mode != \"diagnosis\" || evidence_outcome == \"confirmed\")\n      return \"failed\" if result.to_s.match?(/\\A\\s*\\[FAILED\\]/i)\n\n      \"blocked\"\n    end\n    private_class_method :step_attempt_outcome\n\n    def run_planner_turn(run_id:, summary:, next_step:, following_steps:, now: Time.current, previous_state: nil)\n      StepPolicy.validate_plan!(run_id:, next_step:, following_steps:)\n      # Single source of truth for \"next_step became the active step, so\n      # record which criteria it addresses\" -- covers both a live planner\n      # decision and Rails auto-promoting a previously queued followingSteps\n      # item after a [DONE] result (see run_worker_turn) without a second\n      # planner call. Only the former used to call this, which silently\n      # dropped the addressesCriteria the planner already attached to every\n      # followingSteps item, leaving auto-promoted steps invisible to\n      # AcceptanceCriteriaWorkers and to ChaperoneTrigger's criterion join.\n      run = Run.find_by!(run_id: run_id)\n      enforce_branch_progression!(run:, next_step:)\n      Orchestrator::AcceptanceCriteria.record_step!(run:, next_step: next_step)\n      planner_blockers = Orchestrator::AcceptanceCriteria.planner_blockers(run_id: run_id)\n      if next_step.nil? && planner_blockers.any?\n        raise ArgumentError, \"Cannot complete run while acceptance criteria remain pending: #{planner_blockers.join(', ')}\"\n      end\n\n      # An open blocking question means the run is waiting on the user, not\n      # the planner -- publishing new jobs here would dispatch workers behind\n      # a UI that still reads \"awaiting_user_feedback\", so no new work may be queued\n      # until the question is answered.\n      has_open_blocking_question = UserQuestion.exists?(run_id: run_id, status: \"open\", priority: \"blocking\")\n      jobs =\n        if has_open_blocking_question\n          []\n        else\n          Planner.publish_planner_jobs(\n            run_id: run_id,\n            summary: summary,\n            plan: { summary: summary, next_step: next_step, following_steps: following_steps }\n          )\n        end\n      # The planner that is submitting this decision remains registered as\n      # running until its CLI process exits. It is not work that should keep\n      # the run alive after a nil next_step, otherwise every completed planner\n      # turn becomes waiting_on_workers and the stall recovery loop restarts.\n      active_executor_exists = Worker.where(run_id: run_id, status: \"running\").where.not(role: \"planner\").exists?\n      # A criterion can be unresolved (ready_for_verification) with no\n      # active_executor yet -- the verifier SpawnRequest this same update\n      # just created hasn't been dispatched by SpawnRequestedWorkers yet.\n      # The run must not read \"completed\" in that gap.\n      unresolved_criteria_exist = Orchestrator::AcceptanceCriteria.completion_blockers(run_id: run_id).any?\n      completion_phase =\n        if has_open_blocking_question\n          \"awaiting_user_feedback\"\n        elsif next_step\n          \"planning\"\n        elsif active_executor_exists || unresolved_criteria_exist\n          \"waiting_on_workers\"\n        else\n          \"completed\"\n        end\n\n      next_state = {\n        run_id: run_id,\n        # next_step: nil only means \"completed\" when nothing is still in\n        # flight. A recovery planner can legitimately publish no new\n        # immediate handoff because an existing worker should continue\n        # uninterrupted; in that case the run must stay\n        # waiting_on_workers rather than flipping completed.\n        phase: completion_phase,\n        tick_count: (previous_state&.dig(:tick_count) || 0) + 1,\n        last_plan_summary: summary,\n        pending_spawn_keys: ((previous_state&.dig(:pending_spawn_keys) || []) + Planner.build_pending_spawn_keys(run_id: run_id, jobs: jobs)).uniq,\n        following_steps: following_steps,\n        last_stall_finding: previous_state&.dig(:last_stall_finding),\n        last_updated_at: now.utc.iso8601(3)\n      }\n\n      { jobs: jobs, next_state: next_state }\n    end\n\n    def enforce_branch_progression!(run:, next_step:)\n      return unless next_step\n\n      branch_key = AcceptanceCriteria.branch_key_for_step(run:, step: next_step)\n      return unless branch_key\n\n      active_key = run.active_branch_key\n      if active_key.present? && !AcceptanceCriteria.branch_resolved?(run:, branch_key: active_key) && branch_key != active_key\n        raise ArgumentError, \"Cannot leave active acceptance branch #{active_key} before it resolves\"\n      end\n\n      run.update!(active_branch_key: branch_key) if active_key != branch_key\n    end\n    private_class_method :enforce_branch_progression!\n\n    # A run can go dead without ever looking \"stalled\": a worker stops\n    # (crash, or a clean exit whose worker_turn call never landed) without\n    # producing a follow-up spawn request.\n    def build_dead_end_finding(run_id:, following_steps:)\n      [\n        \"Run #{run_id} has no active workers and no open spawn requests, but was not marked completed.\",\n        \"following_steps queue at last check: #{following_steps.to_json}\",\n        \"The most recent worker likely stopped without completing its worker_turn handoff (crashed, or the call \" \\\n          \"failed) -- inspect its last known report/artifact and decide whether to retry, fix, or escalate to the user.\"\n      ].join(\" \")\n    end\n    public :build_dead_end_finding\n  end\nend\n","numLines":282,"startLine":1,"totalLines":282}}}
