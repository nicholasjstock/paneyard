}
.badge.running, .badge.answered, .badge.completed, .badge.fulfilled, .badge.verified, .badge.waived { color: var(--success); border-color: var(--success); }
.badge.blocking, .badge.blocked_on_user, .badge.failed, .badge.stalled, .badge.attention, .badge.blocked { color: var(--danger); border-color: var(--danger); }
.badge.launching, .badge.stopping, .badge.open, .badge.planning, .badge.queued, .badge.pending, .badge.in_progress, .badge.ready_for_verification { color: var(--warn); border-color: var(--warn); }

