{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GqGG2HguzCjQuvnPnR9UUz","type":"tool_result","content":"1\trequire \"rails_helper\"\n2\t\n3\tRSpec.describe \"MCP workflow integrations\" do\n4\t  it \"publishes planner jobs and creates a worker spawn request\" do\n5\t    run = create_run(\"mcp-plan\")\n6\t\n7\t    response = McpTools::PublishPlannerJobsTool.call(\n8\t      runId: run.run_id,\n9\t      task: \"Fix the backend regression\",\n10\t      verifierFinding: \"backend request spec is failing\",\n11\t      server_context: nil\n12\t    )\n13\t\n14\t    expect(response.structured_content[:jobs]).not_to be_empty\n15\t    request = run.spawn_requests.order(:created_at).last\n16\t    expect(request).to have_attributes(asked_by: \"planner\", requested_role: \"worker\", scope: \"fix-summary.md\")\n17\t    expect(run.bus_events.order(:created_at).pluck(:event_type)).to include(\"spawn_request.created\")\n18\t  end\n19\t\n20\t  it \"carries a diagnosis-only policy into the spawned worker request\" do\n21\t    run = create_run(\"mcp-diagnosis-policy\")\n22\t\n23\t    response = McpTools::PlannerTurnTool.call(\n24\t      runId: run.run_id,\n25\t      summary: \"The failing boundary is not confirmed yet.\",\n26\t      nextStep: {\n27\t        owner: \"worker\",\n28\t        artifact: \"api-diagnosis.md\",\n29\t        successCheck: \"Capture the POST response, subsequent GET response, and rendered state.\",\n30\t        mode: \"diagnosis\",\n31\t        writeScope: \"source_protected\",\n32\t        allowedPaths: [],\n33\t        evidenceRefs: []\n34\t      },\n35\t      followingSteps: [],\n36\t      server_context: nil\n37\t    )\n38\t\n39\t    request = run.spawn_requests.order(:created_at).last\n40\t    expect(response.structured_content[:nextState][:phase]).to eq(\"planning\")\n41\t    expect(request.text).to include(\n42\t      \"Execution mode: diagnosis\",\n43\t      \"Planner-suggested repository paths: none\",\n44\t      \"Do not implement an application fix\"\n45\t    )\n46\t  end\n47\t\n48\t  it \"rejects a planner step that combines diagnosis and implementation\" do\n49\t    run = create_run(\"mcp-combined-diagnosis-fix\")\n50\t\n51\t    expect do\n52\t      McpTools::PlannerTurnTool.call(\n53\t        runId: run.run_id,\n54\t        summary: \"Evidence is still missing.\",\n55\t        nextStep: {\n56\t          owner: \"worker\",\n57\t          artifact: \"api-diagnosis.md\",\n58\t          successCheck: \"Capture the response and then implement the smallest fix.\",\n59\t          mode: \"diagnosis\",\n60\t          writeScope: \"source_protected\",\n61\t          allowedPaths: [],\n62\t          evidenceRefs: []\n63\t        },\n64\t        followingSteps: [],\n65\t        server_context: nil\n66\t      )\n67\t    end.to raise_error(ArgumentError, \"diagnosis step cannot also request implementation\")\n68\t\n69\t    expect(run.spawn_requests).to be_empty\n70\t  end\n71\t\n72\t  it \"writes and reads orchestrator state and history through the tool layer\" do\n73\t    run = create_run(\"mcp-state\")\n74\t\n75\t    write_response = McpTools::WriteOrchestratorStateTool.call(\n76\t      runId: run.run_id,\n77\t      phase: \"planning\",\n78\t      tickCount: 2,\n79\t      lastPlanSummary: \"Plan the next handoff\",\n80\t      pendingSpawnKeys: [ \"key-1\" ],\n81\t      followingSteps: [ { owner: \"worker\", artifact: \"fix-summary.md\", successCheck: \"Ship a fix\" } ],\n82\t      lastStallFinding: \"stalled worker\",\n83\t      lastUpdatedAt: Time.current.iso8601,\n84\t      server_context: nil\n85\t    )\n86\t\n87\t    expect(write_response.structured_content[:state][:phase]).to eq(\"planning\")\n88\t\n89\t    read_response = McpTools::ReadOrchestratorStateTool.call(runId: run.run_id, server_context: nil)\n90\t    history_response = McpTools::ReadOrchestratorTickHistoryTool.call(runId: run.run_id, server_context: nil)\n91\t\n92\t    expect(read_response.structured_content[:phase]).to eq(\"planning\")\n93\t    expect(history_response.structured_content[:entries].last[:tickCount]).to eq(2)\n94\t  end\n95\t\n96\t  it \"publishes run status and surfaces the event in the recent-event tool\" do\n97\t    run = create_run(\"mcp-status\")\n98\t\n99\t    status_response = McpTools::PublishRunStatusTool.call(\n100\t      runId: run.run_id,\n101\t      phase: \"waiting_on_workers\",\n102\t      owner: \"orchestrator\",\n103\t      summary: \"Waiting for the planner result.\",\n104\t      server_context: nil\n105\t    )\n106\t    events_response = McpTools::ListRecentEventsTool.call(runId: run.run_id, server_context: nil, limit: 5)\n107\t\n108\t    expect(status_response.structured_content[:phase]).to eq(\"waiting_on_workers\")\n109\t    expect(events_response.structured_content[:events].map { |event| event[:type] }).to include(\"run.status\")\n110\t  end\n111\t\n112\t  it \"round-trips workflow artifacts through the tool layer\" do\n113\t    run = create_run(\"mcp-artifact\")\n114\t\n115\t    write_response = McpTools::WriteWorkflowArtifactTool.call(\n116\t      runId: run.run_id,\n117\t      artifactName: \"workflow-plan.md\",\n118\t      content: \"# Plan\\n\\nShip the smallest fix.\\n\",\n119\t      server_context: nil\n120\t    )\n121\t    read_response = McpTools::ReadWorkflowArtifactTool.call(\n122\t      runId: run.run_id,\n123\t      artifactName: \"workflow-plan.md\",\n124\t      server_context: nil\n125\t    )\n126\t\n127\t    expect(write_response.structured_content[:path]).to end_with(\"/workflow-plan.md\")\n128\t    expect(read_response.structured_content[:content]).to include(\"Ship the smallest fix.\")\n129\t  end\n130\t\n131\t  it \"creates and answers a user question through the tool layer\" do\n132\t    run = create_run(\"mcp-question\")\n133\t\n134\t    create_response = McpTools::AppendUserQuestionTool.call(\n135\t      runId: run.run_id,\n136\t      askedBy: \"planner\",\n137\t      scope: \"workflow-plan.md\",\n138\t      text: \"Should we roll back the feature?\",\n139\t      priority: \"blocking\",\n140\t      tags: [ \"decision\" ],\n141\t      server_context: nil\n142\t    )\n143\t    question_id = create_response.structured_content[:questionId]\n144\t\n145\t    answer_response = McpTools::AnswerUserQuestionTool.call(\n146\t      questionId: question_id,\n147\t      answeredBy: \"operator\",\n148\t      answerText: \"No, keep the feature and patch it.\",\n149\t      server_context: nil\n150\t    )\n151\t\n152\t    expect(answer_response.structured_content[:status]).to eq(\"answered\")\n153\t    expect(run.user_questions.find_by!(question_id: question_id).answer_text).to include(\"keep the feature\")\n154\t    expect(run.bus_events.order(:created_at).pluck(:event_type)).to include(\"user_question.created\", \"user_question.answered\")\n155\t  end\n156\t\n157\t  it \"turns a worker result into follow-up planner work\" do\n158\t    run = create_run(\"mcp-worker-turn\")\n159\t    worker = create_worker(run, role: \"worker\", nickname: \"worker-1\", scope: \"fix-summary.md\")\n160\t    McpTools::WriteOrchestratorStateTool.call(\n161\t      runId: run.run_id,\n162\t      phase: \"planning\",\n163\t      tickCount: 1,\n164\t      pendingSpawnKeys: [],\n165\t      followingSteps: [ { owner: \"worker\", artifact: \"verifier-report.md\", successCheck: \"Verify the fix\" } ],\n166\t      server_context: nil\n167\t    )\n168\t\n169\t    response = McpTools::WorkerTurnTool.call(\n170\t      runId: run.run_id,\n171\t      role: \"worker\",\n172\t      nickname: \"worker-1\",\n173\t      scope: \"fix-summary.md\",\n174\t      result: \"Fix applied and ready for follow-up planning.\",\n175\t      task: run.task,\n176\t      server_context: nil\n177\t    )\n178\t\n179\t    planner_request = run.spawn_requests.order(:created_at).last\n180\t\n181\t    expect(response.structured_content[:plannerRequest][:requestId]).to eq(planner_request.request_id)\n182\t    expect(planner_request).to have_attributes(requested_role: \"planner\", scope: \"workflow-plan.md\")\n183\t    expect(worker.reload.handoff_completed_at).to be_present\n184\t  end\n185\t\n186\t  it \"rejects a diagnosis handoff without artifact-backed evidence citations\" do\n187\t    run = create_run(\"mcp-diagnosis-evidence\")\n188\t    worker = create_worker(run, role: \"worker\", nickname: \"worker-diagnosis\", scope: \"diagnosis.md\")\n189\t    run.spawn_requests.create!(\n190\t      asked_by: \"planner\", scope: \"diagnosis.md\",\n191\t      text: \"Execution mode: diagnosis. Capture the POST and GET boundary.\",\n192\t      requested_role: \"worker\", priority: \"blocking\", status: \"fulfilled\",\n193\t      fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current, fulfilled_worker_id: worker.worker_id\n194\t    )\n195\t    Orchestrator::ArtifactStore.write(\n196\t      run.target_root, run.run_id, \"diagnosis.md\",\n197\t      \"Evidence: POST completed at 12:00:01Z; reproduction stopped before the GET request.\"\n198\t    )\n199\t\n200\t    rejected = McpTools::WorkerTurnTool.call(\n201\t      runId: run.run_id, role: \"worker\", nickname: worker.nickname, scope: worker.scope,\n202\t      result: \"Diagnosis complete.\", task: run.task, server_context: nil\n203\t    )\n204\t    expect(rejected.error?).to be(true)\n205\t    expect(rejected.content.first[:text]).to include(\"requires evidenceOutcome=confirmed or blocked\")\n206\t\n207\t    response = McpTools::WorkerTurnTool.call(\n208\t      runId: run.run_id, role: \"worker\", nickname: worker.nickname, scope: worker.scope,\n209\t      result: \"The target boundary was not reached.\", task: run.task,\n210\t      evidenceOutcome: \"blocked\",\n211\t      evidenceCitations: [ \"reproduction stopped before the GET request\" ],\n212\t      server_context: nil\n213\t    )\n214\t\n215\t    expect(response.structured_content[:plannerRequest][:requestId]).to be_present\n216\t    expect(worker.reload.handoff_completed_at).to be_present\n217\t  end\n218\t\n219\t  it \"returns the exact missing citation as an actionable tool error\" do\n220\t    run = create_run(\"mcp-diagnosis-citation\")\n221\t    worker = create_worker(run, role: \"worker\", nickname: \"worker-diagnosis\", scope: \"diagnosis.md\")\n222\t    run.spawn_requests.create!(\n223\t      asked_by: \"planner\", scope: worker.scope, text: \"Execution mode: diagnosis. Capture evidence.\",\n224\t      requested_role: \"worker\", priority: \"blocking\", status: \"fulfilled\",\n225\t      fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current, fulfilled_worker_id: worker.worker_id\n226\t    )\n227\t    Orchestrator::ArtifactStore.write(run.target_root, run.run_id, worker.scope, \"Exact artifact sentence.\")\n228\t\n229\t    response = McpTools::WorkerTurnTool.call(\n230\t      runId: run.run_id, role: \"worker\", nickname: worker.nickname, scope: worker.scope,\n231\t      result: \"[BLOCKED] Could not reproduce.\", task: run.task, evidenceOutcome: \"blocked\",\n232\t      evidenceCitations: [ \"Paraphrased sentence.\" ], server_context: nil\n233\t    )\n234\t\n235\t    expect(response.error?).to be(true)\n236\t    expect(response.content.first[:text]).to include(\n237\t      \"diagnosis evidenceCitation not found in diagnosis.md: Paraphrased sentence.\"\n238\t    )\n239\t    expect(BusEvent.where(run_id: run.run_id, event_type: \"worker.handoff_rejected\")).to exist\n240\t  end\n241\t\n242\t  it \"turns a planner decision into completion state when nextStep is nil\" do\n243\t    run = create_run(\"mcp-planner-turn\")\n244\t\n245\t    response = McpTools::PlannerTurnTool.call(\n246\t      runId: run.run_id,\n247\t      summary: \"All work is complete.\",\n248\t      nextStep: nil,\n249\t      followingSteps: [],\n250\t      server_context: nil\n251\t    )\n252\t    latest_state = Orchestrator::TickState.latest(run.run_id)\n253\t\n254\t    expect(response.structured_content[:nextState][:phase]).to eq(\"completed\")\n255\t    expect(latest_state[:phase]).to eq(\"completed\")\n256\t  end\n257\t\n258\t  it \"keeps the run waiting_on_workers when planner_turn has no nextStep but a worker is still active\" do\n259\t    run = create_run(\"mcp-planner-wait\")\n260\t    run.workers.create!(\n261\t      worker_id: SecureRandom.uuid,\n262\t      role: \"worker\",\n263\t      nickname: \"worker-1\",\n264\t      reason: \"Still processing current step.\",\n265\t      scope: \"fix-summary.md\",\n266\t      status: \"running\",\n267\t      pid: 123_456,\n268\t      prompt_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.prompt.txt\"),\n269\t      log_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.log\"),\n270\t      last_message_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.last-message.txt\"),\n271\t      env_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.env.json\"),\n272\t      command: \"claude\",\n273\t      args: []\n274\t    )\n275\t\n276\t    response = McpTools::PlannerTurnTool.call(\n277\t      runId: run.run_id,\n278\t      summary: \"Do not spawn a duplicate worker; let the current one continue.\",\n279\t      nextStep: nil,\n280\t      followingSteps: [],\n281\t      server_context: nil\n282\t    )\n283\t    latest_state = Orchestrator::TickState.latest(run.run_id)\n284\t\n285\t    expect(response.structured_content[:nextState][:phase]).to eq(\"waiting_on_workers\")\n286\t    expect(latest_state[:phase]).to eq(\"waiting_on_workers\")\n287\t  end\n288\t\n289\t  it \"completes when the planner submitting a nil nextStep is the only active worker\" do\n290\t    run = create_run(\"mcp-planner-self\")\n291\t    planner = create_worker(run, role: \"planner\", nickname: \"planner-1\", scope: \"workflow-plan.md\")\n292\t\n293\t    response = McpTools::PlannerTurnTool.call(\n294\t      runId: run.run_id,\n295\t      summary: \"No further work is required.\",\n296\t      nextStep: nil,\n297\t      followingSteps: [],\n298\t      server_context: nil\n299\t    )\n300\t\n301\t    expect(response.structured_content[:nextState][:phase]).to eq(\"completed\")\n302\t    expect(Orchestrator::TickState.latest(run.run_id)[:phase]).to eq(\"completed\")\n303\t    expect(planner.reload.handoff_completed_at).to be_present\n304\t  end\n305\t\n306\t  it \"requeues a worker step when the previous fulfilled worker stopped, even if it wrote the artifact\" do\n307\t    run = create_run(\"mcp-worker-requeue\")\n308\t    stale_worker_id = SecureRandom.uuid\n309\t    run.spawn_requests.create!(\n310\t      asked_by: \"planner\",\n311\t      scope: \"phone-recording-report.md\",\n312\t      text: \"Record the phone demo again.\",\n313\t      context: \"Previous worker died before finishing.\",\n314\t      requested_role: \"worker\",\n315\t      priority: \"blocking\",\n316\t      status: \"fulfilled\",\n317\t      fulfilled_by: \"tick_run_job\",\n318\t      fulfilled_at: 2.minutes.ago,\n319\t      fulfillment_note: \"Spawned worker-1 (worker).\",\n320\t      fulfilled_worker_id: stale_worker_id\n321\t    )\n322\t    run.workers.create!(\n323\t      worker_id: stale_worker_id,\n324\t      role: \"worker\",\n325\t      nickname: \"worker-1\",\n326\t      reason: \"Old recording attempt.\",\n327\t      scope: \"phone-recording-report.md\",\n328\t      status: \"stopped\",\n329\t      pid: 123_456,\n330\t      stopped_at: 2.minutes.ago,\n331\t      stop_reason: \"Process exited before writing its artifact.\",\n332\t      prompt_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.prompt.txt\"),\n333\t      log_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.log\"),\n334\t      last_message_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.last-message.txt\"),\n335\t      env_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.env.json\"),\n336\t      command: \"claude\",\n337\t      args: []\n338\t    )\n339\t    Orchestrator::ArtifactStore.write(run.target_root, run.run_id, \"phone-recording-report.md\", \"Incomplete first attempt.\")\n340\t\n341\t    response = McpTools::PlannerTurnTool.call(\n342\t      runId: run.run_id,\n343\t      summary: \"Retry the same recording step because the first worker died before producing the artifact.\",\n344\t      nextStep: {\n345\t        owner: \"worker\",\n346\t        artifact: \"phone-recording-report.md\",\n347\t        successCheck: \"Write the recording report.\",\n348\t        mode: \"recording\",\n349\t        writeScope: \"source_protected\",\n350\t        allowedPaths: [],\n351\t        evidenceRefs: [ \"prior recording attempt\" ]\n352\t      },\n353\t      followingSteps: [],\n354\t      server_context: nil\n355\t    )\n356\t\n357\t    expect(response.structured_content[:jobs].size).to eq(1)\n358\t    latest_request = run.spawn_requests.order(:created_at).last\n359\t    expect(latest_request.request_id).not_to eq(run.spawn_requests.order(:created_at).first.request_id)\n360\t    expect(latest_request).to have_attributes(status: \"open\", requested_role: \"worker\", scope: \"phone-recording-report.md\")\n361\t  end\n362\t\n363\t  def create_run(suffix)\n364\t    unique_suffix = \"#{suffix}-#{SecureRandom.hex(4)}\"\n365\t    workspace = Workspace.create!(name: \"planner-#{unique_suffix}\", root_path: \"/tmp/planner-#{unique_suffix}\")\n366\t    FileUtils.mkdir_p(File.join(workspace.root_path, \"front\", \"demo-output\", \"agents-sdk\"))\n367\t    Run.create!(\n368\t      run_id: \"demo-#{unique_suffix}\",\n369\t      task: \"Exercise MCP workflow #{suffix}\",\n370\t      workspace: workspace,\n371\t      target_root: workspace.root_path,\n372\t      launcher_variant: \"claude\",\n373\t      status: \"running\",\n374\t      launched_by: \"operator\",\n375\t      started_at: Time.current\n376\t    )\n377\t  end\n378\t\n379\t  def create_worker(run, role:, nickname:, scope:)\n380\t    run.workers.create!(\n381\t      worker_id: SecureRandom.uuid,\n382\t      role: role,\n383\t      nickname: nickname,\n384\t      reason: \"Test #{role} handoff.\",\n385\t      scope: scope,\n386\t      status: \"running\",\n387\t      pid: 123_456,\n388\t      prompt_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"#{nickname}.prompt.txt\"),\n389\t      log_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"#{nickname}.log\"),\n390\t      last_message_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"#{nickname}.last-message.txt\"),\n391\t      env_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"#{nickname}.env.json\"),\n392\t      command: \"claude\",\n393\t      args: []\n394\t    )\n395\t  end\n396\tend\n397\t"}]},"parent_tool_use_id":null,"session_id":"8d2892c6-77f9-4067-a6e3-5a7da84f2051","uuid":"6c748446-41b1-4b00-b928-0c9260b37856","timestamp":"2026-07-24T21:04:04.674Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/spec/integration/mcp_workflows_spec.rb","content":"require \"rails_helper\"\n\nRSpec.describe \"MCP workflow integrations\" do\n  it \"publishes planner jobs and creates a worker spawn request\" do\n    run = create_run(\"mcp-plan\")\n\n    response = McpTools::PublishPlannerJobsTool.call(\n      runId: run.run_id,\n      task: \"Fix the backend regression\",\n      verifierFinding: \"backend request spec is failing\",\n      server_context: nil\n    )\n\n    expect(response.structured_content[:jobs]).not_to be_empty\n    request = run.spawn_requests.order(:created_at).last\n    expect(request).to have_attributes(asked_by: \"planner\", requested_role: \"worker\", scope: \"fix-summary.md\")\n    expect(run.bus_events.order(:created_at).pluck(:event_type)).to include(\"spawn_request.created\")\n  end\n\n  it \"carries a diagnosis-only policy into the spawned worker request\" do\n    run = create_run(\"mcp-diagnosis-policy\")\n\n    response = McpTools::PlannerTurnTool.call(\n      runId: run.run_id,\n      summary: \"The failing boundary is not confirmed yet.\",\n      nextStep: {\n        owner: \"worker\",\n        artifact: \"api-diagnosis.md\",\n        successCheck: \"Capture the POST response, subsequent GET response, and rendered state.\",\n        mode: \"diagnosis\",\n        writeScope: \"source_protected\",\n        allowedPaths: [],\n        evidenceRefs: []\n      },\n      followingSteps: [],\n      server_context: nil\n    )\n\n    request = run.spawn_requests.order(:created_at).last\n    expect(response.structured_content[:nextState][:phase]).to eq(\"planning\")\n    expect(request.text).to include(\n      \"Execution mode: diagnosis\",\n      \"Planner-suggested repository paths: none\",\n      \"Do not implement an application fix\"\n    )\n  end\n\n  it \"rejects a planner step that combines diagnosis and implementation\" do\n    run = create_run(\"mcp-combined-diagnosis-fix\")\n\n    expect do\n      McpTools::PlannerTurnTool.call(\n        runId: run.run_id,\n        summary: \"Evidence is still missing.\",\n        nextStep: {\n          owner: \"worker\",\n          artifact: \"api-diagnosis.md\",\n          successCheck: \"Capture the response and then implement the smallest fix.\",\n          mode: \"diagnosis\",\n          writeScope: \"source_protected\",\n          allowedPaths: [],\n          evidenceRefs: []\n        },\n        followingSteps: [],\n        server_context: nil\n      )\n    end.to raise_error(ArgumentError, \"diagnosis step cannot also request implementation\")\n\n    expect(run.spawn_requests).to be_empty\n  end\n\n  it \"writes and reads orchestrator state and history through the tool layer\" do\n    run = create_run(\"mcp-state\")\n\n    write_response = McpTools::WriteOrchestratorStateTool.call(\n      runId: run.run_id,\n      phase: \"planning\",\n      tickCount: 2,\n      lastPlanSummary: \"Plan the next handoff\",\n      pendingSpawnKeys: [ \"key-1\" ],\n      followingSteps: [ { owner: \"worker\", artifact: \"fix-summary.md\", successCheck: \"Ship a fix\" } ],\n      lastStallFinding: \"stalled worker\",\n      lastUpdatedAt: Time.current.iso8601,\n      server_context: nil\n    )\n\n    expect(write_response.structured_content[:state][:phase]).to eq(\"planning\")\n\n    read_response = McpTools::ReadOrchestratorStateTool.call(runId: run.run_id, server_context: nil)\n    history_response = McpTools::ReadOrchestratorTickHistoryTool.call(runId: run.run_id, server_context: nil)\n\n    expect(read_response.structured_content[:phase]).to eq(\"planning\")\n    expect(history_response.structured_content[:entries].last[:tickCount]).to eq(2)\n  end\n\n  it \"publishes run status and surfaces the event in the recent-event tool\" do\n    run = create_run(\"mcp-status\")\n\n    status_response = McpTools::PublishRunStatusTool.call(\n      runId: run.run_id,\n      phase: \"waiting_on_workers\",\n      owner: \"orchestrator\",\n      summary: \"Waiting for the planner result.\",\n      server_context: nil\n    )\n    events_response = McpTools::ListRecentEventsTool.call(runId: run.run_id, server_context: nil, limit: 5)\n\n    expect(status_response.structured_content[:phase]).to eq(\"waiting_on_workers\")\n    expect(events_response.structured_content[:events].map { |event| event[:type] }).to include(\"run.status\")\n  end\n\n  it \"round-trips workflow artifacts through the tool layer\" do\n    run = create_run(\"mcp-artifact\")\n\n    write_response = McpTools::WriteWorkflowArtifactTool.call(\n      runId: run.run_id,\n      artifactName: \"workflow-plan.md\",\n      content: \"# Plan\\n\\nShip the smallest fix.\\n\",\n      server_context: nil\n    )\n    read_response = McpTools::ReadWorkflowArtifactTool.call(\n      runId: run.run_id,\n      artifactName: \"workflow-plan.md\",\n      server_context: nil\n    )\n\n    expect(write_response.structured_content[:path]).to end_with(\"/workflow-plan.md\")\n    expect(read_response.structured_content[:content]).to include(\"Ship the smallest fix.\")\n  end\n\n  it \"creates and answers a user question through the tool layer\" do\n    run = create_run(\"mcp-question\")\n\n    create_response = McpTools::AppendUserQuestionTool.call(\n      runId: run.run_id,\n      askedBy: \"planner\",\n      scope: \"workflow-plan.md\",\n      text: \"Should we roll back the feature?\",\n      priority: \"blocking\",\n      tags: [ \"decision\" ],\n      server_context: nil\n    )\n    question_id = create_response.structured_content[:questionId]\n\n    answer_response = McpTools::AnswerUserQuestionTool.call(\n      questionId: question_id,\n      answeredBy: \"operator\",\n      answerText: \"No, keep the feature and patch it.\",\n      server_context: nil\n    )\n\n    expect(answer_response.structured_content[:status]).to eq(\"answered\")\n    expect(run.user_questions.find_by!(question_id: question_id).answer_text).to include(\"keep the feature\")\n    expect(run.bus_events.order(:created_at).pluck(:event_type)).to include(\"user_question.created\", \"user_question.answered\")\n  end\n\n  it \"turns a worker result into follow-up planner work\" do\n    run = create_run(\"mcp-worker-turn\")\n    worker = create_worker(run, role: \"worker\", nickname: \"worker-1\", scope: \"fix-summary.md\")\n    McpTools::WriteOrchestratorStateTool.call(\n      runId: run.run_id,\n      phase: \"planning\",\n      tickCount: 1,\n      pendingSpawnKeys: [],\n      followingSteps: [ { owner: \"worker\", artifact: \"verifier-report.md\", successCheck: \"Verify the fix\" } ],\n      server_context: nil\n    )\n\n    response = McpTools::WorkerTurnTool.call(\n      runId: run.run_id,\n      role: \"worker\",\n      nickname: \"worker-1\",\n      scope: \"fix-summary.md\",\n      result: \"Fix applied and ready for follow-up planning.\",\n      task: run.task,\n      server_context: nil\n    )\n\n    planner_request = run.spawn_requests.order(:created_at).last\n\n    expect(response.structured_content[:plannerRequest][:requestId]).to eq(planner_request.request_id)\n    expect(planner_request).to have_attributes(requested_role: \"planner\", scope: \"workflow-plan.md\")\n    expect(worker.reload.handoff_completed_at).to be_present\n  end\n\n  it \"rejects a diagnosis handoff without artifact-backed evidence citations\" do\n    run = create_run(\"mcp-diagnosis-evidence\")\n    worker = create_worker(run, role: \"worker\", nickname: \"worker-diagnosis\", scope: \"diagnosis.md\")\n    run.spawn_requests.create!(\n      asked_by: \"planner\", scope: \"diagnosis.md\",\n      text: \"Execution mode: diagnosis. Capture the POST and GET boundary.\",\n      requested_role: \"worker\", priority: \"blocking\", status: \"fulfilled\",\n      fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current, fulfilled_worker_id: worker.worker_id\n    )\n    Orchestrator::ArtifactStore.write(\n      run.target_root, run.run_id, \"diagnosis.md\",\n      \"Evidence: POST completed at 12:00:01Z; reproduction stopped before the GET request.\"\n    )\n\n    rejected = McpTools::WorkerTurnTool.call(\n      runId: run.run_id, role: \"worker\", nickname: worker.nickname, scope: worker.scope,\n      result: \"Diagnosis complete.\", task: run.task, server_context: nil\n    )\n    expect(rejected.error?).to be(true)\n    expect(rejected.content.first[:text]).to include(\"requires evidenceOutcome=confirmed or blocked\")\n\n    response = McpTools::WorkerTurnTool.call(\n      runId: run.run_id, role: \"worker\", nickname: worker.nickname, scope: worker.scope,\n      result: \"The target boundary was not reached.\", task: run.task,\n      evidenceOutcome: \"blocked\",\n      evidenceCitations: [ \"reproduction stopped before the GET request\" ],\n      server_context: nil\n    )\n\n    expect(response.structured_content[:plannerRequest][:requestId]).to be_present\n    expect(worker.reload.handoff_completed_at).to be_present\n  end\n\n  it \"returns the exact missing citation as an actionable tool error\" do\n    run = create_run(\"mcp-diagnosis-citation\")\n    worker = create_worker(run, role: \"worker\", nickname: \"worker-diagnosis\", scope: \"diagnosis.md\")\n    run.spawn_requests.create!(\n      asked_by: \"planner\", scope: worker.scope, text: \"Execution mode: diagnosis. Capture evidence.\",\n      requested_role: \"worker\", priority: \"blocking\", status: \"fulfilled\",\n      fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current, fulfilled_worker_id: worker.worker_id\n    )\n    Orchestrator::ArtifactStore.write(run.target_root, run.run_id, worker.scope, \"Exact artifact sentence.\")\n\n    response = McpTools::WorkerTurnTool.call(\n      runId: run.run_id, role: \"worker\", nickname: worker.nickname, scope: worker.scope,\n      result: \"[BLOCKED] Could not reproduce.\", task: run.task, evidenceOutcome: \"blocked\",\n      evidenceCitations: [ \"Paraphrased sentence.\" ], server_context: nil\n    )\n\n    expect(response.error?).to be(true)\n    expect(response.content.first[:text]).to include(\n      \"diagnosis evidenceCitation not found in diagnosis.md: Paraphrased sentence.\"\n    )\n    expect(BusEvent.where(run_id: run.run_id, event_type: \"worker.handoff_rejected\")).to exist\n  end\n\n  it \"turns a planner decision into completion state when nextStep is nil\" do\n    run = create_run(\"mcp-planner-turn\")\n\n    response = McpTools::PlannerTurnTool.call(\n      runId: run.run_id,\n      summary: \"All work is complete.\",\n      nextStep: nil,\n      followingSteps: [],\n      server_context: nil\n    )\n    latest_state = Orchestrator::TickState.latest(run.run_id)\n\n    expect(response.structured_content[:nextState][:phase]).to eq(\"completed\")\n    expect(latest_state[:phase]).to eq(\"completed\")\n  end\n\n  it \"keeps the run waiting_on_workers when planner_turn has no nextStep but a worker is still active\" do\n    run = create_run(\"mcp-planner-wait\")\n    run.workers.create!(\n      worker_id: SecureRandom.uuid,\n      role: \"worker\",\n      nickname: \"worker-1\",\n      reason: \"Still processing current step.\",\n      scope: \"fix-summary.md\",\n      status: \"running\",\n      pid: 123_456,\n      prompt_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.prompt.txt\"),\n      log_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.log\"),\n      last_message_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.last-message.txt\"),\n      env_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.env.json\"),\n      command: \"claude\",\n      args: []\n    )\n\n    response = McpTools::PlannerTurnTool.call(\n      runId: run.run_id,\n      summary: \"Do not spawn a duplicate worker; let the current one continue.\",\n      nextStep: nil,\n      followingSteps: [],\n      server_context: nil\n    )\n    latest_state = Orchestrator::TickState.latest(run.run_id)\n\n    expect(response.structured_content[:nextState][:phase]).to eq(\"waiting_on_workers\")\n    expect(latest_state[:phase]).to eq(\"waiting_on_workers\")\n  end\n\n  it \"completes when the planner submitting a nil nextStep is the only active worker\" do\n    run = create_run(\"mcp-planner-self\")\n    planner = create_worker(run, role: \"planner\", nickname: \"planner-1\", scope: \"workflow-plan.md\")\n\n    response = McpTools::PlannerTurnTool.call(\n      runId: run.run_id,\n      summary: \"No further work is required.\",\n      nextStep: nil,\n      followingSteps: [],\n      server_context: nil\n    )\n\n    expect(response.structured_content[:nextState][:phase]).to eq(\"completed\")\n    expect(Orchestrator::TickState.latest(run.run_id)[:phase]).to eq(\"completed\")\n    expect(planner.reload.handoff_completed_at).to be_present\n  end\n\n  it \"requeues a worker step when the previous fulfilled worker stopped, even if it wrote the artifact\" do\n    run = create_run(\"mcp-worker-requeue\")\n    stale_worker_id = SecureRandom.uuid\n    run.spawn_requests.create!(\n      asked_by: \"planner\",\n      scope: \"phone-recording-report.md\",\n      text: \"Record the phone demo again.\",\n      context: \"Previous worker died before finishing.\",\n      requested_role: \"worker\",\n      priority: \"blocking\",\n      status: \"fulfilled\",\n      fulfilled_by: \"tick_run_job\",\n      fulfilled_at: 2.minutes.ago,\n      fulfillment_note: \"Spawned worker-1 (worker).\",\n      fulfilled_worker_id: stale_worker_id\n    )\n    run.workers.create!(\n      worker_id: stale_worker_id,\n      role: \"worker\",\n      nickname: \"worker-1\",\n      reason: \"Old recording attempt.\",\n      scope: \"phone-recording-report.md\",\n      status: \"stopped\",\n      pid: 123_456,\n      stopped_at: 2.minutes.ago,\n      stop_reason: \"Process exited before writing its artifact.\",\n      prompt_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.prompt.txt\"),\n      log_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.log\"),\n      last_message_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.last-message.txt\"),\n      env_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"worker-1.env.json\"),\n      command: \"claude\",\n      args: []\n    )\n    Orchestrator::ArtifactStore.write(run.target_root, run.run_id, \"phone-recording-report.md\", \"Incomplete first attempt.\")\n\n    response = McpTools::PlannerTurnTool.call(\n      runId: run.run_id,\n      summary: \"Retry the same recording step because the first worker died before producing the artifact.\",\n      nextStep: {\n        owner: \"worker\",\n        artifact: \"phone-recording-report.md\",\n        successCheck: \"Write the recording report.\",\n        mode: \"recording\",\n        writeScope: \"source_protected\",\n        allowedPaths: [],\n        evidenceRefs: [ \"prior recording attempt\" ]\n      },\n      followingSteps: [],\n      server_context: nil\n    )\n\n    expect(response.structured_content[:jobs].size).to eq(1)\n    latest_request = run.spawn_requests.order(:created_at).last\n    expect(latest_request.request_id).not_to eq(run.spawn_requests.order(:created_at).first.request_id)\n    expect(latest_request).to have_attributes(status: \"open\", requested_role: \"worker\", scope: \"phone-recording-report.md\")\n  end\n\n  def create_run(suffix)\n    unique_suffix = \"#{suffix}-#{SecureRandom.hex(4)}\"\n    workspace = Workspace.create!(name: \"planner-#{unique_suffix}\", root_path: \"/tmp/planner-#{unique_suffix}\")\n    FileUtils.mkdir_p(File.join(workspace.root_path, \"front\", \"demo-output\", \"agents-sdk\"))\n    Run.create!(\n      run_id: \"demo-#{unique_suffix}\",\n      task: \"Exercise MCP workflow #{suffix}\",\n      workspace: workspace,\n      target_root: workspace.root_path,\n      launcher_variant: \"claude\",\n      status: \"running\",\n      launched_by: \"operator\",\n      started_at: Time.current\n    )\n  end\n\n  def create_worker(run, role:, nickname:, scope:)\n    run.workers.create!(\n      worker_id: SecureRandom.uuid,\n      role: role,\n      nickname: nickname,\n      reason: \"Test #{role} handoff.\",\n      scope: scope,\n      status: \"running\",\n      pid: 123_456,\n      prompt_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"#{nickname}.prompt.txt\"),\n      log_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"#{nickname}.log\"),\n      last_message_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"#{nickname}.last-message.txt\"),\n      env_path: File.join(run.target_root, \"front\", \"demo-output\", \"agents-sdk\", \"workers\", \"#{nickname}.env.json\"),\n      command: \"claude\",\n      args: []\n    )\n  end\nend\n","numLines":397,"startLine":1,"totalLines":397}}}
