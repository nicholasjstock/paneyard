{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011Uoj8HR8LwnYY3k447eZ2p","type":"tool_result","content":"1\trequire \"rails_helper\"\n2\t\n3\tRSpec.describe FinalizeRunPublicationJob do\n4\t  it \"opens exactly one blocking review question when the PR is published\" do\n5\t    workspace = Workspace.create!(name: \"finalize-publish-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n6\t    run = workspace.runs.create!(\n7\t      run_id: \"finalize-publish-#{SecureRandom.hex(4)}\", task: \"Finalize with a PR\", target_root: workspace.root_path,\n8\t      launcher_variant: \"codex\", status: \"running\", worktree_name: \"finalize-a1b2\", branch_name: \"workflow/finalize-a1b2\"\n9\t    )\n10\t    allow(Orchestrator::RunPublication).to receive(:publish!) do\n11\t      run.update!(pull_request_url: \"https://github.com/example/repo/pull/42\")\n12\t      :published\n13\t    end\n14\t\n15\t    FinalizeRunPublicationJob.perform_now(run.id)\n16\t\n17\t    expect(run.reload.status).to eq(\"completed\")\n18\t    question = run.user_questions.open_only.where(priority: \"blocking\").sole\n19\t    expect(question).to have_attributes(asked_by: \"orchestrator\", scope: \"pull_request_review\")\n20\t  end\n21\t\n22\t  it \"does not open a second review question on a retried finalization\" do\n23\t    workspace = Workspace.create!(name: \"finalize-retry-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n24\t    run = workspace.runs.create!(\n25\t      run_id: \"finalize-retry-#{SecureRandom.hex(4)}\", task: \"Finalize twice\", target_root: workspace.root_path,\n26\t      launcher_variant: \"codex\", status: \"running\", worktree_name: \"finalize-retry-a1b2\", branch_name: \"workflow/finalize-retry-a1b2\",\n27\t      pull_request_url: \"https://github.com/example/repo/pull/42\"\n28\t    )\n29\t    allow(Orchestrator::RunPublication).to receive(:publish!).and_return(:published)\n30\t\n31\t    FinalizeRunPublicationJob.perform_now(run.id)\n32\t    FinalizeRunPublicationJob.perform_now(run.id)\n33\t\n34\t    expect(run.user_questions.open_only.where(priority: \"blocking\").count).to eq(1)\n35\t  end\n36\t\n37\t  it \"does not open a review question when there were no source changes to publish\" do\n38\t    workspace = Workspace.create!(name: \"finalize-no-changes-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n39\t    run = workspace.runs.create!(\n40\t      run_id: \"finalize-no-changes-#{SecureRandom.hex(4)}\", task: \"Finalize with no changes\", target_root: workspace.root_path,\n41\t      launcher_variant: \"codex\", status: \"running\", worktree_name: \"finalize-no-changes-a1b2\", branch_name: \"workflow/finalize-no-changes-a1b2\"\n42\t    )\n43\t    allow(Orchestrator::RunPublication).to receive(:publish!).and_return(:no_changes)\n44\t\n45\t    FinalizeRunPublicationJob.perform_now(run.id)\n46\t\n47\t    expect(run.reload.status).to eq(\"completed\")\n48\t    expect(run.user_questions).to be_empty\n49\t  end\n50\tend\n51\t"}]},"parent_tool_use_id":null,"session_id":"8d2892c6-77f9-4067-a6e3-5a7da84f2051","uuid":"3e6f42bd-8403-4903-a7e9-030872999288","timestamp":"2026-07-24T21:03:20.097Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/spec/jobs/finalize_run_publication_job_spec.rb","content":"require \"rails_helper\"\n\nRSpec.describe FinalizeRunPublicationJob do\n  it \"opens exactly one blocking review question when the PR is published\" do\n    workspace = Workspace.create!(name: \"finalize-publish-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n    run = workspace.runs.create!(\n      run_id: \"finalize-publish-#{SecureRandom.hex(4)}\", task: \"Finalize with a PR\", target_root: workspace.root_path,\n      launcher_variant: \"codex\", status: \"running\", worktree_name: \"finalize-a1b2\", branch_name: \"workflow/finalize-a1b2\"\n    )\n    allow(Orchestrator::RunPublication).to receive(:publish!) do\n      run.update!(pull_request_url: \"https://github.com/example/repo/pull/42\")\n      :published\n    end\n\n    FinalizeRunPublicationJob.perform_now(run.id)\n\n    expect(run.reload.status).to eq(\"completed\")\n    question = run.user_questions.open_only.where(priority: \"blocking\").sole\n    expect(question).to have_attributes(asked_by: \"orchestrator\", scope: \"pull_request_review\")\n  end\n\n  it \"does not open a second review question on a retried finalization\" do\n    workspace = Workspace.create!(name: \"finalize-retry-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n    run = workspace.runs.create!(\n      run_id: \"finalize-retry-#{SecureRandom.hex(4)}\", task: \"Finalize twice\", target_root: workspace.root_path,\n      launcher_variant: \"codex\", status: \"running\", worktree_name: \"finalize-retry-a1b2\", branch_name: \"workflow/finalize-retry-a1b2\",\n      pull_request_url: \"https://github.com/example/repo/pull/42\"\n    )\n    allow(Orchestrator::RunPublication).to receive(:publish!).and_return(:published)\n\n    FinalizeRunPublicationJob.perform_now(run.id)\n    FinalizeRunPublicationJob.perform_now(run.id)\n\n    expect(run.user_questions.open_only.where(priority: \"blocking\").count).to eq(1)\n  end\n\n  it \"does not open a review question when there were no source changes to publish\" do\n    workspace = Workspace.create!(name: \"finalize-no-changes-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n    run = workspace.runs.create!(\n      run_id: \"finalize-no-changes-#{SecureRandom.hex(4)}\", task: \"Finalize with no changes\", target_root: workspace.root_path,\n      launcher_variant: \"codex\", status: \"running\", worktree_name: \"finalize-no-changes-a1b2\", branch_name: \"workflow/finalize-no-changes-a1b2\"\n    )\n    allow(Orchestrator::RunPublication).to receive(:publish!).and_return(:no_changes)\n\n    FinalizeRunPublicationJob.perform_now(run.id)\n\n    expect(run.reload.status).to eq(\"completed\")\n    expect(run.user_questions).to be_empty\n  end\nend\n","numLines":51,"startLine":1,"totalLines":51}}}
