{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fp4ycBNz9nboJSiNCXWa9A","type":"tool_result","content":"1\trequire \"rails_helper\"\n2\t\n3\tRSpec.describe Orchestrator::RunPublication do\n4\t  it \"commits source changes but keeps runtime artifacts and the PR summary out of Git\" do\n5\t    root = Dir.mktmpdir\n6\t    git(root, \"init\")\n7\t    git(root, \"config\", \"user.name\", \"Workflow Orchestrator\")\n8\t    git(root, \"config\", \"user.email\", \"workflow@example.test\")\n9\t    File.write(File.join(root, \"existing.txt\"), \"before\\n\")\n10\t    git(root, \"add\", \"existing.txt\")\n11\t    git(root, \"commit\", \"-m\", \"Initial commit\")\n12\t    workspace = Workspace.create!(name: \"publication-#{SecureRandom.hex(4)}\", root_path: root)\n13\t    run = workspace.runs.create!(\n14\t      run_id: \"publication-#{SecureRandom.hex(4)}\", task: \"Publish nothing\", target_root: root,\n15\t      launcher_variant: \"codex\", status: \"running\", worktree_name: \"publish-nothing-a1b2\",\n16\t      branch_name: \"workflow/publish-nothing-a1b2\"\n17\t    )\n18\t    File.write(File.join(root, \"existing.txt\"), \"after\\n\")\n19\t    Orchestrator::ArtifactStore.write(root, run.run_id, \"run-summary.md\", \"## Result\\n\\nSource change verified.\")\n20\t    Orchestrator::ArtifactStore.write(root, run.run_id, \"worker.log\", \"sensitive runtime output\")\n21\t\n22\t    expect(described_class.commit_all!(run)).to eq(:committed)\n23\t    expect(git(root, \"show\", \"--format=\", \"--name-only\", \"HEAD\")).to include(\"existing.txt\")\n24\t    expect(git(root, \"ls-files\")).not_to include(\".workflow-orchestrator\")\n25\t    expect(git(root, \"status\", \"--porcelain\")).to include(\".workflow-orchestrator/\")\n26\t  ensure\n27\t    FileUtils.remove_entry(root) if root && File.exist?(root)\n28\t  end\n29\t\n30\t  it \"refuses to publish from the source checkout\" do\n31\t    root = Dir.mktmpdir\n32\t    workspace = Workspace.create!(name: \"publication-source-#{SecureRandom.hex(4)}\", root_path: root)\n33\t    run = workspace.runs.create!(\n34\t      run_id: \"publication-source-#{SecureRandom.hex(4)}\", task: \"Do not publish source\", target_root: root,\n35\t      launcher_variant: \"codex\", status: \"running\", worktree_name: \"source-a1b2\", source_root: root,\n36\t      branch_name: \"workflow/source-a1b2\"\n37\t    )\n38\t\n39\t    expect { described_class.publish!(run) }.to raise_error(Orchestrator::RunPublication::Error, /source checkout/)\n40\t    expect(run.reload.publication_status).to eq(\"failed\")\n41\t  ensure\n42\t    FileUtils.remove_entry(root) if root && File.exist?(root)\n43\t  end\n44\t\n45\t  it \"posts each question as a marked PR comment\" do\n46\t    root = Dir.mktmpdir\n47\t    workspace = Workspace.create!(name: \"question-publication-#{SecureRandom.hex(4)}\", root_path: root)\n48\t    run = workspace.runs.create!(\n49\t      run_id: \"question-publication-#{SecureRandom.hex(4)}\", task: \"Ask on GitHub\", target_root: root,\n50\t      launcher_variant: \"codex\", status: \"running\", worktree_name: \"question-publication-a1b2\",\n51\t      branch_name: \"workflow/question-publication-a1b2\"\n52\t    )\n53\t    question = UserQuestion.create!(run_id: run.run_id, asked_by: \"worker\", scope: \"config\", text: \"Choose a setting?\", priority: \"blocking\")\n54\t    allow(described_class).to receive(:ensure_conversation_pr!).and_return(\"https://github.com/example/repo/pull/42\")\n55\t    allow(described_class).to receive(:validated_root!).and_return(Pathname(root))\n56\t    status = instance_double(Process::Status, success?: true)\n57\t    allow(Open3).to receive(:capture3).and_return([ { id: 123, html_url: \"https://github.com/example/repo/pull/42#issuecomment-123\" }.to_json, \"\", status ])\n58\t\n59\t    expect(described_class.publish_question!(question)).to eq(:published)\n60\t    expect(question.reload).to have_attributes(\n61\t      github_comment_id: \"123\", github_