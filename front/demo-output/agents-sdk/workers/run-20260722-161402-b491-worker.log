     1	module ApplicationHelper
     2	end
     1	module RunsHelper
     2	  def planner_decision_trigger(decision)
     3	    request = decision.spawn_request
     4	    return "Initial launch" if request.tags.include?("launch")
     5	    return "Recovery request" if request.tags.any? { |tag| tag.match?(/recover|stalled|dead-end/) }
     6	
     7	    "#{request.asked_by} handoff"
     8	  end
     9	
    10	  def planner_decision_route(decision)
    11	    return "Failed before a decision" if decision.status == "failed"
    12	    return "Waiting for chaperone" if decision.status == "awaiting_chaperone"
    13	
    14	    step = decision.decision&.dig("next_step")
    15	    return "Run completion" if decision.status == "completed" && step.blank?
    16	    return "Decision pending" if step.blank?
    17	
    18	    [ step["owner"], step["artifact"] ].compact.join(" → ")
    19	  end
    20	
    21	  def planner_decision_models(decision)
    22	    models = decision.attempts.map do |attempt|
    23	      [ attempt.model_tier, attempt.model ].compact.join(": ")
    24	    end
    25	    models = decision.model_attempts.map { |attempt| [ attempt["tier"], attempt["model"] ].compact.join(": ") } if models.empty?
    26	    models.reject(&:blank?).join(" → ").presence || "no model call"
    27	  end
    28	
    29	  def planner_decision_duration(decision)
    30	    return "not started" unless decision.started_at
    31	
    32	    distance_of_time_in_words(decision.started_at, decision.completed_at || Time.current)
    33	  end
    34	
    35	  def planner_step_title(step)
    36	    [ step["owner"], step["artifact"] ].compact.join(" → ").presence || "No worker step"
    37	  end
    38	
    39	  def planner_decision_error_summary(decision)
    40	    error = decision.error.to_s
    41	    json_start = error.index("{")
    42	    if json_start
    43	      payload = JSON.parse(error[json_start..])
    44	      return payload["result"] if payload["result"].present?
    45	    end
    46	
    47	    error.truncate(240)
    48	  rescue JSON::ParserError
    49	    error.truncate(240)
    50	  end
    51	end

