{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K5tq6aVyCLtisHkKbF39UP","type":"tool_result","content":"1\tmodule Orchestrator\n2\t  # Ports scripts/worker-turn.ts and scripts/planner-turn.ts. Snake_case throughout -- camelizing for the\n3\t  # wire only happens at each MCP tool's McpTools::ToolResponse.structured\n4\t  # call (see Orchestrator::TickState for the DB read/write boundary).\n5\t  module Turn\n6\t    module_function\n7\t\n8\t    PLANNER_FOLLOWUP_SCOPE = \"workflow-plan.md\"\n9\t\n10\t    # task is part of the MCP tool's input schema for API-surface\n11\t    # consistency with the other turn tools, but -- matching\n12\t    # scripts/worker-turn.ts exactly -- is never actually read here.\n13\t    def run_worker_turn(run_id:, role:, nickname:, scope:, result:, evidence_outcome: nil, evidence_citations: [], diagnosis_findings: nil, now: Time.current, previous_state: nil)\n14\t      DiagnosisEvidenceGate.validate!(run_id:, nickname:, scope:, evidence_outcome:, evidence_citations:)\n15\t      StructuredDiagnosisFindings.persist!(run_id:, nickname:, scope:, findings: diagnosis_findings) if diagnosis_findings.present?\n16\t      following_steps = previous_state&.dig(:following_steps) || []\n17\t      active_worker_ids = Worker.where(run_id: run_id, status: \"running\").pluck(:worker_id).to_set\n18\t\n19\t      if (review = record_step_attempt(run_id:, nickname:, result:, evidence_outcome:, evidence_citations:))\n20\t        next_state = (previous_state || TickState.default_state(run_id)).merge(\n21\t          phase: \"planning\", last_plan_summary: \"Strong chaperone is reviewing repeated worker failures.\",\n22\t          last_updated_at: now.utc.iso8601(3)\n23\t        )\n24\t        return { planner_request: nil, chaperone_review: { review_id: review.review_id }, next_state: next_state }\n25\t      end\n26\t\n27\t      run = Run.find_by!(run_id: run_id)\n28\t      active_branch_open = run.active_branch_key.present? && !AcceptanceCriteria.branch_resolved?(run:, branch_key: run.active_branch_key)\n29\t\n30\t      # A completed node may only promote its next sibling after the current\n31\t      # acceptance branch is resolved. Otherwise the planner must insert the\n32\t      # next child of this branch (for example, measure -> repair -> verify)\n33\t      # ahead of later verifier siblings.\n34\t      if completed_result?(result) && following_steps.any? && !active_branch_open\n35\t        next_step, *remaining_steps = following_steps\n36\t        summary = \"#{nickname} completed #{scope}. Rails promoted the next previously planned step without another planner call.\"\n37\t        promoted = run_planner_turn(\n38\t          run_id:, summary:, next_step:, following_steps: remaining_steps, now:, previous_state:\n39\t        )\n40\t        return promoted.merge(planner_request: nil, promoted_preplanned_step: true)\n41\t      end\n42\t\n43\t      # A follow-up planner request is a repeatable recovery ask, not a\n44\t      # one-time artifact -- an 'open' request is safe to reuse\n45\t      # unconditionally, but a 'fulfilled' one only still represents\n46\t      # \"already being handled\" while the planner it spawned is still\n47\t      # active.\n48\t      existing_request = SpawnRequest\n49\t        .where(run_id: run_id, requested_role: \"planner\", scope: PLANNER_FOLLOWUP_SCOPE)\n50\t        .where.not(status: \"dismissed\")\n51\t        .detect do |request|\n52\t          request.status == \"open\" ||\n53\t            (request.fulfilled_worker_id.present? && active_worker_ids.include?(request.fulfilled_worker_id)) ||\n54\t            PlannerDecision.active.exists?(spawn_request_id: request.request_id)\n55\t        end\n56\t\n57\t      planner_request = existing_request || SpawnRequest.create!(\n58\t        run_id: run_id,\n59\t        asked_by: \"worker\",\n60\t        scope: PLANNER_FOLLOWUP_SCOPE,\n61\t        text: \"Decide the next nextStep (usually the head of followingSteps, but reconsider it against the reported \" \\\n62\t          \"result) and the new followingSteps, then publish them with planner_turn. If blocked on a user decision, \" \\\n63\t          \"call append_user_question.\",\n64\t        context: [\n65\t          \"Worker #{nickname} (role #{role}) reported this result for run #{run_id}, scope #{scope}: #{result}\",\n66\t          (evidence_outcome.present? ? \"Evidence outcome: #{evidence_outcome}; citations: #{Array(evidence_citations).join(', ')}.\" : nil),\n67\t          \"Current followingSteps queue (JSON, decided by the previous planner_turn call): #{following_steps.to_json}\"\n68\t        ].compact.join(\" \"),\n69\t        requested_role: \"planner\",\n70\t        priority: \"blocking\",\n71\t        tags: [ \"planner\", PLANNER_FOLLOWUP_SCOPE, \"worker-turn-followup\", (\"evidence-#{evidence_outcome}\" if evidence_outcome.present?) ].compact\n72\t      )\n73\t\n74\t      # phase/tick_count/last_plan_summary/last_stall_finding/following_steps\n75\t      # are all owned by planner_turn and orchestrator-turn's stall\n76\t      # detection -- worker_turn only requests the follow-up planner and\n77\t      # reports what it saw, so it carries all of this forward untouched.\n78\t      next_state = {\n79\t        run_id: run_id,\n80\t        phase: previous_state&.dig(:phase) || \"starting\",\n81\t        tick_count: previous_state&.dig(:tick_count) || 0,\n82\t        last_stall_finding: previous_state&.dig(:last_stall_finding),\n83\t        last_plan_summary: previous_state&.dig(:last_plan_summary),\n84\t        pending_spawn_keys: previous_state&.dig(:pending_spawn_keys) || [],\n85\t        following_steps: following_steps,\n86\t        last_updated_at: now.utc.iso8601(3)\n87\t      }\n88\t\n89\t      { planner_request: { request_id: planner_request.request_id }, next_state: next_state }\n90\t    end\n91\t\n92\t    def completed_result?(result)\n93\t      result.to_s.match?(/\\A\\s*\\[DONE\\]/i)\n94\t    end\n95\t    private_class_method :completed_result?\n96\t\n97\t    # Covers every execution mode, not only diagnosis -- a worker that\n98\t    # correctly reports [BLOCKED]/[FAILED] via worker_turn must be exactly\n99\t    # as visible to ChaperoneTrigger as one whose process dies outright\n100\t    # (see WorkerReconcileJob#record_failed_attempt, which was already\n101\t    # mode-agnostic). Diagnosis alone keeps its stricter done/evidence\n102\t    # coupling -- see step_attempt_outcome.\n103\t    def record_step_attempt(run_id:, nickname:, result:, evidence_outcome:, evidence_citations:)\n104\t      worker = Worker.where(run_id:, nickname:).order(created_at: :desc).first\n105\t      request = worker && SpawnRequest.find_by(fulfilled_worker_id: worker.worker_id)\n106\t      return unless request\n107\t\n108\t      mode = SpawnRequestedWorkers.execution_mode(request).presence || \"unknown\"\n109\t      outcome = step_attempt_outcome(result:, evidence_outcome:, mode:)\n110\t      lineage_key = request.lineage_key.presence || request.scope\n111\t      attempt = StepAttempt.create!(\n112\t        run_id:, spawn_request: request, worker_id: worker.worker_id, lineage_key:, mode:,\n113\t        outcome:, result:, evidence_outcome:, evidence_citations:\n114\t      )\n115\t      return unless outcome.in?(%w[blocked failed])\n116\t\n117\t      ChaperoneTrigger.call(attempt)\n118\t    end\n119\t    private_class_method :record_step_attempt\n120\t\n121\t    # Diagnosis requires evidenceOutcome=confirmed before a [DONE] report\n122\t    # counts as actually done -- DiagnosisEvidenceGate already enforces the\n123\t    # citation discipline behind that claim. Other modes have no such\n124\t    # evidence contract, so a bare [DONE] is trusted at face value there.\n125\t    def step_attempt_outcome(result:, evidence_outcome:, mode:)\n126\t      done = result.to_s.match?(/\\A\\s*\\[DONE\\]/i)\n127\t      return \"done\" if done && (mode != \"diagnosis\" || evidence_outcome == \"confirmed\")\n128\t      return \"failed\" if result.to_s.match?(/\\A\\s*\\[FAILED\\]/i)\n129\t\n130\t      \"blocked\"\n131\t    end\n132\t    private_class_method :step_attempt_outcome\n133\t\n134\t    def run_planner_turn(run_id:, summary:, next_step:, following_steps:, now: Time.current, previous_state: nil)\n135\t      StepPolicy.validate_plan!(run_id:, next_step:, following_steps:)\n136\t      # Single source of truth for \"next_step became the active step, so\n137\t      # record which criteria it addresses\" -- covers both a live planner\n138\t      # decision and Rails auto-promoting a previously queued followingSteps\n139\t      # item after a [DONE] result (see run_worker_turn) without a second\n140\t      # planner call. Only the former used to call this, which silently\n141\t      # dropped the addressesCriteria the planner already attached to every\n142\t      # followingSteps item, leaving auto-promoted steps invisible to\n143\t      # AcceptanceCriteriaWorkers and to ChaperoneTrigger's criterion join.\n144\t      run = Run.find_by!(run_id: run_id)\n145\t      enforce_branch_progression!(run:, next_step:)\n146\t      Orchestrator::AcceptanceCriteria.record_step!(run:, next_step: next_step)\n147\t      planner_blockers = Orchestrator::AcceptanceCriteria.planner_blockers(run_id: run_id)\n148\t      if next_step.nil? && planner_blockers.any?\n149\t        raise ArgumentError, \"Cannot complete run while acceptance criteria remain pending: #{planner_blockers.join(', ')}\"\n150\t      end\n151\t\n152\t      # An open blocking question means the run is waiting on the user, not\n153\t      # the planner -- publishing new jobs here would dispatch workers behind\n154\t      # a UI that still reads \"awaiting_user_feedback\", so no new work may be queued\n155\t      # until the question is answered.\n156\t      has_open_blocking_question = UserQuestion.exists?(run_id: run_id, status: \"open\", priority: \"blocking\")\n157\t      jobs =\n158\t        if has_open_blocking_question\n159\t          []\n160\t        else\n161\t          Planner.publish_planner_jobs(\n162\t            run_id: run_id,\n163\t            summary: summary,\n164\t            plan: { summary: summary, next_step: next_step, following_steps: following_steps }\n165\t          )\n166\t        end\n167\t      # The planner that is submitting this decision remains registered as\n168\t      # running until its CLI process exits. It is not work that should keep\n169\t      # the run alive after a nil next_step, otherwise every completed planner\n170\t      # turn becomes waiting_on_workers and the stall recovery loop restarts.\n171\t      active_executor_exists = Worker.where(run_id: run_id, status: \"running\").where.not(role: \"planner\").exists?\n172\t      # A criterion can be unresolved (ready_for_verification) with no\n173\t      # active_executor yet -- the verifier SpawnRequest this same update\n174\t      # just created hasn't been dispatched by SpawnRequestedWorkers yet.\n175\t      # The run must not read \"completed\" in that gap.\n176\t      unresolved_criteria_exist = Orchestrator::AcceptanceCriteria.completion_blockers(run_id: run_id).any?\n177\t      completion_phase =\n178\t        if has_open_blocking_question\n179\t          \"awaiting_user_feedback\"\n180\t        elsif next_step\n181\t          \"planning\"\n182\t        elsif active_executor_exists || unresolved_criteria_exist\n183\t          \"waiting_on_workers\"\n184\t        else\n185\t          \"completed\"\n186\t        end\n187\t\n188\t      next_state = {\n189\t        run_id: run_id,\n190\t        # next_step: nil only means \"completed\" when nothing is still in\n191\t        # flight. A recovery planner can legitimately publish no new\n192\t        # immediate handoff because an existing worker should continue\n193\t        # uninterrupted; in that case the run must stay\n194\t        # waiting_on_workers rather than flipping completed.\n195\t        phase: completion_phase,\n196\t        tick_count: (previous_state&.dig(:tick_count) || 0) + 1,\n197\t        last_plan_summary: summary,\n198\t        pending_spawn_keys: ((previous_state&.dig(:pending_spawn_keys) || []) + Planner.build_pending_spawn_keys(run_id: run_id, jobs: jobs)).uniq,\n199\t        following_steps: following_steps,\n200\t        last_stall_finding: previous_state&.dig(:last_stall_finding),\n201\t        last_updated_at: now.utc.iso8601(3)\n202\t      }\n203\t\n204\t      { jobs: jobs, next_state: next_state }\n205\t    end\n206\t\n207\t    def enforce_branch_progression!(run:, next_step:)\n208\t      return unless next_step\n209\t\n210\t      branch_key = AcceptanceCriteria.branch_key_for_step(run:, step: next_step)\n211\t      return unless branch_key\n212\t\n213\t      active_key = run.active_branch_key\n214\t      if active_key.present? && !AcceptanceCriteria.branch_resolved?(run:, branch_key: active_key) && branch_key != active_key\n215\t        raise ArgumentError, \"Cannot leave active acceptance branch #{active_key} before it resolves\"\n216\t      end\n217\t\n218\t      run.update!(active_branch_key: branch_key) if active_key != branch_key\n219\t    end\n220\t    private_class_method :enforce_branch_progression!\n221\t\n222\t    # A run can go dead without ever looking \"stalled\": a worker stops\n223\t    # (crash, or a clean exit whose worker_turn call never landed) without\n224\t    # producing a follow-up spawn request.\n225\t    def build_dead_end_finding(run_id:, following_steps:)\n226\t      [\n227\t        \"Run #{run_id} has no active workers and no open spawn requests, but was not marked completed.\",\n228\t        \"following_steps queue at last check: #{following_steps.to_json}\",\n229\t        \"The most recent worker likely stopped without completing its worker_turn handoff (crashed, or the call \" \\\n230\t          \"failed) -- inspect its last known report/artifact and decide whether to retry, fix, or escalate to the user.\"\n231\t      ].join(\" \")\n232\t    end\n233\t    public :build_dead_end_finding\n234\t  end\n235\tend\n236\t"}]},"parent_tool_use_id":null,"session_id":"aaf0b806-53bd-4d56-9d82-b0a910e3601e","uuid":"473ac86a-f510-4c6d-abf0-0fcd95836efa","timestamp":"2026-07-24T16:02:03.252Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/services/orchestrator/turn.rb","content":"module Orchestrator\n  # Ports scripts/worker-turn.ts and scripts/planner-turn.ts. Snake_case throughout -- camelizing for the\n  # wire only happens at each MCP tool's McpTools::ToolResponse.structured\n  # call (see Orchestrator::TickState for the DB read/write boundary).\n  module Turn\n    module_function\n\n    PLANNER_FOLLOWUP_SCOPE = \"workflow-plan.md\"\n\n    # task is part of the MCP tool's input schema for API-surface\n    # consistency with the other turn tools, but -- matching\n    # scripts/worker-turn.ts exactly -- is never actually read here.\n    def run_worker_turn(run_id:, role:, nickname:, scope:, result:, evidence_outcome: nil, evidence_citations: [], diagnosis_findings: nil, now: Time.current, previous_state: nil)\n      DiagnosisEvidenceGate.validate!(run_id:, nickname:, scope:, evidence_outcome:, evidence_citations:)\n      StructuredDiagnosisFindings.persist!(run_id:, nickname:, scope:, findings: diagnosis_findings) if diagnosis_findings.present?\n      following_steps = previous_state&.dig(:following_steps) || []\n      active_worker_ids = Worker.where(run_id: run_id, status: \"running\").pluck(:worker_id).to_set\n\n      if (review = record_step_attempt(run_id:, nickname:, result:, evidence_outcome:, evidence_citations:))\n        next_state = (previous_state || TickState.default_state(run_id)).merge(\n          phase: \"planning\", last_plan_summary: \"Strong chaperone is reviewing repeated worker failures.\",\n          last_updated_at: now.utc.iso8601(3)\n        )\n        return { planner_request: nil, chaperone_review: { review_id: review.review_id }, next_state: next_state }\n      end\n\n      run = Run.find_by!(run_id: run_id)\n      active_branch_open = run.active_branch_key.present? && !AcceptanceCriteria.branch_resolved?(run:, branch_key: run.active_branch_key)\n\n      # A completed node may only promote its next sibling after the current\n      # acceptance branch is resolved. Otherwise the planner must insert the\n      # next child of this branch (for example, measure -> repair -> verify)\n      # ahead of later verifier siblings.\n      if completed_result?(result) && following_steps.any? && !active_branch_open\n        next_step, *remaining_steps = following_steps\n        summary = \"#{nickname} completed #{scope}. Rails promoted the next previously planned step without another planner call.\"\n        promoted = run_planner_turn(\n          run_id:, summary:, next_step:, following_steps: remaining_steps, now:, previous_state:\n        )\n        return promoted.merge(planner_request: nil, promoted_preplanned_step: true)\n      end\n\n      # A follow-up planner request is a repeatable recovery ask, not a\n      # one-time artifact -- an 'open' request is safe to reuse\n      # unconditionally, but a 'fulfilled' one only still represents\n      # \"already being handled\" while the planner it spawned is still\n      # active.\n      existing_request = SpawnRequest\n        .where(run_id: run_id, requested_role: \"planner\", scope: PLANNER_FOLLOWUP_SCOPE)\n        .where.not(status: \"dismissed\")\n        .detect do |request|\n          request.status == \"open\" ||\n            (request.fulfilled_worker_id.present? && active_worker_ids.include?(request.fulfilled_worker_id)) ||\n            PlannerDecision.active.exists?(spawn_request_id: request.request_id)\n        end\n\n      planner_request = existing_request || SpawnRequest.create!(\n        run_id: run_id,\n        asked_by: \"worker\",\n        scope: PLANNER_FOLLOWUP_SCOPE,\n        text: \"Decide the next nextStep (usually the head of followingSteps, but reconsider it against the reported \" \\\n          \"result) and the new followingSteps, then publish them with planner_turn. If blocked on a user decision, \" \\\n          \"call append_user_question.\",\n        context: [\n          \"Worker #{nickname} (role #{role}) reported this result for run #{run_id}, scope #{scope}: #{result}\",\n          (evidence_outcome.present? ? \"Evidence outcome: #{evidence_outcome}; citations: #{Array(evidence_citations).join(', ')}.\" : nil),\n          \"Current followingSteps queue (JSON, decided by the previous planner_turn call): #{following_steps.to_json}\"\n        ].compact.join(\" \"),\n        requested_role: \"planner\",\n        priority: \"blocking\",\n        tags: [ \"planner\", PLANNER_FOLLOWUP_SCOPE, \"worker-turn-followup\", (\"evidence-#{evidence_outcome}\" if evidence_outcome.present?) ].compact\n      )\n\n      # phase/tick_count/last_plan_summary/last_stall_finding/following_steps\n      # are all owned by planner_turn and orchestrator-turn's stall\n      # detection -- worker_turn only requests the follow-up planner and\n      # reports what it saw, so it carries all of this forward untouched.\n      next_state = {\n        run_id: run_id,\n        phase: previous_state&.dig(:phase) || \"starting\",\n        tick_count: previous_state&.dig(:tick_count) || 0,\n        last_stall_finding: previous_state&.dig(:last_stall_finding),\n        last_plan_summary: previous_state&.dig(:last_plan_summary),\n        pending_spawn_keys: previous_state&.dig(:pending_spawn_keys) || [],\n        following_steps: following_steps,\n        last_updated_at: now.utc.iso8601(3)\n      }\n\n      { planner_request: { request_id: planner_request.request_id }, next_state: next_state }\n    end\n\n    def completed_result?(result)\n      result.to_s.match?(/\\A\\s*\\[DONE\\]/i)\n    end\n    private_class_method :completed_result?\n\n    # Covers every execution mode, not only diagnosis -- a worker that\n    # correctly reports [BLOCKED]/[FAILED] via worker_turn must be exactly\n    # as visible to ChaperoneTrigger as one whose process dies outright\n    # (see WorkerReconcileJob#record_failed_attempt, which was already\n    # mode-agnostic). Diagnosis alone keeps its stricter done/evidence\n    # coupling -- see step_attempt_outcome.\n    def record_step_attempt(run_id:, nickname:, result:, evidence_outcome:, evidence_citations:)\n      worker = Worker.where(run_id:, nickname:).order(created_at: :desc).first\n      request = worker && SpawnRequest.find_by(fulfilled_worker_id: worker.worker_id)\n      return unless request\n\n      mode = SpawnRequestedWorkers.execution_mode(request).presence || \"unknown\"\n      outcome = step_attempt_outcome(result:, evidence_outcome:, mode:)\n      lineage_key = request.lineage_key.presence || request.scope\n      attempt = StepAttempt.create!(\n        run_id:, spawn_request: request, worker_id: worker.worker_id, lineage_key:, mode:,\n        outcome:, result:, evidence_outcome:, evidence_citations:\n      )\n      return unless outcome.in?(%w[blocked failed])\n\n      ChaperoneTrigger.call(attempt)\n    end\n    private_class_method :record_step_attempt\n\n    # Diagnosis requires evidenceOutcome=confirmed before a [DONE] report\n    # counts as actually done -- DiagnosisEvidenceGate already enforces the\n    # citation discipline behind that claim. Other modes have no such\n    # evidence contract, so a bare [DONE] is trusted at face value there.\n    def step_attempt_outcome(result:, evidence_outcome:, mode:)\n      done = result.to_s.match?(/\\A\\s*\\[DONE\\]/i)\n      return \"done\" if done && (mode != \"diagnosis\" || evidence_outcome == \"confirmed\")\n      return \"failed\" if result.to_s.match?(/\\A\\s*\\[FAILED\\]/i)\n\n      \"blocked\"\n    end\n    private_class_method :step_attempt_outcome\n\n    def run_planner_turn(run_id:, summary:, next_step:, following_steps:, now: Time.current, previous_state: nil)\n      StepPolicy.validate_plan!(run_id:, next_step:, following_steps:)\n      # Single source of truth for \"next_step became the active step, so\n      # record which criteria it addresses\" -- covers both a live planner\n      # decision and Rails auto-promoting a previously queued followingSteps\n      # item after a [DONE] result (see run_worker_turn) without a second\n      # planner call. Only the former used to call this, which silently\n      # dropped the addressesCriteria the planner already attached to every\n      # followingSteps item, leaving auto-promoted steps invisible to\n      # AcceptanceCriteriaWorkers and to ChaperoneTrigger's criterion join.\n      run = Run.find_by!(run_id: run_id)\n      enforce_branch_progression!(run:, next_step:)\n      Orchestrator::AcceptanceCriteria.record_step!(run:, next_step: next_step)\n      planner_blockers = Orchestrator::AcceptanceCriteria.planner_blockers(run_id: run_id)\n      if next_step.nil? && planner_blockers.any?\n        raise ArgumentError, \"Cannot complete run while acceptance criteria remain pending: #{planner_blockers.join(', ')}\"\n      end\n\n      # An open blocking question means the run is waiting on the user, not\n      # the planner -- publishing new jobs here would dispatch workers behind\n      # a UI that still reads \"awaiting_user_feedback\", so no new work may be queued\n      # until the question is answered.\n      has_open_blocking_question = UserQuestion.exists?(run_id: run_id, status: \"open\", priority: \"blocking\")\n      jobs =\n        if has_open_blocking_question\n          []\n        else\n          Planner.publish_planner_jobs(\n            run_id: run_id,\n            summary: summary,\n            plan: { summary: summary, next_step: next_step, following_steps: following_steps }\n          )\n        end\n      # The planner that is submitting this decision remains registered as\n      # running until its CLI process exits. It is not work that should keep\n      # the run alive after a nil next_step, otherwise every completed planner\n      # turn becomes waiting_on_workers and the stall recovery loop restarts.\n      active_executor_exists = Worker.where(run_id: run_id, status: \"running\").where.not(role: \"planner\").exists?\n      # A criterion can be unresolved (ready_for_verification) with no\n      # active_executor yet -- the verifier SpawnRequest this same update\n      # just created hasn't been dispatched by SpawnRequestedWorkers yet.\n      # The run must not read \"completed\" in that gap.\n      unresolved_criteria_exist = Orchestrator::AcceptanceCriteria.completion_blockers(run_id: run_id).any?\n      completion_phase =\n        if has_open_blocking_question\n          \"awaiting_user_feedback\"\n        elsif next_step\n          \"planning\"\n        elsif active_executor_exists || unresolved_criteria_exist\n          \"waiting_on_workers\"\n        else\n          \"completed\"\n        end\n\n      next_state = {\n        run_id: run_id,\n        # next_step: nil only means \"completed\" when nothing is still in\n        # flight. A recovery planner can legitimately publish no new\n        # immediate handoff because an existing worker should continue\n        # uninterrupted; in that case the run must stay\n        # waiting_on_workers rather than flipping completed.\n        phase: completion_phase,\n        tick_count: (previous_state&.dig(:tick_count) || 0) + 1,\n        last_plan_summary: summary,\n        pending_spawn_keys: ((previous_state&.dig(:pending_spawn_keys) || []) + Planner.build_pending_spawn_keys(run_id: run_id, jobs: jobs)).uniq,\n        following_steps: following_steps,\n        last_stall_finding: previous_state&.dig(:last_stall_finding),\n        last_updated_at: now.utc.iso8601(3)\n      }\n\n      { jobs: jobs, next_state: next_state }\n    end\n\n    def enforce_branch_progression!(run:, next_step:)\n      return unless next_step\n\n      branch_key = AcceptanceCriteria.branch_key_for_step(run:, step: next_step)\n      return unless branch_key\n\n      active_key = run.active_branch_key\n      if active_key.present? && !AcceptanceCriteria.branch_resolved?(run:, branch_key: active_key) && branch_key != active_key\n        raise ArgumentError, \"Cannot leave active acceptance branch #{active_key} before it resolves\"\n      end\n\n      run.update!(active_branch_key: branch_key) if active_key != branch_key\n    end\n    private_class_method :enforce_branch_progression!\n\n    # A run can go dead without ever looking \"stalled\": a worker stops\n    # (crash, or a clean exit whose worker_turn call never landed) without\n    # producing a follow-up spawn request.\n    def build_dead_end_finding(run_id:, following_steps:)\n      [\n        \"Run #{run_id} has no active workers and no open spawn requests, but was not marked completed.\",\n        \"following_steps queue at last check: #{following_steps.to_json}\",\n        \"The most recent worker likely stopped without completing its worker_turn handoff (crashed, or the call \" \\\n          \"failed) -- inspect its last known report/artifact and decide whether to retry, fix, or escalate to the user.\"\n      ].join(\" \")\n    end\n    public :build_dead_end_finding\n  end\nend\n","numLines":236,"startLine":1,"totalLines":236}}}
