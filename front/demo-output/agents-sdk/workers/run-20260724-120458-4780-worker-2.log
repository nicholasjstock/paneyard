{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P9F41tEXBk53cB9aqg6LA5","type":"tool_result","content":"1\trequire \"digest\"\n2\t\n3\t# Replaces WorkflowWorkerRecord (workflow-worker-runtime.ts) as the source\n4\t# of truth for the worker registry. Wire format (#as_json) mirrors that TS\n5\t# type field-for-field.\n6\t#\n7\t# Unlike SpawnRequest/UserQuestion/BusEvent, worker_id is NOT\n8\t# server-generated: supervisor-loop.ts pre-generates it so it can claim a\n9\t# spawn request's fulfilledWorkerId *before* the worker actually exists\n10\t# (deliberate race-avoidance -- see supervisor-loop.ts's spawnRequestedWorkers).\n11\t# Accepting a client-supplied id here and treating it as authoritative is\n12\t# required for that ordering to keep working.\n13\tclass Worker < ApplicationRecord\n14\t  ROLES = %w[orchestrator worker planner infrastructure chaperone project_init verifier reporter curator committer].freeze\n15\t  STATUSES = %w[launching running stopped].freeze\n16\t  OUTPUT_TAIL_MAX_CHARS = 1_200\n17\t\n18\t  belongs_to :run, foreign_key: :run_id, primary_key: :run_id, optional: true, inverse_of: :workers\n19\t\n20\t  validates :worker_id, presence: true, uniqueness: true\n21\t  validates :run_id, :role, :nickname, :reason, :scope, :pid, :prompt_path, :log_path,\n22\t            :last_message_path, :env_path, :command, presence: true\n23\t  validates :role, inclusion: { in: ROLES }\n24\t  validates :status, inclusion: { in: STATUSES }\n25\t\n26\t  before_validation :assign_started_at, on: :create\n27\t\n28\t  after_create_commit :publish_spawned_event, if: -> { status == \"running\" }\n29\t  after_update_commit :publish_running_event\n30\t  after_update_commit :publish_stopped_event\n31\t\n32\t  scope :active, -> { where(status: \"running\") }\n33\t\n34\t  def self.issue_capability\n35\t    token = SecureRandom.hex(32)\n36\t    [ token, Digest::SHA256.hexdigest(token) ]\n37\t  end\n38\t\n39\t  def self.authenticate_capability(token)\n40\t    return if token.blank?\n41\t\n42\t    find_by(capability_token_digest: Digest::SHA256.hexdigest(token), status: %w[launching running])\n43\t  end\n44\t\n45\t  def self.mark_handoff_completed!(run_id:, nickname: nil, role: nil)\n46\t    workers = where(run_id: run_id)\n47\t    workers = workers.where(nickname: nickname) if nickname.present?\n48\t    workers = workers.where(role: role) if role.present?\n49\t\n50\t    workers.order(created_at: :desc).first&.update_column(:handoff_completed_at, Time.current)\n51\t  end\n52\t\n53\t  def as_json(*)\n54\t    {\n55\t      workerId: worker_id,\n56\t      runId: run_id,\n57\t      role: role,\n58\t      nickname: nickname,\n59\t      reason: reason,\n60\t      scope: scope,\n61\t      status: status,\n62\t      pid: pid,\n63\t      promptPath: prompt_path,\n64\t      logPath: log_path,\n65\t      lastMessagePath: last_message_path,\n66\t      exitStatusPath: exit_status_path,\n67\t      exitCode: exit_code,\n68\t      model: model,\n69\t      executionMode: execution_mode,\n70\t      writeScope: write_scope,\n71\t      allowedPaths: allowed_paths,\n72\t      agentTurnCount: agent_turn_count,\n73\t      inputTokens: input_tokens,\n74\t      outputTokens: output_tokens,\n75\t      cacheReadInputTokens: cache_read_input_tokens,\n76\t      cacheCreationInputTokens: cache_creation_input_tokens,\n77\t      totalCostUsd: total_cost_usd,\n78\t      outputTail: output_tail,\n79\t      envPath: env_path,\n80\t      command: command,\n81\t      args: args,\n82\t      startedAt: started_at.iso8601(3),\n83\t      stoppedAt: stopped_at&.iso8601(3),\n84\t      handoffCompletedAt: handoff_completed_at&.iso8601(3),\n85\t      stopReason: stop_reason,\n86\t      inheritedArtifacts: inherited_artifacts,\n87\t      producedArtifacts: produced_artifacts\n88\t    }\n89\t  end\n90\t\n91\t  def as_diagnostic_json\n92\t    {\n93\t      workerId: worker_id,\n94\t      runId: run_id,\n95\t      role: role,\n96\t      nickname: nickname,\n97\t      scope: scope,\n98\t      status: status,\n99\t      startedAt: started_at&.iso8601(3),\n100\t      stoppedAt: stopped_at&.iso8601(3),\n101\t      exitCode: exit_code,\n102\t      stopReason: stop_reason,\n103\t      model: model,\n104\t      executionMode: execution_mode,\n105\t      writeScope: write_scope,\n106\t      agentTurnCount: agent_turn_count,\n107\t      inputTokens: input_tokens,\n108\t      outputTokens: output_tokens,\n109\t      cacheReadInputTokens: cache_read_input_tokens,\n110\t      cacheCreationInputTokens: cache_creation_input_tokens,\n111\t      totalCostUsd: total_cost_usd,\n112\t      outputTail: output_tail\n113\t    }\n114\t  end\n115\t\n116\t  private\n117\t\n118\t  def output_tail\n119\t    tail = Orchestrator::LogReader.read_tail_lines(log_path, 12).to_s\n120\t    return if tail.blank?\n121\t\n122\t    tail.length > OUTPUT_TAIL_MAX_CHARS ? \"...#{tail.last(OUTPUT_TAIL_MAX_CHARS)}\" : tail\n123\t  rescue Errno::ENOENT, Errno::EACCES\n124\t    nil\n125\t  end\n126\t\n127\t  def assign_started_at\n128\t    self.started_at ||= Time.current\n129\t  end\n130\t\n131\t  def publish_spawned_event\n132\t    BusEvent.publish(\"worker.spawned\", run_id: run_id, payload: {\n133\t      runId: run_id, role: role, nickname: nickname, reason: reason, workerId: worker_id\n134\t    })\n135\t  end\n136\t\n137\t  def publish_running_event\n138\t    publish_spawned_event if saved_change_to_status? && status == \"running\"\n139\t  end\n140\t\n141\t  def publish_stopped_event\n142\t    return unless saved_change_to_status? && status == \"stopped\"\n143\t\n144\t    BusEvent.publish(\"worker.stopped\", run_id: run_id, payload: {\n145\t      runId: run_id, role: role, nickname: nickname, reason: reason, workerId: worker_id, stopReason: stop_reason\n146\t    })\n147\t  end\n148\tend\n149\t"}]},"parent_tool_use_id":null,"session_id":"aaf0b806-53bd-4d56-9d82-b0a910e3601e","uuid":"5977d96f-7939-4979-a1a8-5cdebbd287f8","timestamp":"2026-07-24T16:01:50.645Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/models/worker.rb","content":"require \"digest\"\n\n# Replaces WorkflowWorkerRecord (workflow-worker-runtime.ts) as the source\n# of truth for the worker registry. Wire format (#as_json) mirrors that TS\n# type field-for-field.\n#\n# Unlike SpawnRequest/UserQuestion/BusEvent, worker_id is NOT\n# server-generated: supervisor-loop.ts pre-generates it so it can claim a\n# spawn request's fulfilledWorkerId *before* the worker actually exists\n# (deliberate race-avoidance -- see supervisor-loop.ts's spawnRequestedWorkers).\n# Accepting a client-supplied id here and treating it as authoritative is\n# required for that ordering to keep working.\nclass Worker < ApplicationRecord\n  ROLES = %w[orchestrator worker planner infrastructure chaperone project_init verifier reporter curator committer].freeze\n  STATUSES = %w[launching running stopped].freeze\n  OUTPUT_TAIL_MAX_CHARS = 1_200\n\n  belongs_to :run, foreign_key: :run_id, primary_key: :run_id, optional: true, inverse_of: :workers\n\n  validates :worker_id, presence: true, uniqueness: true\n  validates :run_id, :role, :nickname, :reason, :scope, :pid, :prompt_path, :log_path,\n            :last_message_path, :env_path, :command, presence: true\n  validates :role, inclusion: { in: ROLES }\n  validates :status, inclusion: { in: STATUSES }\n\n  before_validation :assign_started_at, on: :create\n\n  after_create_commit :publish_spawned_event, if: -> { status == \"running\" }\n  after_update_commit :publish_running_event\n  after_update_commit :publish_stopped_event\n\n  scope :active, -> { where(status: \"running\") }\n\n  def self.issue_capability\n    token = SecureRandom.hex(32)\n    [ token, Digest::SHA256.hexdigest(token) ]\n  end\n\n  def self.authenticate_capability(token)\n    return if token.blank?\n\n    find_by(capability_token_digest: Digest::SHA256.hexdigest(token), status: %w[launching running])\n  end\n\n  def self.mark_handoff_completed!(run_id:, nickname: nil, role: nil)\n    workers = where(run_id: run_id)\n    workers = workers.where(nickname: nickname) if nickname.present?\n    workers = workers.where(role: role) if role.present?\n\n    workers.order(created_at: :desc).first&.update_column(:handoff_completed_at, Time.current)\n  end\n\n  def as_json(*)\n    {\n      workerId: worker_id,\n      runId: run_id,\n      role: role,\n      nickname: nickname,\n      reason: reason,\n      scope: scope,\n      status: status,\n      pid: pid,\n      promptPath: prompt_path,\n      logPath: log_path,\n      lastMessagePath: last_message_path,\n      exitStatusPath: exit_status_path,\n      exitCode: exit_code,\n      model: model,\n      executionMode: execution_mode,\n      writeScope: write_scope,\n      allowedPaths: allowed_paths,\n      agentTurnCount: agent_turn_count,\n      inputTokens: input_tokens,\n      outputTokens: output_tokens,\n      cacheReadInputTokens: cache_read_input_tokens,\n      cacheCreationInputTokens: cache_creation_input_tokens,\n      totalCostUsd: total_cost_usd,\n      outputTail: output_tail,\n      envPath: env_path,\n      command: command,\n      args: args,\n      startedAt: started_at.iso8601(3),\n      stoppedAt: stopped_at&.iso8601(3),\n      handoffCompletedAt: handoff_completed_at&.iso8601(3),\n      stopReason: stop_reason,\n      inheritedArtifacts: inherited_artifacts,\n      producedArtifacts: produced_artifacts\n    }\n  end\n\n  def as_diagnostic_json\n    {\n      workerId: worker_id,\n      runId: run_id,\n      role: role,\n      nickname: nickname,\n      scope: scope,\n      status: status,\n      startedAt: started_at&.iso8601(3),\n      stoppedAt: stopped_at&.iso8601(3),\n      exitCode: exit_code,\n      stopReason: stop_reason,\n      model: model,\n      executionMode: execution_mode,\n      writeScope: write_scope,\n      agentTurnCount: agent_turn_count,\n      inputTokens: input_tokens,\n      outputTokens: output_tokens,\n      cacheReadInputTokens: cache_read_input_tokens,\n      cacheCreationInputTokens: cache_creation_input_tokens,\n      totalCostUsd: total_cost_usd,\n      outputTail: output_tail\n    }\n  end\n\n  private\n\n  def output_tail\n    tail = Orchestrator::LogReader.read_tail_lines(log_path, 12).to_s\n    return if tail.blank?\n\n    tail.length > OUTPUT_TAIL_MAX_CHARS ? \"...#{tail.last(OUTPUT_TAIL_MAX_CHARS)}\" : tail\n  rescue Errno::ENOENT, Errno::EACCES\n    nil\n  end\n\n  def assign_started_at\n    self.started_at ||= Time.current\n  end\n\n  def publish_spawned_event\n    BusEvent.publish(\"worker.spawned\", run_id: run_id, payload: {\n      runId: run_id, role: role, nickname: nickname, reason: reason, workerId: worker_id\n    })\n  end\n\n  def publish_running_event\n    publish_spawned_event if saved_change_to_status? && status == \"running\"\n  end\n\n  def publish_stopped_event\n    return unless saved_change_to_status? && status == \"stopped\"\n\n    BusEvent.publish(\"worker.stopped\", run_id: run_id, payload: {\n      runId: run_id, role: role, nickname: nickname, reason: reason, workerId: worker_id, stopReason: stop_reason\n    })\n  end\nend\n","numLines":149,"startLine":1,"totalLines":149}}}
