{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VRa5cmxPu6tGge9w2APJ4E","type":"tool_result","content":"1\trequire \"pathname\"\n2\t\n3\tmodule Orchestrator\n4\t  # Compiles curated, current operational knowledge for one run. It is kept\n5\t  # separate from the unbounded event log so planners receive decisions and\n6\t  # acceptance gates without replaying every worker transcript.\n7\t  #\n8\t  # Acceptance criteria are not handled here -- see Orchestrator::AcceptanceCriteria,\n9\t  # which owns that whole lifecycle as its own first-class model rather than a\n10\t  # RunContextEntry kind. This module covers the other four kinds only.\n11\t  module RunContext\n12\t    module_function\n13\t\n14\t    DEFAULT_BRIEF_ENTRY_LIMIT = 8\n15\t    BRIEF_CONTENT_LIMIT = 600\n16\t    DETAIL_ENTRY_LIMIT = 20\n17\t    AVAILABLE_KEY_LIMIT = 50\n18\t\n19\t    # The default snapshot is deliberately a small briefing, not a replay of\n20\t    # the whole run. Agents can request exact entry keys when a fact needs\n21\t    # its full evidence or wording. Keeping the default bounded prevents a\n22\t    # new agent from spending its context window on history it may not need.\n23\t    def snapshot(run_id:, entry_keys: nil)\n24\t      entries = RunContextEntry.where(run_id: run_id).order(:kind, :entry_key)\n25\t      selected_entries = select_entries(entries.to_a, entry_keys)\n26\t\n27\t      {\n28\t        run_id: run_id,\n29\t        context_mode: entry_keys.present? ? \"selected\" : \"brief\",\n30\t        entries: selected_entries,\n31\t        available_entry_keys: entries.limit(AVAILABLE_KEY_LIMIT).pluck(:entry_key),\n32\t        available_entry_count: entries.count,\n33\t        retrieval_hint: \"Request entryKeys for full details only when a specific fact, decision, or evidence reference is needed.\"\n34\t      }\n35\t    end\n36\t\n37\t    def upsert!(run_id:, entry_key:, kind:, status:, content:, evidence_ref:, created_by:)\n38\t      entry = RunContextEntry.find_or_initialize_by(run_id: run_id, entry_key: entry_key)\n39\t      entry.assign_attributes(\n40\t        kind: kind,\n41\t        status: status,\n42\t        content: content,\n43\t        evidence_ref: evidence_ref.presence,\n44\t        created_by: created_by\n45\t      )\n46\t      entry.save!\n47\t      entry\n48\t    end\n49\t\n50\t    def validate_evidence!(run_id:, evidence_ref:)\n51\t      run = Run.find_by!(run_id:)\n52\t      root = Pathname.new(run.target_root).expand_path\n53\t      candidate = root.join(evidence_ref.to_s).cleanpath\n54\t      inside_workspace = candidate.to_s == root.to_s || candidate.to_s.start_with?(\"#{root}#{File::SEPARATOR}\")\n55\t      workspace_evidence = inside_workspace && candidate.file?\n56\t      artifact_evidence = begin\n57\t        File.file?(ArtifactStore.resolve_path(run.target_root, run.run_id, evidence_ref))\n58\t      rescue ArgumentError\n59\t        false\n60\t      end\n61\t      raise ArgumentError, \"Verified acceptance evidence does not exist: #{evidence_ref}\" unless workspace_evidence || artifact_evidence\n62\t    end\n63\t\n64\t    def select_entries(entries, entry_keys)\n65\t      if entry_keys.present?\n66\t        entries.select { |entry| entry_keys.include?(entry.entry_key) }\n67\t          .first(DETAIL_ENTRY_LIMIT)\n68\t          .map(&:as_json)\n69\t      else\n70\t        entries\n71\t          .sort_by { |entry| [ brief_kind_rank(entry.kind), -entry.updated_at.to_i ] }\n72\t          .first(DEFAULT_BRIEF_ENTRY_LIMIT)\n73\t          .map { |entry| brief_entry(entry) }\n74\t      end\n75\t    end\n76\t    private_class_method :select_entries\n77\t\n78\t    def brief_kind_rank(kind)\n79\t      %w[operator_decision constraint fact rejected_approach].index(kind) || 99\n80\t    end\n81\t    private_class_method :brief_kind_rank\n82\t\n83\t    def brief_entry(entry)\n84\t      entry.as_json.merge(content: truncate(entry.content, BRIEF_CONTENT_LIMIT))\n85\t    end\n86\t    private_class_method :brief_entry\n87\t\n88\t    def truncate(value, limit)\n89\t      text = value.to_s\n90\t      text.length > limit ? \"#{text.first(limit).rstrip}…\" : text\n91\t    end\n92\t    private_class_method :truncate\n93\t  end\n94\tend\n95\t"}]},"parent_tool_use_id":null,"session_id":"25159a08-09b3-48ef-88b1-f3515df107c2","uuid":"e0c7590b-570e-4c22-8a35-52dfbeacec92","timestamp":"2026-07-24T16:16:20.970Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/services/orchestrator/run_context.rb","content":"require \"pathname\"\n\nmodule Orchestrator\n  # Compiles curated, current operational knowledge for one run. It is kept\n  # separate from the unbounded event log so planners receive decisions and\n  # acceptance gates without replaying every worker transcript.\n  #\n  # Acceptance criteria are not handled here -- see Orchestrator::AcceptanceCriteria,\n  # which owns that whole lifecycle as its own first-class model rather than a\n  # RunContextEntry kind. This module covers the other four kinds only.\n  module RunContext\n    module_function\n\n    DEFAULT_BRIEF_ENTRY_LIMIT = 8\n    BRIEF_CONTENT_LIMIT = 600\n    DETAIL_ENTRY_LIMIT = 20\n    AVAILABLE_KEY_LIMIT = 50\n\n    # The default snapshot is deliberately a small briefing, not a replay of\n    # the whole run. Agents can request exact entry keys when a fact needs\n    # its full evidence or wording. Keeping the default bounded prevents a\n    # new agent from spending its context window on history it may not need.\n    def snapshot(run_id:, entry_keys: nil)\n      entries = RunContextEntry.where(run_id: run_id).order(:kind, :entry_key)\n      selected_entries = select_entries(entries.to_a, entry_keys)\n\n      {\n        run_id: run_id,\n        context_mode: entry_keys.present? ? \"selected\" : \"brief\",\n        entries: selected_entries,\n        available_entry_keys: entries.limit(AVAILABLE_KEY_LIMIT).pluck(:entry_key),\n        available_entry_count: entries.count,\n        retrieval_hint: \"Request entryKeys for full details only when a specific fact, decision, or evidence reference is needed.\"\n      }\n    end\n\n    def upsert!(run_id:, entry_key:, kind:, status:, content:, evidence_ref:, created_by:)\n      entry = RunContextEntry.find_or_initialize_by(run_id: run_id, entry_key: entry_key)\n      entry.assign_attributes(\n        kind: kind,\n        status: status,\n        content: content,\n        evidence_ref: evidence_ref.presence,\n        created_by: created_by\n      )\n      entry.save!\n      entry\n    end\n\n    def validate_evidence!(run_id:, evidence_ref:)\n      run = Run.find_by!(run_id:)\n      root = Pathname.new(run.target_root).expand_path\n      candidate = root.join(evidence_ref.to_s).cleanpath\n      inside_workspace = candidate.to_s == root.to_s || candidate.to_s.start_with?(\"#{root}#{File::SEPARATOR}\")\n      workspace_evidence = inside_workspace && candidate.file?\n      artifact_evidence = begin\n        File.file?(ArtifactStore.resolve_path(run.target_root, run.run_id, evidence_ref))\n      rescue ArgumentError\n        false\n      end\n      raise ArgumentError, \"Verified acceptance evidence does not exist: #{evidence_ref}\" unless workspace_evidence || artifact_evidence\n    end\n\n    def select_entries(entries, entry_keys)\n      if entry_keys.present?\n        entries.select { |entry| entry_keys.include?(entry.entry_key) }\n          .first(DETAIL_ENTRY_LIMIT)\n          .map(&:as_json)\n      else\n        entries\n          .sort_by { |entry| [ brief_kind_rank(entry.kind), -entry.updated_at.to_i ] }\n          .first(DEFAULT_BRIEF_ENTRY_LIMIT)\n          .map { |entry| brief_entry(entry) }\n      end\n    end\n    private_class_method :select_entries\n\n    def brief_kind_rank(kind)\n      %w[operator_decision constraint fact rejected_approach].index(kind) || 99\n    end\n    private_class_method :brief_kind_rank\n\n    def brief_entry(entry)\n      entry.as_json.merge(content: truncate(entry.content, BRIEF_CONTENT_LIMIT))\n    end\n    private_class_method :brief_entry\n\n    def truncate(value, limit)\n      text = value.to_s\n      text.length > limit ? \"#{text.first(limit).rstrip}…\" : text\n    end\n    private_class_method :truncate\n  end\nend\n","numLines":95,"startLine":1,"totalLines":95}}}
