{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DPzarXBvGyQRcpkRbJJZvB","type":"tool_result","content":"1\trequire \"pathname\"\n2\t\n3\tmodule Orchestrator\n4\t  # Ports scripts/workflow-mcp.ts's writeWorkflowArtifact/readWorkflowArtifact/\n5\t  # collectWorkflowState/resolveWorkflowArtifactPath/sanitizeRunId. Artifact\n6\t  # files are explicitly out of scope for the JSON-bus-to-Rails migration\n7\t  # (free-form content, not structured bus state) -- they stay as local\n8\t  # files on the workspace's own filesystem, same as before.\n9\t  module ArtifactStore\n10\t    module_function\n11\t\n12\t    DEFAULT_READ_LIMIT = 2_000\n13\t    MAX_READ_LIMIT = 8_000\n14\t    DEFAULT_OUTPUT_DIR = File.join(\".workflow-orchestrator\", \"artifacts\")\n15\t    LEGACY_OUTPUT_DIR = File.join(\"front\", \"demo-output\", \"agents-sdk\")\n16\t\n17\t    def output_dir(root_dir)\n18\t      generic = File.join(root_dir, DEFAULT_OUTPUT_DIR)\n19\t      legacy = File.join(root_dir, LEGACY_OUTPUT_DIR)\n20\t      return legacy if !Dir.exist?(generic) && Dir.exist?(legacy)\n21\t\n22\t      generic\n23\t    end\n24\t\n25\t    def sanitize_run_id(run_id)\n26\t      sanitized = run_id.to_s.strip.gsub(/[^A-Za-z0-9._-]/, \"_\")\n27\t      raise ArgumentError, \"run_id must not be empty\" if sanitized.empty?\n28\t\n29\t      sanitized\n30\t    end\n31\t\n32\t    def resolve_path(root_dir, run_id, artifact_name)\n33\t      if artifact_name.blank? || artifact_name == \".\" || artifact_name == \"..\" ||\n34\t         artifact_name.include?(\"/\") || artifact_name.include?(\"\\\\\") || artifact_name.include?(\"\\0\")\n35\t        raise ArgumentError, \"Unsafe workflow artifact name: #{artifact_name}\"\n36\t      end\n37\t\n38\t      File.join(output_dir(root_dir), sanitize_run_id(run_id), artifact_name)\n39\t    end\n40\t\n41\t    def canonical_name(root_dir, run_id, reference)\n42\t      value = reference.to_s\n43\t      run_dir = File.join(output_dir(root_dir), sanitize_run_id(run_id))\n44\t      absolute = Pathname.new(value).absolute? ? File.expand_path(value) : File.expand_path(value, root_dir)\n45\t      return value unless File.dirname(absolute) == File.expand_path(run_dir)\n46\t\n47\t      File.basename(absolute)\n48\t    end\n49\t\n50\t    def write(root_dir, run_id, artifact_name, content)\n51\t      path = resolve_path(root_dir, run_id, artifact_name)\n52\t      FileUtils.mkdir_p(File.dirname(path))\n53\t      File.write(path, content)\n54\t      path\n55\t    end\n56\t\n57\t    def names(root_dir, run_id)\n58\t      run_dir = File.join(output_dir(root_dir), sanitize_run_id(run_id))\n59\t      return [] unless Dir.exist?(run_dir)\n60\t\n61\t      Dir.children(run_dir).select { |name| File.file?(File.join(run_dir, name)) }.sort\n62\t    end\n63\t\n64\t    def read(root_dir, run_id, artifact_name)\n65\t      File.read(resolve_path(root_dir, run_id, artifact_name))\n66\t    end\n67\t\n68\t    # MCP consumers should start with a small evidence window and request a\n69\t    # later offset only when that window leaves a specific question open.\n70\t    # Offsets are bytes so they can be used directly with File#seek.\n71\t    def read_window(root_dir, run_id, artifact_name, offset: 0, limit: DEFAULT_READ_LIMIT)\n72\t      path = resolve_path(root_dir, run_id, artifact_name)\n73\t      total_bytes = File.size(path)\n74\t      start_offset = offset.to_i.clamp(0, total_bytes)\n75\t      byte_limit = limit.to_i.clamp(1, MAX_READ_LIMIT)\n76\t      content = File.binread(path, byte_limit, start_offset).force_encoding(\"UTF-8\").scrub\n77\t      next_offset = start_offset + content.bytesize\n78\t\n79\t      {\n80\t        content: content,\n81\t        total_bytes: total_bytes,\n82\t        offset: start_offset,\n83\t        next_offset: next_offset < total_bytes ? next_offset : nil,\n84\t        truncated: next_offset < total_bytes\n85\t      }\n86\t    end\n87\t\n88\t    # Candidate names come from SpawnRequest#scope, which is often a real\n89\t    # nested workspace path (e.g. \"front/scripts/record-demo.ts\") rather\n90\t    # than a flat artifact filename -- treat those as simply not existing\n91\t    # as artifacts instead of raising, since resolve_path's traversal guard\n92\t    # rejects any name containing \"/\".\n93\t    def collect(root_dir, run_id, artifact_names)\n94\t      artifacts = artifact_names.map do |name|\n95\t        path = begin\n96\t          resolve_path(root_dir, run_id, name)\n97\t        rescue ArgumentError\n98\t          nil\n99\t        end\n100\t\n101\t        if path.nil? || !File.exist?(path)\n102\t          next { name: name, path: path, exists: false, size_bytes: nil, updated_at: nil, preview: nil }\n103\t        end\n104\t\n105\t        stat = File.stat(path)\n106\t        preview = File.open(path, \"rb\") { |f| f.read(200) }\n107\t        {\n108\t          name: name, path: path, exists: true, size_bytes: stat.size,\n109\t          updated_at: stat.mtime.utc.iso8601(3), preview: preview&.scrub\n110\t        }\n111\t      end\n112\t\n113\t      { output_dir: output_dir(root_dir), artifacts: artifacts }\n114\t    end\n115\t  end\n116\tend\n117\t"}]},"parent_tool_use_id":null,"session_id":"25159a08-09b3-48ef-88b1-f3515df107c2","uuid":"1ae65bf9-a8f8-409f-9ee6-a4980f022fb6","timestamp":"2026-07-24T16:16:30.438Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/services/orchestrator/artifact_store.rb","content":"require \"pathname\"\n\nmodule Orchestrator\n  # Ports scripts/workflow-mcp.ts's writeWorkflowArtifact/readWorkflowArtifact/\n  # collectWorkflowState/resolveWorkflowArtifactPath/sanitizeRunId. Artifact\n  # files are explicitly out of scope for the JSON-bus-to-Rails migration\n  # (free-form content, not structured bus state) -- they stay as local\n  # files on the workspace's own filesystem, same as before.\n  module ArtifactStore\n    module_function\n\n    DEFAULT_READ_LIMIT = 2_000\n    MAX_READ_LIMIT = 8_000\n    DEFAULT_OUTPUT_DIR = File.join(\".workflow-orchestrator\", \"artifacts\")\n    LEGACY_OUTPUT_DIR = File.join(\"front\", \"demo-output\", \"agents-sdk\")\n\n    def output_dir(root_dir)\n      generic = File.join(root_dir, DEFAULT_OUTPUT_DIR)\n      legacy = File.join(root_dir, LEGACY_OUTPUT_DIR)\n      return legacy if !Dir.exist?(generic) && Dir.exist?(legacy)\n\n      generic\n    end\n\n    def sanitize_run_id(run_id)\n      sanitized = run_id.to_s.strip.gsub(/[^A-Za-z0-9._-]/, \"_\")\n      raise ArgumentError, \"run_id must not be empty\" if sanitized.empty?\n\n      sanitized\n    end\n\n    def resolve_path(root_dir, run_id, artifact_name)\n      if artifact_name.blank? || artifact_name == \".\" || artifact_name == \"..\" ||\n         artifact_name.include?(\"/\") || artifact_name.include?(\"\\\\\") || artifact_name.include?(\"\\0\")\n        raise ArgumentError, \"Unsafe workflow artifact name: #{artifact_name}\"\n      end\n\n      File.join(output_dir(root_dir), sanitize_run_id(run_id), artifact_name)\n    end\n\n    def canonical_name(root_dir, run_id, reference)\n      value = reference.to_s\n      run_dir = File.join(output_dir(root_dir), sanitize_run_id(run_id))\n      absolute = Pathname.new(value).absolute? ? File.expand_path(value) : File.expand_path(value, root_dir)\n      return value unless File.dirname(absolute) == File.expand_path(run_dir)\n\n      File.basename(absolute)\n    end\n\n    def write(root_dir, run_id, artifact_name, content)\n      path = resolve_path(root_dir, run_id, artifact_name)\n      FileUtils.mkdir_p(File.dirname(path))\n      File.write(path, content)\n      path\n    end\n\n    def names(root_dir, run_id)\n      run_dir = File.join(output_dir(root_dir), sanitize_run_id(run_id))\n      return [] unless Dir.exist?(run_dir)\n\n      Dir.children(run_dir).select { |name| File.file?(File.join(run_dir, name)) }.sort\n    end\n\n    def read(root_dir, run_id, artifact_name)\n      File.read(resolve_path(root_dir, run_id, artifact_name))\n    end\n\n    # MCP consumers should start with a small evidence window and request a\n    # later offset only when that window leaves a specific question open.\n    # Offsets are bytes so they can be used directly with File#seek.\n    def read_window(root_dir, run_id, artifact_name, offset: 0, limit: DEFAULT_READ_LIMIT)\n      path = resolve_path(root_dir, run_id, artifact_name)\n      total_bytes = File.size(path)\n      start_offset = offset.to_i.clamp(0, total_bytes)\n      byte_limit = limit.to_i.clamp(1, MAX_READ_LIMIT)\n      content = File.binread(path, byte_limit, start_offset).force_encoding(\"UTF-8\").scrub\n      next_offset = start_offset + content.bytesize\n\n      {\n        content: content,\n        total_bytes: total_bytes,\n        offset: start_offset,\n        next_offset: next_offset < total_bytes ? next_offset : nil,\n        truncated: next_offset < total_bytes\n      }\n    end\n\n    # Candidate names come from SpawnRequest#scope, which is often a real\n    # nested workspace path (e.g. \"front/scripts/record-demo.ts\") rather\n    # than a flat artifact filename -- treat those as simply not existing\n    # as artifacts instead of raising, since resolve_path's traversal guard\n    # rejects any name containing \"/\".\n    def collect(root_dir, run_id, artifact_names)\n      artifacts = artifact_names.map do |name|\n        path = begin\n          resolve_path(root_dir, run_id, name)\n        rescue ArgumentError\n          nil\n        end\n\n        if path.nil? || !File.exist?(path)\n          next { name: name, path: path, exists: false, size_bytes: nil, updated_at: nil, preview: nil }\n        end\n\n        stat = File.stat(path)\n        preview = File.open(path, \"rb\") { |f| f.read(200) }\n        {\n          name: name, path: path, exists: true, size_bytes: stat.size,\n          updated_at: stat.mtime.utc.iso8601(3), preview: preview&.scrub\n        }\n      end\n\n      { output_dir: output_dir(root_dir), artifacts: artifacts }\n    end\n  end\nend\n","numLines":117,"startLine":1,"totalLines":117}}}
