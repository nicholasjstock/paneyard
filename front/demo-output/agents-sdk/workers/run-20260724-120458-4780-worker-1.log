{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XEvBbhUo8CdpvZnSf1ZPcu","type":"tool_result","content":"1\trequire \"rails_helper\"\n2\t\n3\tRSpec.describe Run, type: :model do\n4\t  it \"renders stale launching runs as launch queued\" do\n5\t    workspace = Workspace.create!(name: \"planner-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir(\"workflow-run-model\"))\n6\t    run = Run.create!(\n7\t      run_id: \"demo-#{SecureRandom.hex(4)}\",\n8\t      task: \"Check stale launch rendering\",\n9\t      workspace: workspace,\n10\t      target_root: workspace.root_path,\n11\t      launcher_variant: \"claude\",\n12\t      status: \"launching\",\n13\t      launched_by: \"operator\",\n14\t      created_at: 2.minutes.ago,\n15\t      updated_at: 2.minutes.ago\n16\t    )\n17\t\n18\t    expect(run.launch_queued?).to be(true)\n19\t    expect(run.status_badge_label).to eq(\"launch queued\")\n20\t    expect(run.status_badge_class).to eq(\"queued\")\n21\t  end\n22\t\n23\t  it \"does not emit duplicate status events for an unchanged phase\" do\n24\t    workspace = Workspace.create!(name: \"status-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir(\"workflow-status\"))\n25\t    run = Run.create!(\n26\t      run_id: \"demo-#{SecureRandom.hex(4)}\", task: \"Deduplicate status\", workspace:,\n27\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n28\t    )\n29\t\n30\t    run.publish_phase!(phase: \"waiting_on_capacity\", owner: \"orchestrator\", summary: \"Retry at noon.\")\n31\t    first_updated_at = run.phase_updated_at\n32\t    run.publish_phase!(phase: \"waiting_on_capacity\", owner: \"orchestrator\", summary: \"Retry at noon.\")\n33\t\n34\t    expect(run.bus_events.where(event_type: \"run.status\").count).to eq(1)\n35\t    expect(run.reload.phase_updated_at).to eq(first_updated_at)\n36\t  end\n37\t\n38\t  it \"stops its own active run commands when it reaches a terminal status, without touching another run's\" do\n39\t    workspace = Workspace.create!(name: \"cleanup-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir(\"workflow-cleanup\"))\n40\t    run = workspace.runs.create!(\n41\t      run_id: \"cleanup-#{SecureRandom.hex(4)}\", task: \"Stop active commands on completion\", workspace:,\n42\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n43\t    )\n44\t    other_run = workspace.runs.create!(\n45\t      run_id: \"other-#{SecureRandom.hex(4)}\", task: \"Unrelated run\", workspace:,\n46\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n47\t    )\n48\t    command = Orchestrator::RunCommandRunner.start(\n49\t      run: run, requested_by_worker_id: \"worker-1\", executable: \"/bin/sleep\", arguments: [ \"30\" ]\n50\t    )"}]},"parent_tool_use_id":null,"session_id":"b646d34a-518c-4379-8490-a31643afa1e2","uuid":"77a5870d-ff99-45f0-9e83-02d72b3082a0","timestamp":"2026-07-24T12:14:18.253Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/spec/models/run_spec.rb","content":"require \"rails_helper\"\n\nRSpec.describe Run, type: :model do\n  it \"renders stale launching runs as launch queued\" do\n    workspace = Workspace.create!(name: \"planner-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir(\"workflow-run-model\"))\n    run = Run.create!(\n      run_id: \"demo-#{SecureRandom.hex(4)}\",\n      task: \"Check stale launch rendering\",\n      workspace: workspace,\n      target_root: workspace.root_path,\n      launcher_variant: \"claude\",\n      status: \"launching\",\n      launched_by: \"operator\",\n      created_at: 2.minutes.ago,\n      updated_at: 2.minutes.ago\n    )\n\n    expect(run.launch_queued?).to be(true)\n    expect(run.status_badge_label).to eq(\"launch queued\")\n    expect(run.status_badge_class).to eq(\"queued\")\n  end\n\n  it \"does not emit duplicate status events for an unchanged phase\" do\n    workspace = Workspace.create!(name: \"status-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir(\"workflow-status\"))\n    run = Run.create!(\n      run_id: \"demo-#{SecureRandom.hex(4)}\", task: \"Deduplicate status\", workspace:,\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n\n    run.publish_phase!(phase: \"waiting_on_capacity\", owner: \"orchestrator\", summary: \"Retry at noon.\")\n    first_updated_at = run.phase_updated_at\n    run.publish_phase!(phase: \"waiting_on_capacity\", owner: \"orchestrator\", summary: \"Retry at noon.\")\n\n    expect(run.bus_events.where(event_type: \"run.status\").count).to eq(1)\n    expect(run.reload.phase_updated_at).to eq(first_updated_at)\n  end\n\n  it \"stops its own active run commands when it reaches a terminal status, without touching another run's\" do\n    workspace = Workspace.create!(name: \"cleanup-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir(\"workflow-cleanup\"))\n    run = workspace.runs.create!(\n      run_id: \"cleanup-#{SecureRandom.hex(4)}\", task: \"Stop active commands on completion\", workspace:,\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n    other_run = workspace.runs.create!(\n      run_id: \"other-#{SecureRandom.hex(4)}\", task: \"Unrelated run\", workspace:,\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n    command = Orchestrator::RunCommandRunner.start(\n      run: run, requested_by_worker_id: \"worker-1\", executable: \"/bin/sleep\", arguments: [ \"30\" ]\n    )","numLines":50,"startLine":1,"totalLines":63}}}
