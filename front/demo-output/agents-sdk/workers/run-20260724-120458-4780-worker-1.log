{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016cewAunqQaooPTiaPZnDjD","type":"tool_result","content":"1\trequire \"rails_helper\"\n2\t\n3\tRSpec.describe Orchestrator::SpawnRequestedWorkers do\n4\t  include ActiveJob::TestHelper\n5\t\n6\t  it \"queues a Rails planner decision instead of spawning a planner process\" do\n7\t    workspace = Workspace.create!(name: \"spawn-planner-#{SecureRandom.hex(4)}\", root_path: Rails.root.to_s)\n8\t    run = workspace.runs.create!(\n9\t      run_id: \"spawn-planner-#{SecureRandom.hex(4)}\", task: \"Plan the run\",\n10\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n11\t    )\n12\t    request = run.spawn_requests.create!(\n13\t      asked_by: \"worker\", scope: \"workflow-plan.md\", text: \"Choose the next step.\",\n14\t      requested_role: \"planner\", priority: \"blocking\"\n15\t    )\n16\t\n17\t    assert_enqueued_with(job: PlannerDecisionJob) do\n18\t      spawned = Orchestrator::SpawnRequestedWorkers.call(run:)\n19\t      assert_empty spawned\n20\t    end\n21\t\n22\t    assert_equal \"fulfilled\", request.reload.status\n23\t    assert_equal \"planner_decision_job\", request.fulfilled_by\n24\t    assert_equal \"queued\", run.planner_decisions.find_by!(spawn_request_id: request.request_id).status\n25\t    assert_empty run.workers.where(role: \"planner\")\n26\t  end\n27\t\n28\t  it \"spawns a chaperone worker with a reissued capability against the matching pending review\" do\n29\t    workspace = Workspace.create!(name: \"spawn-chaperone-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n30\t    run = workspace.runs.create!(\n31\t      run_id: \"spawn-chaperone-#{SecureRandom.hex(4)}\", task: \"Review a repeated failure\",\n32\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n33\t    )\n34\t    review, original_token = ChaperoneReview.issue!(\n35\t      run:, lineage_key: \"diagnosis-lineage\", step_attempt_ids: [], summary: \"Repeated blocked diagnosis.\"\n36\t    )\n37\t    request = run.spawn_requests.create!(\n38\t      asked_by: \"chaperone\", scope: review.lineage_key, lineage_key: review.lineage_key,\n39\t      text: \"Repeated blocked diagnosis.\", requested_role: \"chaperone\", priority: \"blocking\", model_tier: \"strong\"\n40\t    )\n41\t\n42\t    spawned = nil\n43\t    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker) do |**kwargs|\n44\t      spawned = kwargs\n45\t      instance_double(Worker, worker_id: kwargs[:worker_id])\n46\t    end\n47\t\n48\t    Orchestrator::SpawnRequestedWorkers.call(run:)\n49\t\n50\t    assert_equal \"chaperone\", spawned[:role]\n51\t    assert_equal \"strong\", spawned[:model_tier]\n52\t    assert_equal review.lineage_key, spawned[:scope]\n53\t    expect(spawned[:mcp_override][:token]).not_to eq(original_token)\n54\t    expect(ChaperoneReview.authenticate(spawned[:mcp_override][:token])).to eq(review)\n55\t    expect(spawned[:mcp_override][:allowed_tools]).to eq(Orchestrator::ChaperoneMcpServer::TOOL_NAMES)\n56\t    assert_equal \"fulfilled\", request.reload.status\n57\t  end\n58\t\n59\t  it \"spawns a verifier worker through the generic dispatch path with a read-only, source-protected sandbox\" do\n60\t    workspace = Workspace.create!(name: \"spawn-verifier-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n61\t    run = workspace.runs.create!(\n62\t      run_id: \"spawn-verifier-#{SecureRandom.hex(4)}\", task: \"Verify a claim\",\n63\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n64\t    )\n65\t    request = run.spawn_requests.create!(\n66\t      asked_by: \"planner\", scope: \"acceptance-verify-outcome\", lineage_key: \"acceptance:outcome\",\n67\t      text: \"Independently verify the claim.\", requested_role: \"verifier\", priority: \"blocking\",\n68\t      model_tier: \"small\", execution_mode: \"verification\", write_scope: \"source_protected\", allowed_paths: []\n69\t    )\n70\t\n71\t    spawned = nil\n72\t    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker) do |**kwargs|\n73\t      spawned = kwargs\n74\t      instance_double(Worker, worker_id: kwargs[:worker_id])\n75\t    end\n76\t\n77\t    Orchestrator::SpawnRequestedWorkers.call(run:)\n78\t\n79\t    assert_equal \"verifier\", spawned[:role]\n80\t    assert_equal \"source_protected\", spawned[:write_scope]\n81\t    assert_equal [], spawned[:allowed_paths]\n82\t    assert_equal \"verification\", spawned[:mode]\n83\t    assert_equal \"small\", spawned[:model_tier]\n84\t    assert_equal \"fulfilled\", request.reload.status\n85\t  end\n86\t\n87\t  it \"grants the complete project-init-protected source surface to implementation workers\" do\n88\t    project_root = Dir.mktmpdir\n89\t    source_root = File.join(project_root, \"main\")\n90\t    workspace = Workspace.create!(\n91\t      name: \"spawn-test-roots-#{SecureRandom.hex(4)}\", root_path: project_root,\n92\t      protected_path_patterns: [ \"app/**\", \"quality/checks/**\" ]\n93\t    )\n94\t    run = workspace.runs.create!(\n95\t      run_id: \"spawn-test-roots-#{SecureRandom.hex(4)}\", task: \"Implement with tests\", target_root: source_root,\n96\t      launcher_variant: \"claude\", status: \"running\"\n97\t    )\n98\t    run.spawn_requests.create!(\n99\t      asked_by: \"planner\", scope: \"fix.md\", text: \"Implement the fix.\", requested_role: \"worker\", priority: \"blocking\",\n100\t      execution_mode: \"implementation\", write_scope: \"scoped_changes\", allowed_paths: [ \"app/example.rb\" ]\n101\t    )\n102\t\n103\t    spawned = nil\n104\t    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker) do |**kwargs|\n105\t      spawned = kwargs\n106\t      instance_double(Worker, worker_id: kwargs[:worker_id])\n107\t    end\n108\t\n109\t    Orchestrator::SpawnRequestedWorkers.call(run:)\n110\t\n111\t    expect(spawned[:allowed_paths]).to contain_exactly(\"app/**\", \"quality/checks/**\")\n112\t  ensure\n113\t    FileUtils.remove_entry(project_root) if project_root && Dir.exist?(project_root)\n114\t  end\n115\t\n116\t  it \"grants the protected source surface to scoped infrastructure workers\" do\n117\t    project_root = Dir.mktmpdir\n118\t    source_root = File.join(project_root, \"main\")\n119\t    FileUtils.mkdir_p(File.join(source_root, \"app\"))\n120\t    workspace = Workspace.create!(\n121\t      name: \"spawn-infrastructure-roots-#{SecureRandom.hex(4)}\", root_path: project_root,\n122\t      protected_path_patterns: [ \"app/**\" ]\n123\t    )\n124\t    run = workspace.runs.create!(\n125\t      run_id: \"spawn-infrastructure-roots-#{SecureRandom.hex(4)}\", task: \"Repair setup\", target_root: source_root,\n126\t      launcher_variant: \"codex\", status: \"running\"\n127\t    )\n128\t    run.spawn_requests.create!(\n129\t      asked_by: \"planner\", scope: \"repair.md\", text: \"Repair the environment.\", requested_role: \"infrastructure\", priority: \"blocking\",\n130\t      execution_mode: \"infrastructure\", write_scope: \"scoped_changes\", allowed_paths: []\n131\t    )\n132\t\n133\t    spawned = nil\n134\t    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker) do |**kwargs|\n135\t      spawned = kwargs\n136\t      instance_double(Worker, worker_id: kwargs[:worker_id])\n137\t    end\n138\t\n139\t    Orchestrator::SpawnRequestedWorkers.call(run:)\n140\t\n141\t    expect(spawned[:allowed_paths]).to eq([ \"app/**\" ])\n142\t  ensure\n143\t    FileUtils.remove_entry(project_root) if project_root && Dir.exist?(project_root)\n144\t  end\n145\t\n146\t  it \"dispatches only one queued verifier per run, leaving later work queued\" do\n147\t    workspace = Workspace.create!(name: \"serial-verifiers-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n148\t    run = workspace.runs.create!(\n149\t      run_id: \"serial-verifiers-#{SecureRandom.hex(4)}\", task: \"Verify several claims\",\n150\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n151\t    )\n152\t    first = run.spawn_requests.create!(\n153\t      asked_by: \"planner\", scope: \"acceptance-verify-first\", lineage_key: \"acceptance:first\",\n154\t      text: \"Verify the first claim.\", requested_role: \"verifier\", priority: \"blocking\",\n155\t      model_tier: \"small\", execution_mode: \"verification\", write_scope: \"source_protected\", allowed_paths: []\n156\t    )\n157\t    second = run.spawn_requests.create!(\n158\t      asked_by: \"planner\", scope: \"acceptance-verify-second\", lineage_key: \"acceptance:second\",\n159\t      text: \"Verify the second claim.\", requested_role: \"verifier\", priority: \"blocking\",\n160\t      model_tier: \"small\", execution_mode: \"verification\", write_scope: \"source_protected\", allowed_paths: []\n161\t    )\n162\t\n163\t    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker).once.and_return(instance_double(Worker))\n164\t\n165\t    Orchestrator::SpawnRequestedWorkers.call(run:)\n166\t\n167\t    assert_equal \"fulfilled\", first.reload.status\n168\t    assert_equal \"open\", second.reload.status\n169\t  end\n170\t\n171\t  it \"does not dispatch a worker while a Rails planner decision is in flight\" do\n172\t    workspace = Workspace.create!(name: \"serial-planner-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n173\t    run = workspace.runs.create!(\n174\t      run_id: \"serial-planner-#{SecureRandom.hex(4)}\", task: \"Plan before verifying\",\n175\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n176\t    )\n177\t    planner_request = run.spawn_requests.create!(\n178\t      asked_by: \"worker\", scope: \"workflow-plan.md\", text: \"Choose the next step.\",\n179\t      requested_role: \"planner\", priority: \"blocking\"\n180\t    )\n181\t    PlannerDecision.create!(run:, spawn_request: planner_request, status: \"running\")\n182\t    verifier_request = run.spawn_requests.create!(\n183\t      asked_by: \"planner\", scope: \"acceptance-verify-outcome\", lineage_key: \"acceptance:outcome\",\n184\t      text: \"Verify the claim.\", requested_role: \"verifier\", priority: \"blocking\",\n185\t      model_tier: \"small\", execution_mode: \"verification\", write_scope: \"source_protected\", allowed_paths: []\n186\t    )\n187\t\n188\t    expect(Orchestrator::WorkerSpawner).not_to receive(:spawn_worker)\n189\t\n190\t    assert_empty Orchestrator::SpawnRequestedWorkers.call(run:)\n191\t    assert_equal \"open\", verifier_request.reload.status\n192\t  end\n193\t\n194\t  it \"dismisses a chaperone spawn request when no matching pending review is found\" do\n195\t    workspace = Workspace.create!(name: \"spawn-chaperone-missing-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n196\t    run = workspace.runs.create!(\n197\t      run_id: \"spawn-chaperone-missing-#{SecureRandom.hex(4)}\", task: \"Review a repeated failure\",\n198\t      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n199\t    )\n200\t    request = run.spawn_requests.create!(\n201\t      asked_by: \"chaperone\", scope: \"stale-lineage\", lineage_key: \"stale-lineage\",\n202\t      text: \"Repeated blocked diagnosis.\", requested_role: \"chaperone\", priority: \"blocking\", model_tier: \"strong\"\n203\t    )\n204\t\n205\t    expect(Orchestrator::WorkerSpawner).not_to receive(:spawn_worker)\n206\t\n207\t    spawned = Orchestrator::SpawnRequestedWorkers.call(run:)\n208\t\n209\t    assert_empty spawned\n210\t    assert_equal \"dismissed\", request.reload.status\n211\t  end\n212\tend\n213\t"}]},"parent_tool_use_id":null,"session_id":"b646d34a-518c-4379-8490-a31643afa1e2","uuid":"f44fcfe0-fe63-4235-8270-e03b2074b8b4","timestamp":"2026-07-24T12:14:39.027Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/spec/services/orchestrator/spawn_requested_workers_spec.rb","content":"require \"rails_helper\"\n\nRSpec.describe Orchestrator::SpawnRequestedWorkers do\n  include ActiveJob::TestHelper\n\n  it \"queues a Rails planner decision instead of spawning a planner process\" do\n    workspace = Workspace.create!(name: \"spawn-planner-#{SecureRandom.hex(4)}\", root_path: Rails.root.to_s)\n    run = workspace.runs.create!(\n      run_id: \"spawn-planner-#{SecureRandom.hex(4)}\", task: \"Plan the run\",\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n    request = run.spawn_requests.create!(\n      asked_by: \"worker\", scope: \"workflow-plan.md\", text: \"Choose the next step.\",\n      requested_role: \"planner\", priority: \"blocking\"\n    )\n\n    assert_enqueued_with(job: PlannerDecisionJob) do\n      spawned = Orchestrator::SpawnRequestedWorkers.call(run:)\n      assert_empty spawned\n    end\n\n    assert_equal \"fulfilled\", request.reload.status\n    assert_equal \"planner_decision_job\", request.fulfilled_by\n    assert_equal \"queued\", run.planner_decisions.find_by!(spawn_request_id: request.request_id).status\n    assert_empty run.workers.where(role: \"planner\")\n  end\n\n  it \"spawns a chaperone worker with a reissued capability against the matching pending review\" do\n    workspace = Workspace.create!(name: \"spawn-chaperone-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n    run = workspace.runs.create!(\n      run_id: \"spawn-chaperone-#{SecureRandom.hex(4)}\", task: \"Review a repeated failure\",\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n    review, original_token = ChaperoneReview.issue!(\n      run:, lineage_key: \"diagnosis-lineage\", step_attempt_ids: [], summary: \"Repeated blocked diagnosis.\"\n    )\n    request = run.spawn_requests.create!(\n      asked_by: \"chaperone\", scope: review.lineage_key, lineage_key: review.lineage_key,\n      text: \"Repeated blocked diagnosis.\", requested_role: \"chaperone\", priority: \"blocking\", model_tier: \"strong\"\n    )\n\n    spawned = nil\n    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker) do |**kwargs|\n      spawned = kwargs\n      instance_double(Worker, worker_id: kwargs[:worker_id])\n    end\n\n    Orchestrator::SpawnRequestedWorkers.call(run:)\n\n    assert_equal \"chaperone\", spawned[:role]\n    assert_equal \"strong\", spawned[:model_tier]\n    assert_equal review.lineage_key, spawned[:scope]\n    expect(spawned[:mcp_override][:token]).not_to eq(original_token)\n    expect(ChaperoneReview.authenticate(spawned[:mcp_override][:token])).to eq(review)\n    expect(spawned[:mcp_override][:allowed_tools]).to eq(Orchestrator::ChaperoneMcpServer::TOOL_NAMES)\n    assert_equal \"fulfilled\", request.reload.status\n  end\n\n  it \"spawns a verifier worker through the generic dispatch path with a read-only, source-protected sandbox\" do\n    workspace = Workspace.create!(name: \"spawn-verifier-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n    run = workspace.runs.create!(\n      run_id: \"spawn-verifier-#{SecureRandom.hex(4)}\", task: \"Verify a claim\",\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n    request = run.spawn_requests.create!(\n      asked_by: \"planner\", scope: \"acceptance-verify-outcome\", lineage_key: \"acceptance:outcome\",\n      text: \"Independently verify the claim.\", requested_role: \"verifier\", priority: \"blocking\",\n      model_tier: \"small\", execution_mode: \"verification\", write_scope: \"source_protected\", allowed_paths: []\n    )\n\n    spawned = nil\n    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker) do |**kwargs|\n      spawned = kwargs\n      instance_double(Worker, worker_id: kwargs[:worker_id])\n    end\n\n    Orchestrator::SpawnRequestedWorkers.call(run:)\n\n    assert_equal \"verifier\", spawned[:role]\n    assert_equal \"source_protected\", spawned[:write_scope]\n    assert_equal [], spawned[:allowed_paths]\n    assert_equal \"verification\", spawned[:mode]\n    assert_equal \"small\", spawned[:model_tier]\n    assert_equal \"fulfilled\", request.reload.status\n  end\n\n  it \"grants the complete project-init-protected source surface to implementation workers\" do\n    project_root = Dir.mktmpdir\n    source_root = File.join(project_root, \"main\")\n    workspace = Workspace.create!(\n      name: \"spawn-test-roots-#{SecureRandom.hex(4)}\", root_path: project_root,\n      protected_path_patterns: [ \"app/**\", \"quality/checks/**\" ]\n    )\n    run = workspace.runs.create!(\n      run_id: \"spawn-test-roots-#{SecureRandom.hex(4)}\", task: \"Implement with tests\", target_root: source_root,\n      launcher_variant: \"claude\", status: \"running\"\n    )\n    run.spawn_requests.create!(\n      asked_by: \"planner\", scope: \"fix.md\", text: \"Implement the fix.\", requested_role: \"worker\", priority: \"blocking\",\n      execution_mode: \"implementation\", write_scope: \"scoped_changes\", allowed_paths: [ \"app/example.rb\" ]\n    )\n\n    spawned = nil\n    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker) do |**kwargs|\n      spawned = kwargs\n      instance_double(Worker, worker_id: kwargs[:worker_id])\n    end\n\n    Orchestrator::SpawnRequestedWorkers.call(run:)\n\n    expect(spawned[:allowed_paths]).to contain_exactly(\"app/**\", \"quality/checks/**\")\n  ensure\n    FileUtils.remove_entry(project_root) if project_root && Dir.exist?(project_root)\n  end\n\n  it \"grants the protected source surface to scoped infrastructure workers\" do\n    project_root = Dir.mktmpdir\n    source_root = File.join(project_root, \"main\")\n    FileUtils.mkdir_p(File.join(source_root, \"app\"))\n    workspace = Workspace.create!(\n      name: \"spawn-infrastructure-roots-#{SecureRandom.hex(4)}\", root_path: project_root,\n      protected_path_patterns: [ \"app/**\" ]\n    )\n    run = workspace.runs.create!(\n      run_id: \"spawn-infrastructure-roots-#{SecureRandom.hex(4)}\", task: \"Repair setup\", target_root: source_root,\n      launcher_variant: \"codex\", status: \"running\"\n    )\n    run.spawn_requests.create!(\n      asked_by: \"planner\", scope: \"repair.md\", text: \"Repair the environment.\", requested_role: \"infrastructure\", priority: \"blocking\",\n      execution_mode: \"infrastructure\", write_scope: \"scoped_changes\", allowed_paths: []\n    )\n\n    spawned = nil\n    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker) do |**kwargs|\n      spawned = kwargs\n      instance_double(Worker, worker_id: kwargs[:worker_id])\n    end\n\n    Orchestrator::SpawnRequestedWorkers.call(run:)\n\n    expect(spawned[:allowed_paths]).to eq([ \"app/**\" ])\n  ensure\n    FileUtils.remove_entry(project_root) if project_root && Dir.exist?(project_root)\n  end\n\n  it \"dispatches only one queued verifier per run, leaving later work queued\" do\n    workspace = Workspace.create!(name: \"serial-verifiers-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n    run = workspace.runs.create!(\n      run_id: \"serial-verifiers-#{SecureRandom.hex(4)}\", task: \"Verify several claims\",\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n    first = run.spawn_requests.create!(\n      asked_by: \"planner\", scope: \"acceptance-verify-first\", lineage_key: \"acceptance:first\",\n      text: \"Verify the first claim.\", requested_role: \"verifier\", priority: \"blocking\",\n      model_tier: \"small\", execution_mode: \"verification\", write_scope: \"source_protected\", allowed_paths: []\n    )\n    second = run.spawn_requests.create!(\n      asked_by: \"planner\", scope: \"acceptance-verify-second\", lineage_key: \"acceptance:second\",\n      text: \"Verify the second claim.\", requested_role: \"verifier\", priority: \"blocking\",\n      model_tier: \"small\", execution_mode: \"verification\", write_scope: \"source_protected\", allowed_paths: []\n    )\n\n    expect(Orchestrator::WorkerSpawner).to receive(:spawn_worker).once.and_return(instance_double(Worker))\n\n    Orchestrator::SpawnRequestedWorkers.call(run:)\n\n    assert_equal \"fulfilled\", first.reload.status\n    assert_equal \"open\", second.reload.status\n  end\n\n  it \"does not dispatch a worker while a Rails planner decision is in flight\" do\n    workspace = Workspace.create!(name: \"serial-planner-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n    run = workspace.runs.create!(\n      run_id: \"serial-planner-#{SecureRandom.hex(4)}\", task: \"Plan before verifying\",\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n    planner_request = run.spawn_requests.create!(\n      asked_by: \"worker\", scope: \"workflow-plan.md\", text: \"Choose the next step.\",\n      requested_role: \"planner\", priority: \"blocking\"\n    )\n    PlannerDecision.create!(run:, spawn_request: planner_request, status: \"running\")\n    verifier_request = run.spawn_requests.create!(\n      asked_by: \"planner\", scope: \"acceptance-verify-outcome\", lineage_key: \"acceptance:outcome\",\n      text: \"Verify the claim.\", requested_role: \"verifier\", priority: \"blocking\",\n      model_tier: \"small\", execution_mode: \"verification\", write_scope: \"source_protected\", allowed_paths: []\n    )\n\n    expect(Orchestrator::WorkerSpawner).not_to receive(:spawn_worker)\n\n    assert_empty Orchestrator::SpawnRequestedWorkers.call(run:)\n    assert_equal \"open\", verifier_request.reload.status\n  end\n\n  it \"dismisses a chaperone spawn request when no matching pending review is found\" do\n    workspace = Workspace.create!(name: \"spawn-chaperone-missing-#{SecureRandom.hex(4)}\", root_path: Dir.mktmpdir)\n    run = workspace.runs.create!(\n      run_id: \"spawn-chaperone-missing-#{SecureRandom.hex(4)}\", task: \"Review a repeated failure\",\n      target_root: workspace.root_path, launcher_variant: \"claude\", status: \"running\"\n    )\n    request = run.spawn_requests.create!(\n      asked_by: \"chaperone\", scope: \"stale-lineage\", lineage_key: \"stale-lineage\",\n      text: \"Repeated blocked diagnosis.\", requested_role: \"chaperone\", priority: \"blocking\", model_tier: \"strong\"\n    )\n\n    expect(Orchestrator::WorkerSpawner).not_to receive(:spawn_worker)\n\n    spawned = Orchestrator::SpawnRequestedWorkers.call(run:)\n\n    assert_empty spawned\n    assert_equal \"dismissed\", request.reload.status\n  end\nend\n","numLines":213,"startLine":1,"totalLines":213}}}
