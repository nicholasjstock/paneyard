{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013p4wGCrfrixDFJibEihXEq","type":"tool_result","content":"1\tmodule Orchestrator\n2\t  # Ports scripts/supervisor-loop.ts's spawnRequestedWorkers -- the\n3\t  # claim-before-spawn race-avoidance loop. Dispatch is deliberately\n4\t  # single-flight per run: a run may have one executor (worker, verifier,\n5\t  # or chaperone) or one planner decision in flight, never several at once.\n6\t  # This keeps shared target resources such as ports, files, and browsers\n7\t  # safe until resource-aware concurrency is explicitly introduced.\n8\t  module SpawnRequestedWorkers\n9\t    module_function\n10\t\n11\t    def call(run:)\n12\t      # The scheduler may have overlapping ticks. Lock the run across the\n13\t      # eligibility check and request claim so only one tick can turn an idle\n14\t      # run into active work.\n15\t      run.with_lock { call_locked(run: run) }\n16\t    end\n17\t\n18\t    def call_locked(run:)\n19\t      run_id = run.run_id\n20\t      active_workers = Worker.where(run_id: run_id, status: \"running\").to_a\n21\t      current_workers = Worker.where(run_id: run_id).to_a\n22\t\n23\t      # A spawned executor owns the entire run until it reports completion.\n24\t      # Do this before dismissing overlapping slots: queued work is valid,\n25\t      # merely waiting its turn.\n26\t      return [] if active_workers.any?\n27\t\n28\t      # Planners run as Rails jobs rather than Worker rows, so they need the\n29\t      # same single-flight protection explicitly. An awaiting chaperone is\n30\t      # intentionally excluded: its chaperone request is the one allowed\n31\t      # successor while the planner waits for that review.\n32\t      return [] if PlannerDecision.where(run_id: run_id, status: %w[queued running]).exists?\n33\t\n34\t      # A currently-running worker already claims its (role, scope) slot --\n35\t      # that claim is the source of truth, not the bus's request history.\n36\t      # Any other open request for the same slot is redundant with an\n37\t      # in-flight claim, so dismiss it now instead of leaving it open\n38\t      # forever.\n39\t      active_claim_keys = active_workers.map { |worker| [ worker.role, worker.scope ] }.to_set\n40\t      SpawnRequest.where(run_id: run_id, status: \"open\").find_each do |request|\n41\t        next unless request.requested_role.present?\n42\t        next unless active_claim_keys.include?([ request.requested_role, request.scope ])\n43\t\n44\t        request.update!(\n45\t          status: \"dismissed\",\n46\t          dismissed_by: \"tick_run_job\",\n47\t          dismissal_note: \"Superseded — an active worker already claims #{request.requested_role}/#{request.scope}.\"\n48\t        )\n49\t      end\n50\t\n51\t      spawn_requests = collect_spawn_requests(run_id: run_id, active_workers: active_workers)\n52\t      spawned_workers = []\n53\t\n54\t      spawn_requests.each do |request|\n55\t        role = request.requested_role\n56\t        if role == \"planner\"\n57\t          decision = PlannerDecision.find_or_initialize_by(spawn_request_id: request.request_id)\n58\t          decision.assign_attributes(run: run, spawn_request: request, status: \"queued\", error: nil, completed_at: nil)\n59\t          decision.save!\n60\t          request.update!(\n61\t            status: \"fulfilled\", fulfilled_by: \"planner_decision_job\", fulfilled_at: Time.current,\n62\t            fulfillment_note: \"Queued bounded Rails-owned planner decision #{decision.decision_id}.\"\n63\t          )\n64\t          run.publish_phase!(\n65\t            phase: \"planning\", owner: \"orchestrator\",\n66\t            summary: \"Preparing one bounded planner decision from current run evidence.\"\n67\t          )\n68\t          PlannerDecisionJob.perform_later(decision.id)\n69\t          next\n70\t        end\n71\t\n72\t        if role == \"chaperone\"\n73\t          dispatch_chaperone_request(run: run, request: request)\n74\t          next\n75\t        end\n76\t\n77\t        nickname = build_unique_nickname(build_worker_nickname(role), current_workers + spawned_workers)\n78\t        reason = \"Bus request from #{request.asked_by} for #{request.scope}.\"\n79\t        prompt = build_requested_worker_prompt(run_id: run_id, request: request)\n80\t        worker_id = SecureRandom.uuid\n81\t\n82\t        # Claim the (role, scope) slot before actually spawning the\n83\t        # worker -- spawning does real file I/O and launches a process,\n84\t        # which takes far longer than this one DB write.\n85\t        request.update!(\n86\t          status: \"fulfilled\", fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current,\n87\t          fulfillment_note: \"Spawned worker #{nickname} (#{role}).\", fulfilled_worker_id: worker_id\n88\t        )\n89\t\n90\t        begin\n91\t          effective_allowed_paths = allowed_paths(request, run:)\n92\t          worker = WorkerSpawner.spawn_worker(\n93\t            run: run, role: role, nickname: nickname, reason: reason, scope: request.scope, prompt: prompt,\n94\t            worker_id: worker_id, mode: execution_mode(request), write_scope: write_scope(request),\n95\t            allowed_paths: effective_allowed_paths, model_tier: request.model_tier\n96\t          )\n97\t        rescue Orchestrator::TargetPreflight::Error => e\n98\t          request.update!(\n99\t            status: \"dismissed\", dismissed_by: \"target_preflight\",\n100\t            dismissal_note: \"Worker #{nickname} was not launched: #{e.message}\"\n101\t          )\n102\t          run.update!(status: \"failed\", stopped_at: Time.current)\n103\t          run.publish_phase!(phase: \"failed\", owner: \"target_preflight\", summary: e.message)\n104\t          next\n105\t        rescue => e\n106\t          # The claim promised a worker that never came into existence --\n107\t          # undo it so dependents don't wait forever on a workerId that\n108\t          # will never appear, and so the slot is free for a real retry.\n109\t          request.update!(\n110\t            status: \"dismissed\", dismissed_by: \"tick_run_job\",\n111\t            dismissal_note: \"Claimed worker #{nickname} (#{role}) failed to spawn: #{e.message}\"\n112\t          )\n113\t          raise\n114\t        end\n115\t\n116\t        spawned_workers << worker\n117\t      end\n118\t\n119\t      spawned_workers\n120\t    end\n121\t    private_class_method :call_locked\n122\t\n123\t    def collect_spawn_requests(run_id:, active_workers:)\n124\t      active_keys = active_workers.map { |worker| [ worker.role, worker.scope ] }.to_set\n125\t      latest_by_key = {}\n126\t\n127\t      SpawnRequest.where(run_id: run_id, status: \"open\").order(:created_at, :id).each do |request|\n128\t        next unless request.requested_role.present?\n129\t\n130\t        key = [ request.requested_role, request.scope ]\n131\t        next if active_keys.include?(key)\n132\t\n133\t        latest_by_key[key] = request\n134\t      end\n135\t\n136\t      candidates = latest_by_key.values.sort_by { |request| [ request.created_at, request.id ] }\n137\t\n138\t      # A queued/running chaperone review is an orchestration boundary: only\n139\t      # its chaperone may proceed, never unrelated worker requests behind it.\n140\t      if ChaperoneReview.where(run_id: run_id, status: %w[queued running]).exists?\n141\t        candidates.select! { |request| request.requested_role == \"chaperone\" }\n142\t      end\n143\t\n144\t      # One request per tick (and per run) is the intentional concurrency\n145\t      # limit. The next tick observes the resulting active worker or planner\n146\t      # decision before considering subsequent queued work.\n147\t      candidates.first(1)\n148\t    end\n149\t\n150\t    def dispatch_chaperone_request(run:, request:)"}]},"parent_tool_use_id":null,"session_id":"b646d34a-518c-4379-8490-a31643afa1e2","uuid":"d6949b70-0497-4b06-89d3-4bd9b4525cba","timestamp":"2026-07-24T12:12:55.942Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/services/orchestrator/spawn_requested_workers.rb","content":"module Orchestrator\n  # Ports scripts/supervisor-loop.ts's spawnRequestedWorkers -- the\n  # claim-before-spawn race-avoidance loop. Dispatch is deliberately\n  # single-flight per run: a run may have one executor (worker, verifier,\n  # or chaperone) or one planner decision in flight, never several at once.\n  # This keeps shared target resources such as ports, files, and browsers\n  # safe until resource-aware concurrency is explicitly introduced.\n  module SpawnRequestedWorkers\n    module_function\n\n    def call(run:)\n      # The scheduler may have overlapping ticks. Lock the run across the\n      # eligibility check and request claim so only one tick can turn an idle\n      # run into active work.\n      run.with_lock { call_locked(run: run) }\n    end\n\n    def call_locked(run:)\n      run_id = run.run_id\n      active_workers = Worker.where(run_id: run_id, status: \"running\").to_a\n      current_workers = Worker.where(run_id: run_id).to_a\n\n      # A spawned executor owns the entire run until it reports completion.\n      # Do this before dismissing overlapping slots: queued work is valid,\n      # merely waiting its turn.\n      return [] if active_workers.any?\n\n      # Planners run as Rails jobs rather than Worker rows, so they need the\n      # same single-flight protection explicitly. An awaiting chaperone is\n      # intentionally excluded: its chaperone request is the one allowed\n      # successor while the planner waits for that review.\n      return [] if PlannerDecision.where(run_id: run_id, status: %w[queued running]).exists?\n\n      # A currently-running worker already claims its (role, scope) slot --\n      # that claim is the source of truth, not the bus's request history.\n      # Any other open request for the same slot is redundant with an\n      # in-flight claim, so dismiss it now instead of leaving it open\n      # forever.\n      active_claim_keys = active_workers.map { |worker| [ worker.role, worker.scope ] }.to_set\n      SpawnRequest.where(run_id: run_id, status: \"open\").find_each do |request|\n        next unless request.requested_role.present?\n        next unless active_claim_keys.include?([ request.requested_role, request.scope ])\n\n        request.update!(\n          status: \"dismissed\",\n          dismissed_by: \"tick_run_job\",\n          dismissal_note: \"Superseded — an active worker already claims #{request.requested_role}/#{request.scope}.\"\n        )\n      end\n\n      spawn_requests = collect_spawn_requests(run_id: run_id, active_workers: active_workers)\n      spawned_workers = []\n\n      spawn_requests.each do |request|\n        role = request.requested_role\n        if role == \"planner\"\n          decision = PlannerDecision.find_or_initialize_by(spawn_request_id: request.request_id)\n          decision.assign_attributes(run: run, spawn_request: request, status: \"queued\", error: nil, completed_at: nil)\n          decision.save!\n          request.update!(\n            status: \"fulfilled\", fulfilled_by: \"planner_decision_job\", fulfilled_at: Time.current,\n            fulfillment_note: \"Queued bounded Rails-owned planner decision #{decision.decision_id}.\"\n          )\n          run.publish_phase!(\n            phase: \"planning\", owner: \"orchestrator\",\n            summary: \"Preparing one bounded planner decision from current run evidence.\"\n          )\n          PlannerDecisionJob.perform_later(decision.id)\n          next\n        end\n\n        if role == \"chaperone\"\n          dispatch_chaperone_request(run: run, request: request)\n          next\n        end\n\n        nickname = build_unique_nickname(build_worker_nickname(role), current_workers + spawned_workers)\n        reason = \"Bus request from #{request.asked_by} for #{request.scope}.\"\n        prompt = build_requested_worker_prompt(run_id: run_id, request: request)\n        worker_id = SecureRandom.uuid\n\n        # Claim the (role, scope) slot before actually spawning the\n        # worker -- spawning does real file I/O and launches a process,\n        # which takes far longer than this one DB write.\n        request.update!(\n          status: \"fulfilled\", fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current,\n          fulfillment_note: \"Spawned worker #{nickname} (#{role}).\", fulfilled_worker_id: worker_id\n        )\n\n        begin\n          effective_allowed_paths = allowed_paths(request, run:)\n          worker = WorkerSpawner.spawn_worker(\n            run: run, role: role, nickname: nickname, reason: reason, scope: request.scope, prompt: prompt,\n            worker_id: worker_id, mode: execution_mode(request), write_scope: write_scope(request),\n            allowed_paths: effective_allowed_paths, model_tier: request.model_tier\n          )\n        rescue Orchestrator::TargetPreflight::Error => e\n          request.update!(\n            status: \"dismissed\", dismissed_by: \"target_preflight\",\n            dismissal_note: \"Worker #{nickname} was not launched: #{e.message}\"\n          )\n          run.update!(status: \"failed\", stopped_at: Time.current)\n          run.publish_phase!(phase: \"failed\", owner: \"target_preflight\", summary: e.message)\n          next\n        rescue => e\n          # The claim promised a worker that never came into existence --\n          # undo it so dependents don't wait forever on a workerId that\n          # will never appear, and so the slot is free for a real retry.\n          request.update!(\n            status: \"dismissed\", dismissed_by: \"tick_run_job\",\n            dismissal_note: \"Claimed worker #{nickname} (#{role}) failed to spawn: #{e.message}\"\n          )\n          raise\n        end\n\n        spawned_workers << worker\n      end\n\n      spawned_workers\n    end\n    private_class_method :call_locked\n\n    def collect_spawn_requests(run_id:, active_workers:)\n      active_keys = active_workers.map { |worker| [ worker.role, worker.scope ] }.to_set\n      latest_by_key = {}\n\n      SpawnRequest.where(run_id: run_id, status: \"open\").order(:created_at, :id).each do |request|\n        next unless request.requested_role.present?\n\n        key = [ request.requested_role, request.scope ]\n        next if active_keys.include?(key)\n\n        latest_by_key[key] = request\n      end\n\n      candidates = latest_by_key.values.sort_by { |request| [ request.created_at, request.id ] }\n\n      # A queued/running chaperone review is an orchestration boundary: only\n      # its chaperone may proceed, never unrelated worker requests behind it.\n      if ChaperoneReview.where(run_id: run_id, status: %w[queued running]).exists?\n        candidates.select! { |request| request.requested_role == \"chaperone\" }\n      end\n\n      # One request per tick (and per run) is the intentional concurrency\n      # limit. The next tick observes the resulting active worker or planner\n      # decision before considering subsequent queued work.\n      candidates.first(1)\n    end\n\n    def dispatch_chaperone_request(run:, request:)","numLines":150,"startLine":1,"totalLines":261}}}
