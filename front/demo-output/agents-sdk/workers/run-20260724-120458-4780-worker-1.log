{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CMWuY7372y96zAfPA3BAMQ","type":"tool_result","content":"1\tmodule Orchestrator\n2\t  # Ports scripts/supervisor-loop.ts's spawnRequestedWorkers -- the\n3\t  # claim-before-spawn race-avoidance loop. Dispatch is deliberately\n4\t  # single-flight per run: a run may have one executor (worker, verifier,\n5\t  # or chaperone) or one planner decision in flight, never several at once.\n6\t  # This keeps shared target resources such as ports, files, and browsers\n7\t  # safe until resource-aware concurrency is explicitly introduced.\n8\t  module SpawnRequestedWorkers\n9\t    module_function\n10\t\n11\t    def call(run:)\n12\t      # The scheduler may have overlapping ticks. Lock the run across the\n13\t      # eligibility check and request claim so only one tick can turn an idle\n14\t      # run into active work.\n15\t      run.with_lock { call_locked(run: run) }\n16\t    end\n17\t\n18\t    def call_locked(run:)\n19\t      run_id = run.run_id\n20\t      active_workers = Worker.where(run_id: run_id, status: \"running\").to_a\n21\t      current_workers = Worker.where(run_id: run_id).to_a\n22\t\n23\t      # A spawned executor owns the entire run until it reports completion.\n24\t      # Do this before dismissing overlapping slots: queued work is valid,\n25\t      # merely waiting its turn.\n26\t      return [] if active_workers.any?\n27\t\n28\t      # Planners run as Rails jobs rather than Worker rows, so they need the\n29\t      # same single-flight protection explicitly. An awaiting chaperone is\n30\t      # intentionally excluded: its chaperone request is the one allowed\n31\t      # successor while the planner waits for that review.\n32\t      return [] if PlannerDecision.where(run_id: run_id, status: %w[queued running]).exists?\n33\t\n34\t      # A currently-running worker already claims its (role, scope) slot --\n35\t      # that claim is the source of truth, not the bus's request history.\n36\t      # Any other open request for the same slot is redundant with an\n37\t      # in-flight claim, so dismiss it now instead of leaving it open\n38\t      # forever.\n39\t      active_claim_keys = active_workers.map { |worker| [ worker.role, worker.scope ] }.to_set\n40\t      SpawnRequest.where(run_id: run_id, status: \"open\").find_each do |request|\n41\t        next unless request.requested_role.present?\n42\t        next unless active_claim_keys.include?([ request.requested_role, request.scope ])\n43\t\n44\t        request.update!(\n45\t          status: \"dismissed\",\n46\t          dismissed_by: \"tick_run_job\",\n47\t          dismissal_note: \"Superseded — an active worker already claims #{request.requested_role}/#{request.scope}.\"\n48\t        )\n49\t      end\n50\t\n51\t      spawn_requests = collect_spawn_requests(run_id: run_id, active_workers: active_workers)\n52\t      spawned_workers = []\n53\t\n54\t      spawn_requests.each do |request|\n55\t        role = request.requested_role\n56\t        if role == \"planner\"\n57\t          decision = PlannerDecision.find_or_initialize_by(spawn_request_id: request.request_id)\n58\t          decision.assign_attributes(run: run, spawn_request: request, status: \"queued\", error: nil, completed_at: nil)\n59\t          decision.save!\n60\t          request.update!(\n61\t            status: \"fulfilled\", fulfilled_by: \"planner_decision_job\", fulfilled_at: Time.current,\n62\t            fulfillment_note: \"Queued bounded Rails-owned planner decision #{decision.decision_id}.\"\n63\t          )\n64\t          run.publish_phase!(\n65\t            phase: \"planning\", owner: \"orchestrator\",\n66\t            summary: \"Preparing one bounded planner decision from current run evidence.\"\n67\t          )\n68\t          PlannerDecisionJob.perform_later(decision.id)\n69\t          next\n70\t        end\n71\t\n72\t        if role == \"chaperone\"\n73\t          dispatch_chaperone_request(run: run, request: request)\n74\t          next\n75\t        end\n76\t\n77\t        nickname = build_unique_nickname(build_worker_nickname(role), current_workers + spawned_workers)\n78\t        reason = \"Bus request from #{request.asked_by} for #{request.scope}.\"\n79\t        prompt = build_requested_worker_prompt(run_id: run_id, request: request)\n80\t        worker_id = SecureRandom.uuid\n81\t\n82\t        # Claim the (role, scope) slot before actually spawning the\n83\t        # worker -- spawning does real file I/O and launches a process,\n84\t        # which takes far longer than this one DB write.\n85\t        request.update!(\n86\t          status: \"fulfilled\", fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current,\n87\t          fulfillment_note: \"Spawned worker #{nickname} (#{role}).\", fulfilled_worker_id: worker_id\n88\t        )\n89\t\n90\t        begin\n91\t          effective_allowed_paths = allowed_paths(request, run:)\n92\t          worker = WorkerSpawner.spawn_worker(\n93\t            run: run, role: role, nickname: nickname, reason: reason, scope: request.scope, prompt: prompt,\n94\t            worker_id: worker_id, mode: execution_mode(request), write_scope: write_scope(request),\n95\t            allowed_paths: effective_allowed_paths, model_tier: request.model_tier\n96\t          )\n97\t        rescue Orchestrator::TargetPreflight::Error => e\n98\t          request.update!(\n99\t            status: \"dismissed\", dismissed_by: \"target_preflight\",\n100\t            dismissal_note: \"Worker #{nickname} was not launched: #{e.message}\"\n101\t          )\n102\t          run.update!(status: \"failed\", stopped_at: Time.current)\n103\t          run.publish_phase!(phase: \"failed\", owner: \"target_preflight\", summary: e.message)\n104\t          next\n105\t        rescue => e\n106\t          # The claim promised a worker that never came into existence --\n107\t          # undo it so dependents don't wait forever on a workerId that\n108\t          # will never appear, and so the slot is free for a real retry.\n109\t          request.update!(\n110\t            status: \"dismissed\", dismissed_by: \"tick_run_job\",\n111\t            dismissal_note: \"Claimed worker #{nickname} (#{role}) failed to spawn: #{e.message}\"\n112\t          )\n113\t          raise\n114\t        end\n115\t\n116\t        spawned_workers << worker\n117\t      end\n118\t\n119\t      spawned_workers\n120\t    end\n121\t    private_class_method :call_locked\n122\t\n123\t    def collect_spawn_requests(run_id:, active_workers:)\n124\t      active_keys = active_workers.map { |worker| [ worker.role, worker.scope ] }.to_set\n125\t      latest_by_key = {}\n126\t\n127\t      SpawnRequest.where(run_id: run_id, status: \"open\").order(:created_at, :id).each do |request|\n128\t        next unless request.requested_role.present?\n129\t\n130\t        key = [ request.requested_role, request.scope ]\n131\t        next if active_keys.include?(key)\n132\t\n133\t        latest_by_key[key] = request\n134\t      end\n135\t\n136\t      candidates = latest_by_key.values.sort_by { |request| [ request.created_at, request.id ] }\n137\t\n138\t      # A queued/running chaperone review is an orchestration boundary: only\n139\t      # its chaperone may proceed, never unrelated worker requests behind it.\n140\t      if ChaperoneReview.where(run_id: run_id, status: %w[queued running]).exists?\n141\t        candidates.select! { |request| request.requested_role == \"chaperone\" }\n142\t      end\n143\t\n144\t      # One request per tick (and per run) is the intentional concurrency\n145\t      # limit. The next tick observes the resulting active worker or planner\n146\t      # decision before considering subsequent queued work.\n147\t      candidates.first(1)\n148\t    end\n149\t\n150\t    def dispatch_chaperone_request(run:, request:)\n151\t      review = ChaperoneReview.find_by(run_id: run.run_id, lineage_key: request.lineage_key, status: %w[queued running])\n152\t      unless review\n153\t        request.update!(\n154\t          status: \"dismissed\", dismissed_by: \"tick_run_job\",\n155\t          dismissal_note: \"No pending chaperone review found for lineage #{request.lineage_key}.\"\n156\t        )\n157\t        return\n158\t      end\n159\t\n160\t      token = review.reissue_token!\n161\t      worker_id = SecureRandom.uuid\n162\t\n163\t      request.update!(\n164\t        status: \"fulfilled\", fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current,\n165\t        fulfillment_note: \"Spawned chaperone review #{review.review_id}.\", fulfilled_worker_id: worker_id\n166\t      )\n167\t\n168\t      begin\n169\t        WorkerSpawner.spawn_worker(\n170\t          run: run, role: \"chaperone\", nickname: \"chaperone-#{SecureRandom.hex(3)}\",\n171\t          reason: \"Chaperone review: #{review.trigger_reason || review.summary}\",\n172\t          scope: request.scope, prompt: chaperone_prompt(review), worker_id: worker_id, model_tier: \"strong\",\n173\t          mcp_override: {\n174\t            url: \"#{WorkerSpawner.rails_mcp_url}/chaperone\", token: token,\n175\t            allowed_tools: Orchestrator::ChaperoneMcpServer::TOOL_NAMES\n176\t          }\n177\t        )\n178\t      rescue => e\n179\t        request.update!(\n180\t          status: \"dismissed\", dismissed_by: \"tick_run_job\",\n181\t          dismissal_note: \"Claimed chaperone review #{review.review_id} failed to spawn: #{e.message}\"\n182\t        )\n183\t        raise\n184\t      end\n185\t    end\n186\t\n187\t    def chaperone_prompt(review)\n188\t      if review.subject_type == \"planner\"\n189\t        \"You must begin by calling get_chaperone_state. Review the bounded small-model planner attempt and its failure using only the chaperone MCP tools. \" \\\n190\t          \"Choose continue_small when the failure can be corrected by a bounded retry with clearer context, including invalid verification evidence, an unverified service or endpoint, or an unnecessary protected-path proposal. \" \\\n191\t          \"Choose promote only for a genuine reasoning-capability gap. Choose stop only when no safe in-scope retry exists and a real external decision is unavoidable; never stop merely because the planner proposed unauthorized work when an in-scope alternative remains. \" \\\n192\t          \"When evidence identifies a concrete, fixable condition that would change the next attempt, provide revisedInstruction with the replacement instruction; otherwise leave it null. \" \\\n193\t          \"Your summary must state the concrete next action. You must finish by calling submit_chaperone_decision exactly once; a text-only answer is a failure.\"\n194\t      else\n195\t        \"You must begin by calling get_chaperone_state. Review repeated diagnosis attempts using only the chaperone MCP tools. Determine semantic similarity and progress. \" \\\n196\t          \"Choose continue_small or promote only when the same execution envelope can succeed with a corrected instruction or stronger worker. \" \\\n197\t          \"When the evidence shows the envelope itself cannot solve the blocker (for example a source-protected recording must first change an exact configuration or source file), choose stop WITH plannerTier=small or strong, a blockerKey, and one or more contextRequests. This means REPLACE the failed envelope: Rails starts one selected-tier planner that may create a new mode, owner, writable-path scope, artifact, and follow-up sequence. It does not ask the user. Choose small when the evidence makes the replacement obvious and strong only for real repair-scope uncertainty. blockerKey is a short lowercase-hyphenated slug naming the specific blocking condition (e.g. 'stale-recorder-assertion', 'docker-unavailable'). get_chaperone_state's priorBlockers lists every blockerKey already used for this lineage -- check it before choosing one: if the current blocker is the same underlying condition as an entry there, reuse that exact key even if you would phrase it differently, so Rails recognizes the repeat and asks the user instead of replanning the same fix again; pick a new key only when the evidence shows a genuinely different blocker, even within the same lineage, including a small-tier replan that failed only because it was scoped too narrowly. Context requests may name only artifact, run_context, or worker_log windows; use the smallest useful windows. \" \\\n198\t          \"Choose stop WITHOUT plannerTier only when no safe bounded repair plan exists and a real external decision is unavoidable. \" \\\n199\t          \"You must finish by calling submit_chaperone_decision exactly once; a text-only answer is a failure.\"\n200\t      end\n201\t    end\n202\t\n203\t    def build_worker_nickname(role)\n204\t      case role\n205\t      when \"worker\" then \"worker\"\n206\t      when \"planner\" then \"planner\"\n207\t      when \"orchestrator\" then \"orchestrator\"\n208\t      else role\n209\t      end\n210\t    end\n211\t\n212\t    def build_unique_nickname(base_nickname, workers)\n213\t      taken = workers.map(&:nickname).to_set\n214\t      return base_nickname unless taken.include?(base_nickname)\n215\t\n216\t      suffix = 1\n217\t      suffix += 1 while taken.include?(\"#{base_nickname}-#{suffix}\")\n218\t      \"#{base_nickname}-#{suffix}\"\n219\t    end\n220\t\n221\t    def build_requested_worker_prompt(run_id:, request:)\n222\t      [\n223\t        \"Run #{run_id}.\",\n224\t        \"Bus request: #{request.scope}.\",\n225\t        \"Requested by: #{request.asked_by}.\",\n226\t        (request.requested_role.present? ? \"Target role: #{request.requested_role}.\" : nil),\n227\t        request.text,\n228\t        (request.context.present? ? \"Context: #{request.context}.\" : nil),\n229\t        (\"Write your report via write_workflow_artifact using artifactName=\\\"#{request.scope}\\\". Use the shared workflow bus for blockers.\" unless request.requested_role == \"committer\")\n230\t      ].compact.join(\" \")\n231\t    end\n232\t\n233\t    def execution_mode(request)\n234\t      request.execution_mode.presence || request.text.to_s[/\\bExecution mode: ([a-z_]+)\\./i, 1]&.downcase\n235\t    end\n236\t\n237\t    def write_scope(request)\n238\t      request.write_scope.presence || request.text.to_s[/\\bWrite scope: ([a-z_]+)\\./i, 1]&.downcase\n239\t    end\n240\t\n241\t    def allowed_paths(request, run: nil)\n242\t      paths = if request.allowed_paths.present?\n243\t        Array(request.allowed_paths)\n244\t      else\n245\t        raw = request.text.to_s[/\\bPlanner-suggested repository paths: (.+?)\\./i, 1]\n246\t        raw.blank? || raw.casecmp?(\"none\") ? [] : raw.split(\",\").map(&:strip)\n247\t      end\n248\t\n249\t      return paths unless run && execution_mode(request).in?(%w[implementation infrastructure]) && write_scope(request) == \"scoped_changes\"\n250\t\n251\t      # A planner decides whether a worker is implementing or repairing\n252\t      # infrastructure; it must not have\n253\t      # to foresee every production and test file the implementation needs.\n254\t      # The project-init-discovered source patterns (already including test\n255\t      # paths -- see the record_protected_paths prompt) stay protected for\n256\t      # all other worker modes and are granted wholesale only here.\n257\t      run.workspace.protected_write_patterns\n258\t    end\n259\t  end\n260\tend\n261\t"}]},"parent_tool_use_id":null,"session_id":"b646d34a-518c-4379-8490-a31643afa1e2","uuid":"dd16d71f-b15f-4d61-bb00-ae628eeebfea","timestamp":"2026-07-24T12:13:14.032Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/services/orchestrator/spawn_requested_workers.rb","content":"module Orchestrator\n  # Ports scripts/supervisor-loop.ts's spawnRequestedWorkers -- the\n  # claim-before-spawn race-avoidance loop. Dispatch is deliberately\n  # single-flight per run: a run may have one executor (worker, verifier,\n  # or chaperone) or one planner decision in flight, never several at once.\n  # This keeps shared target resources such as ports, files, and browsers\n  # safe until resource-aware concurrency is explicitly introduced.\n  module SpawnRequestedWorkers\n    module_function\n\n    def call(run:)\n      # The scheduler may have overlapping ticks. Lock the run across the\n      # eligibility check and request claim so only one tick can turn an idle\n      # run into active work.\n      run.with_lock { call_locked(run: run) }\n    end\n\n    def call_locked(run:)\n      run_id = run.run_id\n      active_workers = Worker.where(run_id: run_id, status: \"running\").to_a\n      current_workers = Worker.where(run_id: run_id).to_a\n\n      # A spawned executor owns the entire run until it reports completion.\n      # Do this before dismissing overlapping slots: queued work is valid,\n      # merely waiting its turn.\n      return [] if active_workers.any?\n\n      # Planners run as Rails jobs rather than Worker rows, so they need the\n      # same single-flight protection explicitly. An awaiting chaperone is\n      # intentionally excluded: its chaperone request is the one allowed\n      # successor while the planner waits for that review.\n      return [] if PlannerDecision.where(run_id: run_id, status: %w[queued running]).exists?\n\n      # A currently-running worker already claims its (role, scope) slot --\n      # that claim is the source of truth, not the bus's request history.\n      # Any other open request for the same slot is redundant with an\n      # in-flight claim, so dismiss it now instead of leaving it open\n      # forever.\n      active_claim_keys = active_workers.map { |worker| [ worker.role, worker.scope ] }.to_set\n      SpawnRequest.where(run_id: run_id, status: \"open\").find_each do |request|\n        next unless request.requested_role.present?\n        next unless active_claim_keys.include?([ request.requested_role, request.scope ])\n\n        request.update!(\n          status: \"dismissed\",\n          dismissed_by: \"tick_run_job\",\n          dismissal_note: \"Superseded — an active worker already claims #{request.requested_role}/#{request.scope}.\"\n        )\n      end\n\n      spawn_requests = collect_spawn_requests(run_id: run_id, active_workers: active_workers)\n      spawned_workers = []\n\n      spawn_requests.each do |request|\n        role = request.requested_role\n        if role == \"planner\"\n          decision = PlannerDecision.find_or_initialize_by(spawn_request_id: request.request_id)\n          decision.assign_attributes(run: run, spawn_request: request, status: \"queued\", error: nil, completed_at: nil)\n          decision.save!\n          request.update!(\n            status: \"fulfilled\", fulfilled_by: \"planner_decision_job\", fulfilled_at: Time.current,\n            fulfillment_note: \"Queued bounded Rails-owned planner decision #{decision.decision_id}.\"\n          )\n          run.publish_phase!(\n            phase: \"planning\", owner: \"orchestrator\",\n            summary: \"Preparing one bounded planner decision from current run evidence.\"\n          )\n          PlannerDecisionJob.perform_later(decision.id)\n          next\n        end\n\n        if role == \"chaperone\"\n          dispatch_chaperone_request(run: run, request: request)\n          next\n        end\n\n        nickname = build_unique_nickname(build_worker_nickname(role), current_workers + spawned_workers)\n        reason = \"Bus request from #{request.asked_by} for #{request.scope}.\"\n        prompt = build_requested_worker_prompt(run_id: run_id, request: request)\n        worker_id = SecureRandom.uuid\n\n        # Claim the (role, scope) slot before actually spawning the\n        # worker -- spawning does real file I/O and launches a process,\n        # which takes far longer than this one DB write.\n        request.update!(\n          status: \"fulfilled\", fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current,\n          fulfillment_note: \"Spawned worker #{nickname} (#{role}).\", fulfilled_worker_id: worker_id\n        )\n\n        begin\n          effective_allowed_paths = allowed_paths(request, run:)\n          worker = WorkerSpawner.spawn_worker(\n            run: run, role: role, nickname: nickname, reason: reason, scope: request.scope, prompt: prompt,\n            worker_id: worker_id, mode: execution_mode(request), write_scope: write_scope(request),\n            allowed_paths: effective_allowed_paths, model_tier: request.model_tier\n          )\n        rescue Orchestrator::TargetPreflight::Error => e\n          request.update!(\n            status: \"dismissed\", dismissed_by: \"target_preflight\",\n            dismissal_note: \"Worker #{nickname} was not launched: #{e.message}\"\n          )\n          run.update!(status: \"failed\", stopped_at: Time.current)\n          run.publish_phase!(phase: \"failed\", owner: \"target_preflight\", summary: e.message)\n          next\n        rescue => e\n          # The claim promised a worker that never came into existence --\n          # undo it so dependents don't wait forever on a workerId that\n          # will never appear, and so the slot is free for a real retry.\n          request.update!(\n            status: \"dismissed\", dismissed_by: \"tick_run_job\",\n            dismissal_note: \"Claimed worker #{nickname} (#{role}) failed to spawn: #{e.message}\"\n          )\n          raise\n        end\n\n        spawned_workers << worker\n      end\n\n      spawned_workers\n    end\n    private_class_method :call_locked\n\n    def collect_spawn_requests(run_id:, active_workers:)\n      active_keys = active_workers.map { |worker| [ worker.role, worker.scope ] }.to_set\n      latest_by_key = {}\n\n      SpawnRequest.where(run_id: run_id, status: \"open\").order(:created_at, :id).each do |request|\n        next unless request.requested_role.present?\n\n        key = [ request.requested_role, request.scope ]\n        next if active_keys.include?(key)\n\n        latest_by_key[key] = request\n      end\n\n      candidates = latest_by_key.values.sort_by { |request| [ request.created_at, request.id ] }\n\n      # A queued/running chaperone review is an orchestration boundary: only\n      # its chaperone may proceed, never unrelated worker requests behind it.\n      if ChaperoneReview.where(run_id: run_id, status: %w[queued running]).exists?\n        candidates.select! { |request| request.requested_role == \"chaperone\" }\n      end\n\n      # One request per tick (and per run) is the intentional concurrency\n      # limit. The next tick observes the resulting active worker or planner\n      # decision before considering subsequent queued work.\n      candidates.first(1)\n    end\n\n    def dispatch_chaperone_request(run:, request:)\n      review = ChaperoneReview.find_by(run_id: run.run_id, lineage_key: request.lineage_key, status: %w[queued running])\n      unless review\n        request.update!(\n          status: \"dismissed\", dismissed_by: \"tick_run_job\",\n          dismissal_note: \"No pending chaperone review found for lineage #{request.lineage_key}.\"\n        )\n        return\n      end\n\n      token = review.reissue_token!\n      worker_id = SecureRandom.uuid\n\n      request.update!(\n        status: \"fulfilled\", fulfilled_by: \"tick_run_job\", fulfilled_at: Time.current,\n        fulfillment_note: \"Spawned chaperone review #{review.review_id}.\", fulfilled_worker_id: worker_id\n      )\n\n      begin\n        WorkerSpawner.spawn_worker(\n          run: run, role: \"chaperone\", nickname: \"chaperone-#{SecureRandom.hex(3)}\",\n          reason: \"Chaperone review: #{review.trigger_reason || review.summary}\",\n          scope: request.scope, prompt: chaperone_prompt(review), worker_id: worker_id, model_tier: \"strong\",\n          mcp_override: {\n            url: \"#{WorkerSpawner.rails_mcp_url}/chaperone\", token: token,\n            allowed_tools: Orchestrator::ChaperoneMcpServer::TOOL_NAMES\n          }\n        )\n      rescue => e\n        request.update!(\n          status: \"dismissed\", dismissed_by: \"tick_run_job\",\n          dismissal_note: \"Claimed chaperone review #{review.review_id} failed to spawn: #{e.message}\"\n        )\n        raise\n      end\n    end\n\n    def chaperone_prompt(review)\n      if review.subject_type == \"planner\"\n        \"You must begin by calling get_chaperone_state. Review the bounded small-model planner attempt and its failure using only the chaperone MCP tools. \" \\\n          \"Choose continue_small when the failure can be corrected by a bounded retry with clearer context, including invalid verification evidence, an unverified service or endpoint, or an unnecessary protected-path proposal. \" \\\n          \"Choose promote only for a genuine reasoning-capability gap. Choose stop only when no safe in-scope retry exists and a real external decision is unavoidable; never stop merely because the planner proposed unauthorized work when an in-scope alternative remains. \" \\\n          \"When evidence identifies a concrete, fixable condition that would change the next attempt, provide revisedInstruction with the replacement instruction; otherwise leave it null. \" \\\n          \"Your summary must state the concrete next action. You must finish by calling submit_chaperone_decision exactly once; a text-only answer is a failure.\"\n      else\n        \"You must begin by calling get_chaperone_state. Review repeated diagnosis attempts using only the chaperone MCP tools. Determine semantic similarity and progress. \" \\\n          \"Choose continue_small or promote only when the same execution envelope can succeed with a corrected instruction or stronger worker. \" \\\n          \"When the evidence shows the envelope itself cannot solve the blocker (for example a source-protected recording must first change an exact configuration or source file), choose stop WITH plannerTier=small or strong, a blockerKey, and one or more contextRequests. This means REPLACE the failed envelope: Rails starts one selected-tier planner that may create a new mode, owner, writable-path scope, artifact, and follow-up sequence. It does not ask the user. Choose small when the evidence makes the replacement obvious and strong only for real repair-scope uncertainty. blockerKey is a short lowercase-hyphenated slug naming the specific blocking condition (e.g. 'stale-recorder-assertion', 'docker-unavailable'). get_chaperone_state's priorBlockers lists every blockerKey already used for this lineage -- check it before choosing one: if the current blocker is the same underlying condition as an entry there, reuse that exact key even if you would phrase it differently, so Rails recognizes the repeat and asks the user instead of replanning the same fix again; pick a new key only when the evidence shows a genuinely different blocker, even within the same lineage, including a small-tier replan that failed only because it was scoped too narrowly. Context requests may name only artifact, run_context, or worker_log windows; use the smallest useful windows. \" \\\n          \"Choose stop WITHOUT plannerTier only when no safe bounded repair plan exists and a real external decision is unavoidable. \" \\\n          \"You must finish by calling submit_chaperone_decision exactly once; a text-only answer is a failure.\"\n      end\n    end\n\n    def build_worker_nickname(role)\n      case role\n      when \"worker\" then \"worker\"\n      when \"planner\" then \"planner\"\n      when \"orchestrator\" then \"orchestrator\"\n      else role\n      end\n    end\n\n    def build_unique_nickname(base_nickname, workers)\n      taken = workers.map(&:nickname).to_set\n      return base_nickname unless taken.include?(base_nickname)\n\n      suffix = 1\n      suffix += 1 while taken.include?(\"#{base_nickname}-#{suffix}\")\n      \"#{base_nickname}-#{suffix}\"\n    end\n\n    def build_requested_worker_prompt(run_id:, request:)\n      [\n        \"Run #{run_id}.\",\n        \"Bus request: #{request.scope}.\",\n        \"Requested by: #{request.asked_by}.\",\n        (request.requested_role.present? ? \"Target role: #{request.requested_role}.\" : nil),\n        request.text,\n        (request.context.present? ? \"Context: #{request.context}.\" : nil),\n        (\"Write your report via write_workflow_artifact using artifactName=\\\"#{request.scope}\\\". Use the shared workflow bus for blockers.\" unless request.requested_role == \"committer\")\n      ].compact.join(\" \")\n    end\n\n    def execution_mode(request)\n      request.execution_mode.presence || request.text.to_s[/\\bExecution mode: ([a-z_]+)\\./i, 1]&.downcase\n    end\n\n    def write_scope(request)\n      request.write_scope.presence || request.text.to_s[/\\bWrite scope: ([a-z_]+)\\./i, 1]&.downcase\n    end\n\n    def allowed_paths(request, run: nil)\n      paths = if request.allowed_paths.present?\n        Array(request.allowed_paths)\n      else\n        raw = request.text.to_s[/\\bPlanner-suggested repository paths: (.+?)\\./i, 1]\n        raw.blank? || raw.casecmp?(\"none\") ? [] : raw.split(\",\").map(&:strip)\n      end\n\n      return paths unless run && execution_mode(request).in?(%w[implementation infrastructure]) && write_scope(request) == \"scoped_changes\"\n\n      # A planner decides whether a worker is implementing or repairing\n      # infrastructure; it must not have\n      # to foresee every production and test file the implementation needs.\n      # The project-init-discovered source patterns (already including test\n      # paths -- see the record_protected_paths prompt) stay protected for\n      # all other worker modes and are granted wholesale only here.\n      run.workspace.protected_write_patterns\n    end\n  end\nend\n","numLines":261,"startLine":1,"totalLines":261}}}
