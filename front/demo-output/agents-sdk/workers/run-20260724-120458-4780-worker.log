{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J2BiANyvN1SSXcCEkpWiKk","type":"tool_result","content":"1\t# Starts a brand-new orchestrator run: seeds the initial planning request\n2\t# on the bus and marks the run running. TickRunJob claims that request and\n3\t# queues one bounded PlannerDecisionJob; planning is Rails-owned and does\n4\t# not spawn a stateful planner process.\n5\t#\n6\t# Runs via ActiveJob (not inline in the controller) so the web request\n7\t# stays fast and a failure is visible/retryable like any other job.\n8\tclass LaunchRunJob < ApplicationJob\n9\t  queue_as :default\n10\t\n11\t  def perform(id)\n12\t    run = Run.find(id)\n13\t    Orchestrator::GitWorktree.provision!(run)\n14\t    run.spawn_requests.create!(\n15\t      asked_by: run.launched_by.presence || \"ops_hub\",\n16\t      scope: \"workflow-plan.md\",\n17\t      text: run.task,\n18\t      requested_role: \"planner\",\n19\t      priority: \"blocking\",\n20\t      tags: %w[ops-hub launch]\n21\t    )\n22\t    Orchestrator::ProjectInitTrigger.call(run: run)\n23\t\n24\t    run.update!(status: \"running\", started_at: Time.current)\n25\t  rescue => e\n26\t    run&.update!(status: \"failed\", publication_status: \"failed\", publication_error: e.message)\n27\t    raise\n28\t  end\n29\tend\n30\t"}]},"parent_tool_use_id":null,"session_id":"757edfd5-1b3c-4393-821f-d3674027460e","uuid":"0dc4dc8b-547f-4538-9293-3a2b0be88147","timestamp":"2026-07-24T12:06:24.542Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/jobs/launch_run_job.rb","content":"# Starts a brand-new orchestrator run: seeds the initial planning request\n# on the bus and marks the run running. TickRunJob claims that request and\n# queues one bounded PlannerDecisionJob; planning is Rails-owned and does\n# not spawn a stateful planner process.\n#\n# Runs via ActiveJob (not inline in the controller) so the web request\n# stays fast and a failure is visible/retryable like any other job.\nclass LaunchRunJob < ApplicationJob\n  queue_as :default\n\n  def perform(id)\n    run = Run.find(id)\n    Orchestrator::GitWorktree.provision!(run)\n    run.spawn_requests.create!(\n      asked_by: run.launched_by.presence || \"ops_hub\",\n      scope: \"workflow-plan.md\",\n      text: run.task,\n      requested_role: \"planner\",\n      priority: \"blocking\",\n      tags: %w[ops-hub launch]\n    )\n    Orchestrator::ProjectInitTrigger.call(run: run)\n\n    run.update!(status: \"running\", started_at: Time.current)\n  rescue => e\n    run&.update!(status: \"failed\", publication_status: \"failed\", publication_error: e.message)\n    raise\n  end\nend\n","numLines":30,"startLine":1,"totalLines":30}}}
