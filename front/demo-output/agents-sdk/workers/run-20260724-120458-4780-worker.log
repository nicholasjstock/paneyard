 enforced** — any worker can read any artifact in its run","Access control: **The worker can only write to `artifactName === worker.scope`**"]},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":853,"cache_read_input_tokens":74786,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":853},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"757edfd5-1b3c-4393-821f-d3674027460e","uuid":"d7a68d8d-4d4a-43ff-ba84-a4f0be0336ea","timestamp":"2026-07-24T12:09:52.166Z","request_id":"req_011CdLrieXpyRf7YJhT1mxf6","tool_use_meta":[{"id":"toolu_01W9FCw1SJki2BVKDdQX7o41","display_name":"Worker Turn","server_display_name":"workflow-worker"}]}
