{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015dXDjuzgAJK34rxBSJMEbe","type":"tool_result","content":"350\t    # DiagnosisEvidenceGate citation complaint it then fixed, for example) --\n351\t    # only a rejection whose worker never went on to complete a handoff is\n352\t    # something an operator needs to see.\n353\t    return false if event[\"type\"] == \"worker.handoff_rejected\" && handoff_later_completed?(event)\n354\t\n355\t    return true unless event[\"type\"] == \"run.status\"\n356\t\n357\t    event.dig(\"payload\", \"phase\").in?(%w[awaiting_user_feedback waiting_on_capacity failed stopped completed])\n358\t  end\n359\t\n360\t  def handoff_later_completed?(event)\n361\t    nickname = event.dig(\"payload\", \"nickname\")\n362\t    return false if nickname.blank?\n363\t\n364\t    @run.workers.where(nickname: nickname).where.not(handoff_completed_at: nil).exists?\n365\t  end\n366\t\n367\t  def activity_event_actor(event)\n368\t    return \"Rails\" if event[\"type\"] == \"worker.handoff_rejected\"\n369\t    return event.dig(\"payload\", \"nickname\").presence || \"Worker\" if event[\"type\"].start_with?(\"worker.\")\n370\t\n371\t    \"Orchestrator\"\n372\t  end\n373\t\n374\t  def planner_activity_label(decision)\n375\t    case decision.status\n376\t    when \"completed\"\n377\t      step = decision.decision&.dig(\"next_step\")\n378\t      step ? \"Chose #{[ step['owner'], step['artifact'] ].compact.join(' → ')}\" : \"Completed the run\"\n379\t    when \"failed\"\n380\t      reason = helpers.planner_decision_error_summary(decision)\n381\t      \"Attempt failed: #{reason}\"\n382\t    when \"awaiting_chaperone\"\n383\t      \"Requested chaperone review\"\n384\t    when \"running\"\n385\t      \"Choosing the next bounded step\"\n386\t    else\n387\t      \"Decision queued\"\n388\t    end\n389\t  end\n390\t\n391\t  def attach_chaperone_reviews\n392\t    reviews_by_lineage = @chaperone_reviews.index_by(&:lineage_key)\n393\t    @worker_activities.each do |activity|\n394\t      next unless activity[:worker].role == \"chaperone\"\n395\t\n396\t      activity[:chaperone_review] = reviews_by_lineage[activity[:assignment_lineage_key]]\n397\t    end\n398\t  end\n399\t\n400\t  def chaperone_activity_label(review)\n401\t    if chaperone_replaced_envelope?(review)\n402\t      tier = SpawnRequest.where(run_id: review.run_id, asked_by: \"chaperone\", requested_role: \"planner\", lineage_key: review.lineage_key)\n403\t        .where(\"tags LIKE ?\", \"%stopped_retry%\").order(created_at: :desc).pick(:model_tier)\n404\t      return \"Requested a #{tier || 'small'} planner to replace the failed execution envelope\"\n405\t    end\n406\t\n407\t    action = {\n408\t      \"continue_small\" => \"continued on the small model\",\n409\t      \"promote\" => \"promoted to the stronger model\",\n410\t      \"stop\" => \"stopped the lineage\"\n411\t    }[review.action]\n412\t\n413\t    return \"Review failed for #{review.lineage_key}\" if review.status == \"failed\"\n414\t    return \"Reviewing repeated failures for #{review.lineage_key}\" unless action\n415\t\n416\t    \"Reviewed #{review.lineage_key} and #{action}\"\n417\t  end\n418\t\n419\t  def chaperone_replaced_envelope?(review)\n420\t    review.action == \"stop\" && SpawnRequest.where(\n421\t      run_id: review.run_id, asked_by: \"chaperone\", requested_role: \"planner\", lineage_key: review.lineage_key\n422\t    ).where(\"tags LIKE ?\", \"%stopped_retry%\").exists?\n423\t  end\n424\t\n425\t  def collect_artifacts\n426\t    artifact_names = (\n427\t      SpawnRequest.where(run_id: @run.run_id).pluck(:scope) +\n428\t      Array(@latest_tick&.dig(\"followingSteps\")).map { |step| step[\"artifact\"] || step[:artifact] } +\n429\t      Orchestrator::ArtifactStore.names(@run.target_root, @run.run_id)\n430\t    ).compact.uniq\n431\t\n432\t    Orchestrator::ArtifactStore.collect(@run.target_root, @run.run_id, artifact_names)[:artifacts]\n433\t      .select { |artifact| artifact[:exists] }\n434\t      .map do |artifact|\n435\t        artifact.merge(content: Orchestrator::ArtifactStore.read(@run.target_root, @run.run_id, artifact[:name]).force_encoding(\"UTF-8\").scrub)\n436\t      end\n437\t      .sort_by { |artifact| artifact[:updated_at] || \"\" }\n438\t      .reverse\n439\t      .first(4)\n440\t  rescue ArgumentError\n441\t    []\n442\t  end\n443\t\n444\t  def usage_summary\n445\t    Orchestrator::RunUsage.build(@run)\n446\t  end\n447\tend\n448\t"}]},"parent_tool_use_id":null,"session_id":"757edfd5-1b3c-4393-821f-d3674027460e","uuid":"caa1b184-bdee-4f34-9447-2b7952203844","timestamp":"2026-07-24T12:06:55.510Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/controllers/runs_controller.rb","content":"    # DiagnosisEvidenceGate citation complaint it then fixed, for example) --\n    # only a rejection whose worker never went on to complete a handoff is\n    # something an operator needs to see.\n    return false if event[\"type\"] == \"worker.handoff_rejected\" && handoff_later_completed?(event)\n\n    return true unless event[\"type\"] == \"run.status\"\n\n    event.dig(\"payload\", \"phase\").in?(%w[awaiting_user_feedback waiting_on_capacity failed stopped completed])\n  end\n\n  def handoff_later_completed?(event)\n    nickname = event.dig(\"payload\", \"nickname\")\n    return false if nickname.blank?\n\n    @run.workers.where(nickname: nickname).where.not(handoff_completed_at: nil).exists?\n  end\n\n  def activity_event_actor(event)\n    return \"Rails\" if event[\"type\"] == \"worker.handoff_rejected\"\n    return event.dig(\"payload\", \"nickname\").presence || \"Worker\" if event[\"type\"].start_with?(\"worker.\")\n\n    \"Orchestrator\"\n  end\n\n  def planner_activity_label(decision)\n    case decision.status\n    when \"completed\"\n      step = decision.decision&.dig(\"next_step\")\n      step ? \"Chose #{[ step['owner'], step['artifact'] ].compact.join(' → ')}\" : \"Completed the run\"\n    when \"failed\"\n      reason = helpers.planner_decision_error_summary(decision)\n      \"Attempt failed: #{reason}\"\n    when \"awaiting_chaperone\"\n      \"Requested chaperone review\"\n    when \"running\"\n      \"Choosing the next bounded step\"\n    else\n      \"Decision queued\"\n    end\n  end\n\n  def attach_chaperone_reviews\n    reviews_by_lineage = @chaperone_reviews.index_by(&:lineage_key)\n    @worker_activities.each do |activity|\n      next unless activity[:worker].role == \"chaperone\"\n\n      activity[:chaperone_review] = reviews_by_lineage[activity[:assignment_lineage_key]]\n    end\n  end\n\n  def chaperone_activity_label(review)\n    if chaperone_replaced_envelope?(review)\n      tier = SpawnRequest.where(run_id: review.run_id, asked_by: \"chaperone\", requested_role: \"planner\", lineage_key: review.lineage_key)\n        .where(\"tags LIKE ?\", \"%stopped_retry%\").order(created_at: :desc).pick(:model_tier)\n      return \"Requested a #{tier || 'small'} planner to replace the failed execution envelope\"\n    end\n\n    action = {\n      \"continue_small\" => \"continued on the small model\",\n      \"promote\" => \"promoted to the stronger model\",\n      \"stop\" => \"stopped the lineage\"\n    }[review.action]\n\n    return \"Review failed for #{review.lineage_key}\" if review.status == \"failed\"\n    return \"Reviewing repeated failures for #{review.lineage_key}\" unless action\n\n    \"Reviewed #{review.lineage_key} and #{action}\"\n  end\n\n  def chaperone_replaced_envelope?(review)\n    review.action == \"stop\" && SpawnRequest.where(\n      run_id: review.run_id, asked_by: \"chaperone\", requested_role: \"planner\", lineage_key: review.lineage_key\n    ).where(\"tags LIKE ?\", \"%stopped_retry%\").exists?\n  end\n\n  def collect_artifacts\n    artifact_names = (\n      SpawnRequest.where(run_id: @run.run_id).pluck(:scope) +\n      Array(@latest_tick&.dig(\"followingSteps\")).map { |step| step[\"artifact\"] || step[:artifact] } +\n      Orchestrator::ArtifactStore.names(@run.target_root, @run.run_id)\n    ).compact.uniq\n\n    Orchestrator::ArtifactStore.collect(@run.target_root, @run.run_id, artifact_names)[:artifacts]\n      .select { |artifact| artifact[:exists] }\n      .map do |artifact|\n        artifact.merge(content: Orchestrator::ArtifactStore.read(@run.target_root, @run.run_id, artifact[:name]).force_encoding(\"UTF-8\").scrub)\n      end\n      .sort_by { |artifact| artifact[:updated_at] || \"\" }\n      .reverse\n      .first(4)\n  rescue ArgumentError\n    []\n  end\n\n  def usage_summary\n    Orchestrator::RunUsage.build(@run)\n  end\nend\n","numLines":99,"startLine":350,"totalLines":448}}}
