{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W41BhRALmsNQ72BKzhyKi5","type":"tool_result","content":"1\t# Periodic liveness check for every Worker row still marked \"running\".\n2\t# A worker's spawning process (TickRunJob, or that worker's own MCP\n3\t# client, depending on which path recorded it) might not notice its\n4\t# exit -- Rails can independently confirm liveness the same way\n5\t# StopRunJob/Orchestrator::WorkerSpawner already do (Process.kill(0, pid)\n6\t# works fine for a process this Rails instance didn't fork, same host).\n7\t#\n8\t# This is a redundant safety net, not the primary detection path. Losing\n9\t# exact exit-code fidelity for a Rails-detected-only stop is an\n10\t# acceptable, already-anticipated degradation -- Worker#stop_reason\n11\t# already treats this as best-effort.\n12\tclass WorkerReconcileJob < ApplicationJob\n13\t  queue_as :default\n14\t\n15\t  def perform\n16\t    Worker.active.find_each do |worker|\n17\t      next if process_alive?(worker.pid)\n18\t\n19\t      exit_code = read_exit_code(worker.exit_status_path)\n20\t      output = Orchestrator::LogReader.read_tail_lines(worker.log_path, 12).to_s\n21\t      usage = Orchestrator::LogReader.claude_usage(worker.log_path)\n22\t      persist_claude_final_response(worker)\n23\t      stop_reason = worker.stop_reason.presence || stop_reason_for(worker, exit_code, output)\n24\t      worker.update!(\n25\t        status: \"stopped\",\n26\t        stopped_at: Time.current,\n27\t        exit_code: exit_code,\n28\t        stop_reason:,\n29\t        **usage\n30\t      )\n31\t      capacity_failure = Orchestrator::CapacityFailure.detected?(output) && worker.handoff_completed_at.blank?\n32\t\n33\t      if worker.role == \"chaperone\"\n34\t        handle_chaperone_worker_stop(worker) unless capacity_failure\n35\t        block_run_for_capacity!(worker, output) if capacity_failure\n36\t        next\n37\t      end\n38\t\n39\t      if worker.role == \"project_init\"\n40\t        handle_project_init_worker_stop(worker) unless capacity_failure\n41\t        block_run_for_capacity!(worker, output) if capacity_failure\n42\t        next\n43\t      end\n44\t\n45\t      review = record_failed_attempt(worker, stop_reason:, output:) unless capacity_failure || worker.handoff_completed_at.present?\n46\t      TickRunJob.perform_later unless capacity_failure || review\n47\t      block_run_for_capacity!(worker, output) if capacity_failure\n48\t    end\n49\t  end\n50\t\n51\t  private\n52\t\n53\t  def process_alive?(pid)\n54\t    Process.kill(0, pid)\n55\t    true\n56\t  rescue Errno::ESRCH\n57\t    false\n58\t  end\n59\t\n60\t  def read_exit_code(path)\n61\t    return unless path.present? && File.file?(path)\n62\t\n63\t    value = File.read(path).strip\n64\t    Integer(value, 10) if value.match?(/\\A\\d+\\z/)\n65\t  rescue Errno::ENOENT, Errno::EACCES, ArgumentError\n66\t    nil\n67\t  end\n68\t\n69\t  def persist_claude_final_response(worker)\n70\t    return unless worker.command == \"claude\"\n71\t\n72\t    response = Orchestrator::LogReader.claude_final_response(worker.log_path)\n73\t    return if response.blank?\n74\t\n75\t    File.write(worker.last_message_path, \"#{response.rstrip}\\n\")\n76\t  rescue Errno::ENOENT, Errno::EACCES\n77\t    nil\n78\t  end\n79\t\n80\t  def stop_reason_for(worker, exit_code, output)\n81\t    return project_init_stop_reason(worker, exit_code) if worker.role == \"project_init\"\n82\t    return \"Worker exited successfully after completing its handoff.\" if worker.handoff_completed_at.present? && exit_code == 0\n83\t    return \"Worker exited with status #{exit_code} after completing its handoff.\" if worker.handoff_completed_at.present? && exit_code.present?\n84\t    return \"Worker stopped after completing its handoff.\" if worker.handoff_completed_at.present?\n85\t    return \"Claude session limit reached; worker exited before completing its handoff.\" if output.match?(/hit your session limit/i)\n86\t    return \"Claude rate limit reached; worker exited before completing its handoff.\" if output.match?(/rate limit|too many requests/i)\n87\t    return \"Codex usage limit reached; worker exited before completing its handoff.\" if output.match?(/hit your usage limit/i)\n88\t    return \"Worker exited with status #{exit_code} before completing its handoff.\" if exit_code.present?\n89\t\n90\t    \"Process no longer running (detected by Rails reconciliation, exit status unavailable).\"\n91\t  end\n92\t\n93\t  # project_init never calls worker_turn (see handle_project_init_worker_stop),\n94\t  # so handoff_completed_at is never set even on a full success -- the\n95\t  # generic handoff-based messages above would misreport a successful run\n96\t  # as having stopped \"before completing its handoff\". Use the same\n97\t  # completion signal handle_project_init_worker_stop uses instead.\n98\t  def project_init_stop_reason(worker, exit_code)\n99\t    if project_init_completed?(worker)\n100\t      \"Project setup discovery completed and recorded its findings.\"\n101\t    elsif exit_code.present?\n102\t      \"Project setup discovery exited with status #{exit_code} without recording its findings.\"\n103\t    else\n104\t      \"Process no longer running (detected by Rails reconciliation, exit status unavailable).\"\n105\t    end\n106\t  end\n107\t\n108\t  def project_init_completed?(worker)\n109\t    worker.run.workspace.workspace_memory_entries.current.exists?(\n110\t      entry_key: Orchestrator::ProjectInitTrigger::PRIMARY_ENTRY_KEY\n111\t    )\n112\t  end\n113\t\n114\t  def record_failed_attempt(worker, stop_reason:, output:)\n115\t    request = SpawnRequest.find_by(fulfilled_worker_id: worker.worker_id)\n116\t    return unless request\n117\t    return if StepAttempt.exists?(worker_id: worker.worker_id)\n118\t\n119\t    attempt = StepAttempt.create!(\n120\t      run: worker.run, spawn_request: request, worker_id: worker.worker_id,\n121\t      lineage_key: request.lineage_key.presence || request.scope,\n122\t      mode: worker.execution_mode.presence || Orchestrator::SpawnRequestedWorkers.execution_mode(request).presence || \"unknown\",\n123\t      outcome: \"failed\", result: \"#{stop_reason}\\n#{output}\".strip,\n124\t      evidence_citations: []\n125\t    )\n126\t    review = Orchestrator::ChaperoneTrigger.call(attempt)\n127\t    if review\n128\t      worker.run.publish_phase!(\n129\t        phase: \"planning\", owner: \"chaperone\",\n130\t        summary: \"Chaperone is reviewing repeated worker failures for #{attempt.lineage_key}.\"\n131\t      )\n132\t    end\n133\t    review\n134\t  end\n135\t\n136\t  # A chaperone review is never itself the subject of another chaperone\n137\t  # review (record_failed_attempt/ChaperoneTrigger is intentionally skipped\n138\t  # by the caller's `next`) -- chaperone failure escalates immediately via\n139\t  # handle_review_failure, same as today; running the normal retry/chaperone\n140\t  # path here would recursively spawn chaperone-reviewing-chaperone.\n141\t  def handle_chaperone_worker_stop(worker)\n142\t    request = SpawnRequest.find_by(fulfilled_worker_id: worker.worker_id)\n143\t    return unless request\n144\t\n145\t    review = ChaperoneReview.find_by(run_id: worker.run_id, lineage_key: request.lineage_key, status: %w[queued running])\n146\t    return unless review\n147\t\n148\t    review.update!(status: \"failed\", summary: worker.stop_reason, completed_at: Time.current)\n149\t    Orchestrator::ApplyChaperoneDecision.handle_review_failure(review: review)\n150\t  end"}]},"parent_tool_use_id":null,"session_id":"757edfd5-1b3c-4393-821f-d3674027460e","uuid":"7fd245fc-aa58-4b10-abcb-e72f378816c3","timestamp":"2026-07-24T12:07:05.542Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/stockn/Source/workflow-orchestrator/when-launching-a-task-we-should-be-able-to-add-a-4780/app/jobs/worker_reconcile_job.rb","content":"# Periodic liveness check for every Worker row still marked \"running\".\n# A worker's spawning process (TickRunJob, or that worker's own MCP\n# client, depending on which path recorded it) might not notice its\n# exit -- Rails can independently confirm liveness the same way\n# StopRunJob/Orchestrator::WorkerSpawner already do (Process.kill(0, pid)\n# works fine for a process this Rails instance didn't fork, same host).\n#\n# This is a redundant safety net, not the primary detection path. Losing\n# exact exit-code fidelity for a Rails-detected-only stop is an\n# acceptable, already-anticipated degradation -- Worker#stop_reason\n# already treats this as best-effort.\nclass WorkerReconcileJob < ApplicationJob\n  queue_as :default\n\n  def perform\n    Worker.active.find_each do |worker|\n      next if process_alive?(worker.pid)\n\n      exit_code = read_exit_code(worker.exit_status_path)\n      output = Orchestrator::LogReader.read_tail_lines(worker.log_path, 12).to_s\n      usage = Orchestrator::LogReader.claude_usage(worker.log_path)\n      persist_claude_final_response(worker)\n      stop_reason = worker.stop_reason.presence || stop_reason_for(worker, exit_code, output)\n      worker.update!(\n        status: \"stopped\",\n        stopped_at: Time.current,\n        exit_code: exit_code,\n        stop_reason:,\n        **usage\n      )\n      capacity_failure = Orchestrator::CapacityFailure.detected?(output) && worker.handoff_completed_at.blank?\n\n      if worker.role == \"chaperone\"\n        handle_chaperone_worker_stop(worker) unless capacity_failure\n        block_run_for_capacity!(worker, output) if capacity_failure\n        next\n      end\n\n      if worker.role == \"project_init\"\n        handle_project_init_worker_stop(worker) unless capacity_failure\n        block_run_for_capacity!(worker, output) if capacity_failure\n        next\n      end\n\n      review = record_failed_attempt(worker, stop_reason:, output:) unless capacity_failure || worker.handoff_completed_at.present?\n      TickRunJob.perform_later unless capacity_failure || review\n      block_run_for_capacity!(worker, output) if capacity_failure\n    end\n  end\n\n  private\n\n  def process_alive?(pid)\n    Process.kill(0, pid)\n    true\n  rescue Errno::ESRCH\n    false\n  end\n\n  def read_exit_code(path)\n    return unless path.present? && File.file?(path)\n\n    value = File.read(path).strip\n    Integer(value, 10) if value.match?(/\\A\\d+\\z/)\n  rescue Errno::ENOENT, Errno::EACCES, ArgumentError\n    nil\n  end\n\n  def persist_claude_final_response(worker)\n    return unless worker.command == \"claude\"\n\n    response = Orchestrator::LogReader.claude_final_response(worker.log_path)\n    return if response.blank?\n\n    File.write(worker.last_message_path, \"#{response.rstrip}\\n\")\n  rescue Errno::ENOENT, Errno::EACCES\n    nil\n  end\n\n  def stop_reason_for(worker, exit_code, output)\n    return project_init_stop_reason(worker, exit_code) if worker.role == \"project_init\"\n    return \"Worker exited successfully after completing its handoff.\" if worker.handoff_completed_at.present? && exit_code == 0\n    return \"Worker exited with status #{exit_code} after completing its handoff.\" if worker.handoff_completed_at.present? && exit_code.present?\n    return \"Worker stopped after completing its handoff.\" if worker.handoff_completed_at.present?\n    return \"Claude session limit reached; worker exited before completing its handoff.\" if output.match?(/hit your session limit/i)\n    return \"Claude rate limit reached; worker exited before completing its handoff.\" if output.match?(/rate limit|too many requests/i)\n    return \"Codex usage limit reached; worker exited before completing its handoff.\" if output.match?(/hit your usage limit/i)\n    return \"Worker exited with status #{exit_code} before completing its handoff.\" if exit_code.present?\n\n    \"Process no longer running (detected by Rails reconciliation, exit status unavailable).\"\n  end\n\n  # project_init never calls worker_turn (see handle_project_init_worker_stop),\n  # so handoff_completed_at is never set even on a full success -- the\n  # generic handoff-based messages above would misreport a successful run\n  # as having stopped \"before completing its handoff\". Use the same\n  # completion signal handle_project_init_worker_stop uses instead.\n  def project_init_stop_reason(worker, exit_code)\n    if project_init_completed?(worker)\n      \"Project setup discovery completed and recorded its findings.\"\n    elsif exit_code.present?\n      \"Project setup discovery exited with status #{exit_code} without recording its findings.\"\n    else\n      \"Process no longer running (detected by Rails reconciliation, exit status unavailable).\"\n    end\n  end\n\n  def project_init_completed?(worker)\n    worker.run.workspace.workspace_memory_entries.current.exists?(\n      entry_key: Orchestrator::ProjectInitTrigger::PRIMARY_ENTRY_KEY\n    )\n  end\n\n  def record_failed_attempt(worker, stop_reason:, output:)\n    request = SpawnRequest.find_by(fulfilled_worker_id: worker.worker_id)\n    return unless request\n    return if StepAttempt.exists?(worker_id: worker.worker_id)\n\n    attempt = StepAttempt.create!(\n      run: worker.run, spawn_request: request, worker_id: worker.worker_id,\n      lineage_key: request.lineage_key.presence || request.scope,\n      mode: worker.execution_mode.presence || Orchestrator::SpawnRequestedWorkers.execution_mode(request).presence || \"unknown\",\n      outcome: \"failed\", result: \"#{stop_reason}\\n#{output}\".strip,\n      evidence_citations: []\n    )\n    review = Orchestrator::ChaperoneTrigger.call(attempt)\n    if review\n      worker.run.publish_phase!(\n        phase: \"planning\", owner: \"chaperone\",\n        summary: \"Chaperone is reviewing repeated worker failures for #{attempt.lineage_key}.\"\n      )\n    end\n    review\n  end\n\n  # A chaperone review is never itself the subject of another chaperone\n  # review (record_failed_attempt/ChaperoneTrigger is intentionally skipped\n  # by the caller's `next`) -- chaperone failure escalates immediately via\n  # handle_review_failure, same as today; running the normal retry/chaperone\n  # path here would recursively spawn chaperone-reviewing-chaperone.\n  def handle_chaperone_worker_stop(worker)\n    request = SpawnRequest.find_by(fulfilled_worker_id: worker.worker_id)\n    return unless request\n\n    review = ChaperoneReview.find_by(run_id: worker.run_id, lineage_key: request.lineage_key, status: %w[queued running])\n    return unless review\n\n    review.update!(status: \"failed\", summary: worker.stop_reason, completed_at: Time.current)\n    Orchestrator::ApplyChaperoneDecision.handle_review_failure(review: review)\n  end","numLines":150,"startLine":1,"totalLines":210}}}
